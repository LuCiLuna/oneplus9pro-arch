diff --git a/drivers/soc/qcom/oplus-sensor-devinfo.c b/drivers/soc/qcom/oplus-sensor-devinfo.c
new file mode 100644
index 00000000000..5eac7c5bf3a
--- /dev/null
+++ b/drivers/soc/qcom/oplus-sensor-devinfo.c
@@ -0,0 +1,345 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OPPO/OnePlus sensor description for the SLPI sensor firmware.
+ *
+ * The OnePlus sensor drivers running on the SLPI only enable the sensors
+ * that the application processor lists in SMEM item 130: which chip is
+ * fitted in each slot, its mounting direction and per-chip tuning. On
+ * Android the downstream oplus_sensor_devinfo driver fills that item from
+ * the "oplus,sensor-devinfo" device tree node; without it the sensor
+ * service comes up with no physical sensors at all.
+ *
+ * This is the SMEM half of that driver, with the same layout. It has to run
+ * before the SLPI is booted.
+ *
+ * Based on drivers/soc/oplus/sensor/oplus_sensor_devinfo.c,
+ * Copyright (C) 2018-2020 Oplus.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/soc/qcom/smem.h>
+#include <linux/string.h>
+
+#define SMEM_SENSOR		130
+
+#define REG_NUM			10
+#define PARAMETER_NUM		25
+#define FEATURE_NUM		10
+#define SOURCE_NUM		3
+#define ALGO_PARAMETER_NUM	15
+#define ALGO_FEATURE_NUM	5
+#define DEFAULT_CONFIG		0xff
+#define SAR_MAX_CH_NUM		5
+#define CLOSE_PD		1
+
+enum {
+	OPLUS_ACCEL, OPLUS_GYRO, OPLUS_MAG, OPLUS_LIGHT, OPLUS_PROXIMITY,
+	OPLUS_SAR, OPLUS_CCT, OPLUS_CCT_REAR, OPLUS_BAROMETER, OPLUS_SARS,
+	OPLUS_LIGHT_REAR,
+	SENSORS_NUM
+};
+
+#define SENSOR_ALGO_NUM		8
+
+/* shared with the SLPI firmware: keep the downstream layout */
+struct sensor_feature {
+	s32 reg[REG_NUM];
+	s32 parameter[PARAMETER_NUM];
+	s32 feature[FEATURE_NUM];
+};
+
+struct sensor_hw {
+	u8 sensor_name;
+	u8 bus_number;
+	u8 direction;
+	u8 irq_number;
+	struct sensor_feature feature;
+};
+
+struct sensor_vector {
+	s32 sensor_id;
+	struct sensor_hw hw[SOURCE_NUM];
+};
+
+struct sensor_algorithm {
+	s32 sensor_id;
+	s32 parameter[ALGO_PARAMETER_NUM];
+	s32 feature[ALGO_FEATURE_NUM];
+};
+
+struct sensor_info {
+	s32 magic_num;
+	struct sensor_vector s_vector[SENSORS_NUM];
+	struct sensor_algorithm a_vector[SENSOR_ALGO_NUM];
+};
+
+static_assert(sizeof(struct sensor_info) == 6792);
+
+static void read_u32_into(struct device_node *np, const char *prop, s32 *out)
+{
+	u32 v;
+
+	if (!of_property_read_u32(np, prop, &v))
+		*out = v;
+}
+
+static u8 read_u8_or(struct device_node *np, const char *prop, u8 def)
+{
+	u32 v;
+
+	return of_property_read_u32(np, prop, &v) ? def : v;
+}
+
+static void parse_mag(struct sensor_hw *hw, struct device_node *np)
+{
+	static const s32 soft_default[18] = {
+		10000, 0, 0, 0, 0, 0, 0, 0, 10000, 0, 0, 0, 0, 0, 0, 0, 10000, 0,
+	};
+	u32 n;
+
+	memcpy(hw->feature.parameter, soft_default, sizeof(soft_default));
+	if (!of_property_read_u32(np, "parameter-number", &n) &&
+	    n > 0 && n < PARAMETER_NUM)
+		of_property_read_u32_array(np, "soft-mag-parameter",
+					   (u32 *)hw->feature.parameter, n);
+}
+
+static void parse_prox(struct sensor_hw *hw, struct device_node *np)
+{
+	static const char * const param[] = {
+		"low_step", "high_step", "low_limit", "high_limit",
+		"dirty_low_step", "dirty_high_step", "ps_dirty_limit",
+		"ps_ir_limit", "ps_adjust_min", "ps_adjust_max",
+		"sampling_count", "step_max", "step_min", "step_div",
+		"anti_shake_delta", "dynamic_cali_max", "raw2offset_radio",
+		"offset_max", "offset_range_min", "offset_range_max",
+		"force_cali_limit", "cali_jitter_limit", "cal_offset_margin",
+	};
+	u32 v, n;
+	int i;
+
+	read_u32_into(np, "ps-type", &hw->feature.feature[0]);
+	read_u32_into(np, "ps_saturation", &hw->feature.feature[1]);
+	/* is_need_close_pd: the serial number condition is never met here */
+	hw->feature.feature[2] = 0;
+	if (!of_property_read_u32(np, "is_need_close_pd", &v) && v == CLOSE_PD)
+		hw->feature.feature[2] = CLOSE_PD;
+	read_u32_into(np, "ps_factory_cali_max", &hw->feature.feature[3]);
+
+	for (i = 0; i < ARRAY_SIZE(param); i++)
+		read_u32_into(np, param[i], &hw->feature.parameter[i]);
+
+	if (!of_property_read_u32(np, "parameter-number", &n) &&
+	    n > 0 && n < REG_NUM - 1) {
+		hw->feature.reg[0] = n;
+		of_property_read_u32_array(np, "sensor-reg",
+					   (u32 *)&hw->feature.reg[1], n);
+	}
+}
+
+static void parse_light(struct sensor_hw *hw, struct device_node *np)
+{
+	static const char * const feature[] = {
+		"als-type", "is-unit-device", "is-als-dri", "als-factor",
+		"is_als_initialed", "als_buffer_length", "normalization_value",
+		"use_lb_algo", "para-matrix", "als_ratio_type",
+	};
+	static const char * const para[] = {
+		"coef_a", "coef_b", "coef_c", "coef_d", "coef_e", "coef_ratio",
+		"gold-reset-scale", "lcd_type", "linear_comp_scope",
+		"linear_comp_intercept", "temp_lux", "coef", "bal_coef",
+		"ir_coef_stage_0", "ir_coef_stage_1", "ir_coef_stage_2",
+		"ir_coef_stage_3", "ir_coef_val_0", "ir_coef_val_1",
+		"ir_coef_val_2", "ir_coef_val_3", "ir_coef_val_4",
+		"lb-dbv-coefs-id", "light-cut",
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(feature); i++) {
+		if (!strcmp(feature[i], "normalization_value"))
+			hw->feature.feature[i] = 1057;
+		read_u32_into(np, feature[i], &hw->feature.feature[i]);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(para); i++) {
+		if (!strcmp(para[i], "gold-reset-scale"))
+			hw->feature.parameter[i] = 1001;
+		read_u32_into(np, para[i], &hw->feature.parameter[i]);
+	}
+}
+
+static void parse_light_rear(struct sensor_hw *hw, struct device_node *np)
+{
+	read_u32_into(np, "als-factor", &hw->feature.feature[0]);
+}
+
+static void parse_sar(struct sensor_hw *hw, struct device_node *np, bool down)
+{
+	static const s32 dc_offset_default[SAR_MAX_CH_NUM * 2] = {
+		0, 0, 0, 0, 0, 30000, 30000, 30000, 30000, 30000,
+	};
+	u32 n, v;
+
+	n = 0;
+	if (!of_property_read_u32(np, "parameter-number", &n) &&
+	    n > 0 && n < PARAMETER_NUM)
+		of_property_read_u32_array(np, "sensor-reg",
+					   (u32 *)hw->feature.parameter, n);
+	else
+		n = 0;
+	if (down)
+		return;
+
+	/* downstream stores the channel count after the last register pair */
+	if (!of_property_read_u32(np, "channel-num", &v) && v < SAR_MAX_CH_NUM)
+		hw->feature.feature[n / 2] = v;
+
+	if (!of_property_read_u32(np, "is-dc-offset", &v) && v == 1) {
+		/* downstream copies SAR_MAX_CH_NUM * 2 bytes of the defaults */
+		memcpy(hw->feature.reg, dc_offset_default, SAR_MAX_CH_NUM * 2);
+		of_property_read_u32_array(np, "dc-offset", (u32 *)hw->feature.reg,
+					   SAR_MAX_CH_NUM * 2);
+	}
+}
+
+static void parse_cct(struct sensor_hw *hw, struct device_node *np)
+{
+	static const char * const feature[] = {
+		"decoupled-driver", "publish-sensors", "is-ch-dri",
+		"timer-size", "fac-cali-sensor",
+	};
+	static const char * const para[] = {
+		"para-matrix", "atime", "first-atime", "fac-cali-atime",
+		"first-again", "fac-cali-again", "fd-time", "fac-cali-fd-time",
+		"first-fd-gain", "fac-cali-fd-gain",
+	};
+	int i;
+
+	hw->feature.feature[0] = 1;	/* decoupled oplus_cct driver */
+	for (i = 0; i < ARRAY_SIZE(feature); i++)
+		read_u32_into(np, feature[i], &hw->feature.feature[i]);
+	for (i = 0; i < ARRAY_SIZE(para); i++)
+		read_u32_into(np, para[i], &hw->feature.parameter[i]);
+}
+
+static void parse_physical(struct sensor_hw *hw, struct device_node *np)
+{
+	hw->sensor_name = read_u8_or(np, "sensor-name", 0);
+	/* DEFAULT_CONFIG: the firmware takes the value from the registry */
+	hw->bus_number = read_u8_or(np, "bus-number", DEFAULT_CONFIG);
+	hw->direction = read_u8_or(np, "sensor-direction", DEFAULT_CONFIG);
+	hw->irq_number = read_u8_or(np, "irq-number", DEFAULT_CONFIG);
+
+	/* same name prefixes, and order, as the downstream driver */
+	if (!strncmp(np->name, "msensor", 7))
+		parse_mag(hw, np);
+	else if (!strncmp(np->name, "psensor", 7))
+		parse_prox(hw, np);
+	else if (!strncmp(np->name, "lsensor", 7))
+		parse_light(hw, np);
+	else if (!strncmp(np->name, "ssensor", 7))
+		parse_sar(hw, np, false);
+	else if (!strncmp(np->name, "cctsens", 7) ||
+		 !strncmp(np->name, "cctrsen", 7))
+		parse_cct(hw, np);
+	else if (!strncmp(np->name, "sdsensor", 7))
+		parse_sar(hw, np, true);
+	else if (!strncmp(np->name, "lrsensor", 7))
+		parse_light_rear(hw, np);
+	else if (!strncmp(np->name, "gsensor", 7))
+		read_u32_into(np, "use-sois", &hw->feature.feature[0]);
+}
+
+static void parse_virtual(struct sensor_algorithm *algo, struct device_node *np)
+{
+	if (!strncmp(np->name, "pickup", 6)) {
+		read_u32_into(np, "is-need-prox", &algo->feature[0]);
+		read_u32_into(np, "prox-type", &algo->parameter[0]);
+	} else if (!strncmp(np->name, "lux_ao", 6)) {
+		read_u32_into(np, "thrd-low", &algo->parameter[0]);
+		read_u32_into(np, "thrd-high", &algo->parameter[1]);
+		read_u32_into(np, "als-type", &algo->parameter[2]);
+	} else if (!strncmp(np->name, "fp_dis", 6)) {
+		read_u32_into(np, "prox-type", &algo->parameter[0]);
+	} else if (!strncmp(np->name, "mag_fusion", 10)) {
+		read_u32_into(np, "fusion-type", &algo->feature[0]);
+	} else if (!strncmp(np->name, "oplus_measurement", 17)) {
+		read_u32_into(np, "acc-range", &algo->parameter[0]);
+		read_u32_into(np, "gyro-range", &algo->parameter[1]);
+	}
+}
+
+static int oplus_sensor_devinfo_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sensor_info *info;
+	struct device_node *np;
+	int physical = 0, algos = 0;
+	size_t size = 0;
+	int ret;
+
+	ret = qcom_smem_alloc(QCOM_SMEM_HOST_ANY, SMEM_SENSOR, sizeof(*info));
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret && ret != -EEXIST)
+		return dev_err_probe(dev, ret, "failed to allocate SMEM item %d\n",
+				     SMEM_SENSOR);
+
+	info = qcom_smem_get(QCOM_SMEM_HOST_ANY, SMEM_SENSOR, &size);
+	if (IS_ERR(info))
+		return dev_err_probe(dev, PTR_ERR(info), "failed to get SMEM item\n");
+	if (size < sizeof(*info))
+		return dev_err_probe(dev, -EINVAL, "SMEM item is %zu bytes, need %zu\n",
+				     size, sizeof(*info));
+
+	memset(info, 0, sizeof(*info));
+
+	for_each_child_of_node(dev->of_node, np) {
+		bool virt = of_property_read_bool(np, "is-virtual-sensor");
+		u32 type, index;
+
+		if (of_property_read_u32(np, "sensor-type", &type) ||
+		    type >= (virt ? SENSOR_ALGO_NUM : SENSORS_NUM))
+			continue;
+
+		if (virt) {
+			info->a_vector[type].sensor_id = type;
+			parse_virtual(&info->a_vector[type], np);
+			algos++;
+			continue;
+		}
+
+		info->s_vector[type].sensor_id = type;
+		if (of_property_read_u32(np, "sensor-index", &index) ||
+		    index >= SOURCE_NUM)
+			continue;
+		parse_physical(&info->s_vector[type].hw[index], np);
+		physical++;
+	}
+
+	dev_info(dev, "described %d sensors and %d algorithms to the SLPI\n",
+		 physical, algos);
+
+	return 0;
+}
+
+static const struct of_device_id oplus_sensor_devinfo_of_match[] = {
+	{ .compatible = "oplus,sensor-devinfo" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, oplus_sensor_devinfo_of_match);
+
+static struct platform_driver oplus_sensor_devinfo_driver = {
+	.probe = oplus_sensor_devinfo_probe,
+	.driver = {
+		.name = "oplus-sensor-devinfo",
+		.of_match_table = oplus_sensor_devinfo_of_match,
+	},
+};
+module_platform_driver(oplus_sensor_devinfo_driver);
+
+MODULE_DESCRIPTION("OPPO/OnePlus sensor description for the SLPI");
+MODULE_LICENSE("GPL");
