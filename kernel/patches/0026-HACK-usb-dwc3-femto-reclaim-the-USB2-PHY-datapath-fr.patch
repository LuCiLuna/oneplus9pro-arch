From 6b5b66557fdb8c620275c2cb320d52c643baefa6 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 09:54:15 +0000
Subject: [PATCH 026/110] HACK: usb: dwc3/femto: reclaim the USB2 PHY datapath
 from charger detection

On the OnePlus 9 Pro the charger firmware takes DP/DM for charger
detection on cable insertion by setting UTMI_PHY_DATAPATH_CTRL_OVERRIDE_EN,
OPMODE non-driving and USB2_SUSPEND_N_SEL in the femto PHY, and never hands
them back. The host then sees a bus reset followed by silence and the
gadget never enumerates after a replug.

Let phy_set_mode(DEVICE) on an initialized femto PHY clear those overrides,
and have dwc3 re-assert device mode once a second for 10 s after every bus
reset, since the firmware may grab the PHY seconds after attach.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/phy/qualcomm/phy-qcom-snps-femto-v2.c | 22 ++++++++++++++
 drivers/usb/dwc3/core.h                       |  2 ++
 drivers/usb/dwc3/gadget.c                     | 30 +++++++++++++++++++
 3 files changed, 54 insertions(+)

diff --git a/drivers/phy/qualcomm/phy-qcom-snps-femto-v2.c b/drivers/phy/qualcomm/phy-qcom-snps-femto-v2.c
index 980ad1fb1e2..ee67e0245d4 100644
--- a/drivers/phy/qualcomm/phy-qcom-snps-femto-v2.c
+++ b/drivers/phy/qualcomm/phy-qcom-snps-femto-v2.c
@@ -27,6 +27,9 @@
 #define USB2_PHY_USB_PHY_UTMI_CTRL1		(0x40)
 #define XCVRSEL					BIT(0)
 
+#define USB2_PHY_USB_PHY_UTMI_CTRL0		(0x3c)
+#define OPMODE_MASK				GENMASK(4, 3)
+
 #define USB2_PHY_USB_PHY_UTMI_CTRL5		(0x50)
 #define POR					BIT(1)
 
@@ -232,6 +235,25 @@ static int qcom_snps_hsphy_set_mode(struct phy *phy, enum phy_mode mode,
 	struct qcom_snps_hsphy *hsphy = phy_get_drvdata(phy);
 
 	hsphy->mode = mode;
+
+	/*
+	 * On cable insertion the charger firmware takes DP/DM for charger
+	 * detection by overriding the UTMI datapath into non-driving mode,
+	 * and leaves it so; the D+ pull-up then never reaches the host. Hand
+	 * the datapath back to the controller when it wants device mode.
+	 */
+	if (hsphy->phy_initialized && mode == PHY_MODE_USB_DEVICE &&
+	    (readl_relaxed(hsphy->base + USB2_PHY_USB_PHY_CFG0) &
+	     UTMI_PHY_DATAPATH_CTRL_OVERRIDE_EN)) {
+		dev_info(&phy->dev, "reclaiming DP/DM from charger detection\n");
+		qcom_snps_hsphy_write_mask(hsphy->base, USB2_PHY_USB_PHY_UTMI_CTRL0,
+					   OPMODE_MASK, 0);
+		qcom_snps_hsphy_write_mask(hsphy->base, USB2_PHY_USB_PHY_HS_PHY_CTRL2,
+					   USB2_SUSPEND_N_SEL, 0);
+		qcom_snps_hsphy_write_mask(hsphy->base, USB2_PHY_USB_PHY_CFG0,
+					   UTMI_PHY_DATAPATH_CTRL_OVERRIDE_EN, 0);
+	}
+
 	return 0;
 }
 
diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index f3dabb37f80..6581672ebd4 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1202,6 +1202,8 @@ struct dwc3_glue_ops {
 struct dwc3 {
 	struct work_struct	drd_work;
 	struct work_struct	err_recovery_work;
+	struct delayed_work	usb2_phy_reclaim_work;
+	unsigned int		usb2_phy_reclaim_checks;
 	struct dwc3_trb		*ep0_trb;
 	void			*bounce;
 	u8			*setup_buf;
diff --git a/drivers/usb/dwc3/gadget.c b/drivers/usb/dwc3/gadget.c
index ee837235630..7841110ad74 100644
--- a/drivers/usb/dwc3/gadget.c
+++ b/drivers/usb/dwc3/gadget.c
@@ -4174,12 +4174,40 @@ static void dwc3_gadget_disconnect_interrupt(struct dwc3 *dwc)
 	pm_request_idle(dwc->dev);
 }
 
+/*
+ * HACK (OnePlus 9 Pro): on cable insertion the charger firmware takes DP/DM
+ * for charger detection by putting the USB2 PHY datapath into non-driving
+ * mode, sometimes seconds after the attach, and never hands it back. Re-assert
+ * device mode on the PHY (which reclaims the datapath) for a while after each
+ * bus reset.
+ */
+#define DWC3_USB2_PHY_RECLAIM_MS	1000
+#define DWC3_USB2_PHY_RECLAIM_CHECKS	10
+
+static void dwc3_usb2_phy_reclaim_work(struct work_struct *work)
+{
+	struct dwc3 *dwc = container_of(work, struct dwc3,
+					usb2_phy_reclaim_work.work);
+
+	phy_set_mode(dwc->usb2_generic_phy[0], PHY_MODE_USB_DEVICE);
+
+	if (--dwc->usb2_phy_reclaim_checks)
+		queue_delayed_work(system_dfl_wq, &dwc->usb2_phy_reclaim_work,
+				   msecs_to_jiffies(DWC3_USB2_PHY_RECLAIM_MS));
+}
+
 static void dwc3_gadget_reset_interrupt(struct dwc3 *dwc)
 {
 	u32			reg;
 
 	dwc->suspended = false;
 
+	if (dwc->usb2_generic_phy[0]) {
+		dwc->usb2_phy_reclaim_checks = DWC3_USB2_PHY_RECLAIM_CHECKS;
+		mod_delayed_work(system_dfl_wq, &dwc->usb2_phy_reclaim_work,
+				 msecs_to_jiffies(DWC3_USB2_PHY_RECLAIM_MS));
+	}
+
 	/* The controller is recovered. */
 	if (dwc->err_state == DWC3_ERR_NONE)
 		dwc->err_recovery_count = 0;
@@ -4879,6 +4907,7 @@ int dwc3_gadget_init(struct dwc3 *dwc)
 
 	init_completion(&dwc->ep0_in_setup);
 	INIT_WORK(&dwc->err_recovery_work, dwc3_err_recovery_work);
+	INIT_DELAYED_WORK(&dwc->usb2_phy_reclaim_work, dwc3_usb2_phy_reclaim_work);
 	mutex_init(&dwc->connect_mutex);
 	dwc->gadget = kzalloc_obj(struct usb_gadget);
 	if (!dwc->gadget) {
@@ -4977,6 +5006,7 @@ void dwc3_gadget_exit(struct dwc3 *dwc)
 		return;
 
 	cancel_work_sync(&dwc->err_recovery_work);
+	cancel_delayed_work_sync(&dwc->usb2_phy_reclaim_work);
 	mutex_destroy(&dwc->connect_mutex);
 	dwc3_enable_susphy(dwc, true);
 	usb_del_gadget(dwc->gadget);
