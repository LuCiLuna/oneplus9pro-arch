From 9bdca7d2964629f35d3c45dc1049c59f319bf5bb Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 05:26:20 +0000
Subject: [PATCH 085/110] Revert "HACK: dmaengine: qcom: gpi: 256 entry channel
 rings"

This reverts commit ce9f028e1abdb29aa9929157f67f408fe032f22e.

"i2c: qcom-geni: reclaim the TX ring after GPI reads" fixes the cause, so
the default 64 entry rings are enough again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/dma/qcom/gpi.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/dma/qcom/gpi.c b/drivers/dma/qcom/gpi.c
index 5671c3818b9..5c1ad3d2830 100644
--- a/drivers/dma/qcom/gpi.c
+++ b/drivers/dma/qcom/gpi.c
@@ -237,7 +237,7 @@ enum msm_gpi_tce_code {
 #define STATE_IGNORE		(U32_MAX)
 #define EV_FACTOR		(2)
 #define REQ_OF_DMA_ARGS		(5) /* # of arguments required from client */
-#define CHAN_TRES		256
+#define CHAN_TRES		64
 
 struct __packed xfer_compl_event {
 	u64 ptr;
