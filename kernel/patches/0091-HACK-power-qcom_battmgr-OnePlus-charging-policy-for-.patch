+/*
+ * Android runs the charging policy on the AP (oplus_chg): the firmware stays at
+ * 5 V and 500 mA, and does not know the temperature of the battery, which only
+ * the AP can read from the gauge. Take the limits from the vendor device tree,
+ * keeping the firmware's own, lower, float voltage on this worn battery.
+ */
+static const struct {
+	int temp;	/* up to this temperature, in 0.1 C */
+	u32 fcc;	/* uA */
+	u32 fv;		/* uV */
+} qcom_battmgr_chg_zones[] = {
+	{       0,       0, 8700000 },
+	{      50, 1150000, 8700000 },
+	{     120, 1650000, 8700000 },
+	{     160, 2850000, 8700000 },
+	{     470, 3000000, 8700000 },
+	{     500,  600000, 8240000 },
+	{ INT_MAX,       0, 8240000 },
+};
+
+#define CHG_FCC_5V		1100000
+#define CHG_ICL_9V		2000000
+#define CHG_ICL_CDP		1500000
+#define CHG_VBUS_MIN		4400000
+#define CHG_VBUS_HV		8000000
+#define CHG_ITERM		150000
+#define CHG_FULL_POLLS		4
+#define CHG_VFLOAT_MARGIN	50000
+#define CHG_RECHARGE_VOLT	8500000
+#define CHG_POLL_SETTLE		(5 * HZ)
+#define CHG_POLL		(30 * HZ)
+
+static const u32 qcom_battmgr_chg_icl_steps[] = { 500000, 900000, 1200000, 1500000, 2000000 };
+
+static void qcom_battmgr_put_gauge(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	cancel_delayed_work_sync(&battmgr->chg_work);
+	power_supply_put(battmgr->gauge);
+}
+
+static int qcom_battmgr_chg_get(struct qcom_battmgr *battmgr, int prop, u32 *val)
+{
+	int ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, prop, 0);
+
+	if (!ret)
+		*val = battmgr->dbg_value;
+
+	return ret;
+}
+
+static int qcom_battmgr_chg_zone(struct qcom_battmgr *battmgr, int temp)
+{
+	int zone = 0;
+
+	while (temp > qcom_battmgr_chg_zones[zone].temp)
+		zone++;
+
+	/* 1 C of hysteresis on the way back down */
+	if (battmgr->chg.zone > zone && temp > qcom_battmgr_chg_zones[zone].temp - 10)
+		zone = battmgr->chg.zone;
+
+	return zone;
+}
+
+/* Input current on 5 V: there is no contract, so climb until VBUS starts to sag */
+static void qcom_battmgr_chg_climb_icl(struct qcom_battmgr *battmgr, u32 vbus, u32 target,
+				       u32 *icl, bool *climbing)
+{
+	const u32 *steps = qcom_battmgr_chg_icl_steps;
+	unsigned int step = battmgr->chg.icl_step;
+
+	if (vbus < CHG_VBUS_MIN) {
+		if (step)
+			step--;
+		battmgr->chg.capped = true;
+	} else if (!battmgr->chg.capped && step + 1 < ARRAY_SIZE(qcom_battmgr_chg_icl_steps) &&
+		   steps[step + 1] <= target) {
+		step++;
+		*climbing = true;
+	}
+	battmgr->chg.icl_step = step;
+	*icl = steps[step];
+}
+
+static void qcom_battmgr_chg_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work), struct qcom_battmgr,
+						    chg_work);
+	union power_supply_propval temp, volt, curr, status;
+	u32 online, type, vbus, vmax, cmax, icl = 0, fcc, fv;
+	unsigned long next = CHG_POLL;
+	bool pd, hv, detach, climbing = false, enable;
+	int zone, ret;
+
+	if (!battmgr->service_up)
+		return;
+
+	if (!battmgr->gauge) {
+		struct power_supply *gauge;
+
+		gauge = power_supply_get_by_reference(dev_fwnode(battmgr->dev),
+						      "oplus,fuel-gauge");
+		if (IS_ERR(gauge))
+			return;
+		if (!gauge) {
+			schedule_delayed_work(&battmgr->chg_work, CHG_POLL_SETTLE);
+			return;
+		}
+		if (devm_add_action(battmgr->dev, qcom_battmgr_put_gauge, battmgr)) {
+			power_supply_put(gauge);
+			return;
+		}
+		battmgr->gauge = gauge;
+	}
+
+	mutex_lock(&battmgr->lock);
+
+	detach = xchg(&battmgr->chg_reset, false);
+	if (detach)
+		goto reset;
+
+	ret = qcom_battmgr_chg_get(battmgr, USB_ONLINE, &online);
+	if (ret)
+		goto out;
+	if (!online)
+		goto reset;
+
+	if (!battmgr->chg.online) {
+		battmgr->chg.online = true;
+		battmgr->chg.enabled = -1;
+		battmgr->chg.zone = -1;
+		pm_stay_awake(battmgr->dev);
+	}
+
+	/* no temperature, no fast charging: stay at the firmware's defaults */
+	ret = power_supply_get_property(battmgr->gauge, POWER_SUPPLY_PROP_TEMP, &temp);
+	if (!ret)
+		ret = power_supply_get_property(battmgr->gauge, POWER_SUPPLY_PROP_VOLTAGE_NOW, &volt);
+	if (!ret)
+		ret = power_supply_get_property(battmgr->gauge, POWER_SUPPLY_PROP_CURRENT_NOW, &curr);
+	if (!ret)
+		ret = power_supply_get_property(battmgr->gauge, POWER_SUPPLY_PROP_STATUS, &status);
+	if (ret)
+		goto out;
+
+	ret = qcom_battmgr_chg_get(battmgr, USB_ADAP_TYPE, &type);
+	if (!ret)
+		ret = qcom_battmgr_chg_get(battmgr, USB_VOLT_NOW, &vbus);
+	if (!ret)
+		ret = qcom_battmgr_chg_get(battmgr, USB_VOLT_MAX, &vmax);
+	if (ret)
+		goto out;
+
+	pd = type == POWER_SUPPLY_USB_TYPE_PD || type == POWER_SUPPLY_USB_TYPE_PD_DRP ||
+	     type == POWER_SUPPLY_USB_TYPE_PD_PPS;
+	hv = vmax >= CHG_VBUS_HV;
+
+	/* the firmware reports the partner's SVID first; not all chargers answer */
+	if (pd && !hv && battmgr->chg.pdo_tries < 3 &&
+	    (READ_ONCE(battmgr->chg.svid) || battmgr->chg.polls >= 3)) {
+		battmgr->chg.pdo_tries++;
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						    OPLUS_USB_SET_PDO, 9000);
+		if (!ret) {
+			msleep(500);
+			ret = qcom_battmgr_chg_get(battmgr, USB_VOLT_MAX, &vmax);
+		}
+		if (ret)
+			goto out;
+		hv = vmax >= CHG_VBUS_HV;
+	}
+
+	if (hv) {
+		ret = qcom_battmgr_chg_get(battmgr, USB_CURR_MAX, &cmax);
+		if (ret)
+			goto out;
+		icl = cmax ? min(cmax, CHG_ICL_9V) : CHG_ICL_9V;
+	} else if (type == POWER_SUPPLY_USB_TYPE_DCP || pd) {
+		qcom_battmgr_chg_climb_icl(battmgr, vbus, CHG_ICL_9V, &icl, &climbing);
+	} else if (type == POWER_SUPPLY_USB_TYPE_CDP) {
+		qcom_battmgr_chg_climb_icl(battmgr, vbus, CHG_ICL_CDP, &icl, &climbing);
+	}
+
+	if (icl && icl != battmgr->chg.icl) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						    USB_INPUT_CURR_LIMIT, icl);
+		if (ret)
+			goto out;
+		battmgr->chg.icl = icl;
+	}
+
+	zone = qcom_battmgr_chg_zone(battmgr, temp.intval);
+	battmgr->chg.zone = zone;
+	fv = qcom_battmgr_chg_zones[zone].fv;
+	fcc = qcom_battmgr_chg_zones[zone].fcc;
+	if (!hv)
+		fcc = min_t(u32, fcc, CHG_FCC_5V);
+
+	/* the gauge is set up for a higher float voltage and won't report full */
+	if (status.intval == POWER_SUPPLY_STATUS_FULL ||
+	    (volt.intval >= fv - CHG_VFLOAT_MARGIN && curr.intval >= 0 &&
+	     curr.intval < CHG_ITERM && ++battmgr->chg.full_polls >= CHG_FULL_POLLS))
+		battmgr->chg.full = true;
+	else if (curr.intval >= CHG_ITERM)
+		battmgr->chg.full_polls = 0;
+	if (volt.intval < CHG_RECHARGE_VOLT) {
+		battmgr->chg.full = false;
+		battmgr->chg.full_polls = 0;
+	}
+
+	if (fv != battmgr->chg.fv) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+						    BATT_VOLT_MAX, fv);
+		if (ret)
+			goto out;
+		battmgr->chg.fv = fv;
+	}
+
+	if (fcc != battmgr->chg.fcc) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+						    BATT_CHG_CTRL_LIM, fcc);
+		if (ret)
+			goto out;
+		battmgr->chg.fcc = fcc;
+		dev_info(battmgr->dev,
+			 "charging: type %u, %u mV, input %u mA, battery %u mA, %d.%d C\n",
+			 type, vmax / 1000, battmgr->chg.icl / 1000, fcc / 1000,
+			 temp.intval / 10, abs(temp.intval) % 10);
+	}
+
+	enable = fcc && !battmgr->chg.full;
+	if (enable != battmgr->chg.enabled) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+						    BATT_CHG_CTRL_EN, enable);
+		if (ret)
+			goto out;
+		if (battmgr->chg.enabled >= 0)
+			dev_info(battmgr->dev, "charging %s: %d mV, %d mA, %d.%d C\n",
+				 enable ? "resumed" : "stopped", volt.intval / 1000,
+				 curr.intval / 1000, temp.intval / 10, abs(temp.intval) % 10);
+		battmgr->chg.enabled = enable;
+	}
+
+out:
+	/* -ENXIO: seen for the first seconds of boot, the next poll gets through */
+	if (ret && ret != -ENXIO)
+		dev_err(battmgr->dev, "charging update failed: %d\n", ret);
+	if (climbing || battmgr->chg.polls < 3)
+		next = CHG_POLL_SETTLE;
+	battmgr->chg.polls++;
+	mutex_unlock(&battmgr->lock);
+	schedule_delayed_work(&battmgr->chg_work, next);
+	return;
+
+reset:
+	if (battmgr->chg.online)
+		pm_relax(battmgr->dev);
+	memset(&battmgr->chg, 0, sizeof(battmgr->chg));
+	mutex_unlock(&battmgr->lock);
+	/* could already be a new attach, whose notifications raced with this */
+	if (detach)
+		schedule_delayed_work(&battmgr->chg_work, CHG_POLL_SETTLE);
+}
+
 static void qcom_battmgr_pdr_notify(void *priv, int state)
 {
 	struct qcom_battmgr *battmgr = priv;
@@ -1738,11 +2043,11 @@ static char *qcom_battmgr_battery[] = { "battery" };
