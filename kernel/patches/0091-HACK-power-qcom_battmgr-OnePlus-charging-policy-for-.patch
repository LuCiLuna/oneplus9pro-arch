@@ -1758,46 +2063,68 @@ static ssize_t qcom_battmgr_dbg_usb_write(struct file *file, const char __user *
 		return -EINVAL;
 
 	mutex_lock(&battmgr->lock);
-	battmgr->dbg_usb_prop = prop;
+	battmgr->dbg_prop = prop;
