From a254ec26864f4c3207754b3c4bee47c764490d68 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Fri, 30 Oct 2026 10:17:51 +0000
Subject: [PATCH 015/110] arm64: dts: qcom: sm8350-lemonadep: USB role
 switching via pmic_glink UCSI

Drop the bring-up peripheral pin: dwc3 is an OTG role switch driven by the
Type-C port (pmic_glink UCSI on the ADSP), defaulting to peripheral so the
USB gadget works before the ADSP is up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index e298368c33b..0bb5667b85f 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -82,11 +82,14 @@ tp_rst_suspend: tp-rst-suspend-state {
 };
 
 /*
- * BRING-UP ONLY: pin USB to device mode so the USB gadget works before
- * ADSP/pmic_glink role switching is up. Remove once role switching works.
+ * USB role follows the Type-C port via pmic_glink UCSI on the ADSP. Default
+ * to peripheral so the USB gadget (network/serial) works before the ADSP and
+ * UCSI are up.
  */
 &usb_1_dwc3 {
-	dr_mode = "peripheral";
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
 };
 
