diff --git a/drivers/input/misc/oneplus-alert-slider.c b/drivers/input/misc/oneplus-alert-slider.c
new file mode 100644
index 00000000000..e79f2a9e4a0
--- /dev/null
+++ b/drivers/input/misc/oneplus-alert-slider.c
@@ -0,0 +1,364 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OnePlus alert slider
+ *
+ * A magnet moves between two IST8801 hall sensors, so the difference between their
+ * readings gives the position. Position is reported as ABS_MISC: 0 top, 1 middle,
+ * 2 bottom. Userspace can read it at any time, not only when it changes.
+ *
+ * Register sequence comes from the OnePlus vendor driver.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of_irq.h>
+#include <linux/module.h>
+#include <linux/pm.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define IST8801_REG_PERSINT		0x00
+#define IST8801_PERSINT_COUNT		(2 << 4)
+#define IST8801_PERSINT_CLEAR		BIT(0)
+#define IST8801_REG_INTSRS		0x01
+#define IST8801_INTSRS_INT_ON		BIT(7)
+#define IST8801_REG_LTHL		0x02
+#define IST8801_REG_HTHL		0x04
+#define IST8801_REG_SRST		0x07
+#define IST8801_SRST_RESET		BIT(0)
+#define IST8801_REG_OPF			0x08
+#define IST8801_OPF_STANDBY		0x00
+#define IST8801_OPF_10HZ		0x10
+#define IST8801_REG_DID			0x09
+#define IST8801_DID			0x81
+#define IST8801_REG_ST1			0x10
+#define IST8801_REG_IFCNTL		0x40
+#define IST8801_IFCNTL_I2C_ONLY		BIT(2)
+#define IST8801_REG_OSRCNTL		0x6c
+#define IST8801_REG_TSTCNTL		0x76
+
+#define SLIDER_NUM_SENSORS		2
+#define SLIDER_DEBOUNCE_MS		50
+/* The sensor interrupts once a reading leaves this window */
+#define SLIDER_THRESH_MARGIN		22
+/* The positions read about 100 apart, with about 10 of noise */
+#define SLIDER_DIFF_END			60
+#define SLIDER_DIFF_MIDDLE		40
+
+enum slider_position {
+	SLIDER_TOP,
+	SLIDER_MIDDLE,
+	SLIDER_BOTTOM,
+};
+
+struct slider_sensor {
+	struct regmap *regmap;
+	int irq;
+	bool irq_disabled;
+};
+
+struct alert_slider {
+	struct device *dev;
+	struct input_dev *input;
+	struct slider_sensor sensors[SLIDER_NUM_SENSORS]; /* up, down */
+	struct delayed_work work;
+	spinlock_t lock;
+	int position;
+};
+
+static const struct regmap_config ist8801_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int ist8801_read(struct slider_sensor *sensor, s16 *val)
+{
+	__le16 raw;
+	u8 buf[3];
+	int ret;
+
+	ret = regmap_bulk_read(sensor->regmap, IST8801_REG_ST1, buf, sizeof(buf));
+	if (ret)
+		return ret;
+
+	memcpy(&raw, &buf[1], sizeof(raw));
+	*val = le16_to_cpu(raw);
+
+	return 0;
+}
+
+static int ist8801_set_window(struct slider_sensor *sensor, s16 val)
+{
+	u16 low = val - SLIDER_THRESH_MARGIN;
+	u16 high = val + SLIDER_THRESH_MARGIN;
+	const struct reg_sequence seq[] = {
+		{ IST8801_REG_LTHL, low & 0xff },
+		{ IST8801_REG_LTHL + 1, low >> 8 },
+		{ IST8801_REG_HTHL, high & 0xff },
+		{ IST8801_REG_HTHL + 1, high >> 8 },
+		{ IST8801_REG_PERSINT, IST8801_PERSINT_COUNT | IST8801_PERSINT_CLEAR },
+		{ IST8801_REG_PERSINT, IST8801_PERSINT_COUNT },
+	};
+
+	return regmap_multi_reg_write(sensor->regmap, seq, ARRAY_SIZE(seq));
+}
+
+static int ist8801_init(struct slider_sensor *sensor)
+{
+	unsigned int id;
+	int ret;
+
+	ret = regmap_write(sensor->regmap, IST8801_REG_SRST, IST8801_SRST_RESET);
+	if (ret)
+		return ret;
+
+	msleep(20);
+
+	ret = regmap_read(sensor->regmap, IST8801_REG_DID, &id);
+	if (ret)
+		return ret;
+	if (id != IST8801_DID)
+		return -ENODEV;
+
+	ret = regmap_write(sensor->regmap, IST8801_REG_TSTCNTL, 0x04);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(sensor->regmap, IST8801_REG_OSRCNTL, 0x05);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(sensor->regmap, IST8801_REG_PERSINT, IST8801_PERSINT_COUNT);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(sensor->regmap, IST8801_REG_INTSRS, IST8801_INTSRS_INT_ON);
+	if (ret)
+		return ret;
+
+	ret = regmap_set_bits(sensor->regmap, IST8801_REG_IFCNTL, IST8801_IFCNTL_I2C_ONLY);
+	if (ret)
+		return ret;
+
+	return regmap_write(sensor->regmap, IST8801_REG_OPF, IST8801_OPF_10HZ);
+}
+
+/* Readings between the bands mean the slider is moving, so keep the old position */
+static int slider_classify(int position, int diff)
+{
+	if (diff > SLIDER_DIFF_END)
+		return SLIDER_TOP;
+	if (diff < -SLIDER_DIFF_END)
+		return SLIDER_BOTTOM;
+	if (abs(diff) < SLIDER_DIFF_MIDDLE)
+		return SLIDER_MIDDLE;
+
+	return position;
+}
+
+static int slider_update(struct alert_slider *slider)
+{
+	s16 val[SLIDER_NUM_SENSORS];
+	int i, ret;
+
+	for (i = 0; i < SLIDER_NUM_SENSORS; i++) {
+		ret = ist8801_read(&slider->sensors[i], &val[i]);
+		if (ret)
+			return ret;
+
+		ret = ist8801_set_window(&slider->sensors[i], val[i]);
+		if (ret)
+			return ret;
+	}
+
+	slider->position = slider_classify(slider->position, val[0] - val[1]);
+
+	return 0;
+}
+
+static void slider_enable_irqs(struct alert_slider *slider)
+{
+	unsigned long flags;
+	int i;
+
+	spin_lock_irqsave(&slider->lock, flags);
+	for (i = 0; i < SLIDER_NUM_SENSORS; i++) {
+		if (slider->sensors[i].irq_disabled) {
+			slider->sensors[i].irq_disabled = false;
+			enable_irq(slider->sensors[i].irq);
+		}
+	}
+	spin_unlock_irqrestore(&slider->lock, flags);
+}
+
+static void slider_work(struct work_struct *work)
+{
+	struct alert_slider *slider = container_of(to_delayed_work(work),
+						   struct alert_slider, work);
+	int ret;
+
+	ret = slider_update(slider);
+	if (ret) {
+		dev_err_ratelimited(slider->dev, "failed to read sensors: %d\n", ret);
+	} else {
+		input_report_abs(slider->input, ABS_MISC, slider->position);
+		input_sync(slider->input);
+	}
+
+	slider_enable_irqs(slider);
+}
+
+/* The line stays low until the sensor is cleared, which needs I2C, so do that later */
+static irqreturn_t slider_irq(int irq, void *data)
+{
+	struct alert_slider *slider = data;
+	unsigned long flags;
+	int i;
+
+	spin_lock_irqsave(&slider->lock, flags);
+	for (i = 0; i < SLIDER_NUM_SENSORS; i++) {
+		if (slider->sensors[i].irq == irq && !slider->sensors[i].irq_disabled) {
+			slider->sensors[i].irq_disabled = true;
+			disable_irq_nosync(irq);
+		}
+	}
+	spin_unlock_irqrestore(&slider->lock, flags);
+
+	mod_delayed_work(system_percpu_wq, &slider->work, msecs_to_jiffies(SLIDER_DEBOUNCE_MS));
+
+	return IRQ_HANDLED;
+}
+
+static int slider_suspend(struct device *dev)
+{
+	struct alert_slider *slider = dev_get_drvdata(dev);
+	int i;
+
+	for (i = 0; i < SLIDER_NUM_SENSORS; i++)
+		disable_irq(slider->sensors[i].irq);
+
+	cancel_delayed_work_sync(&slider->work);
+	slider_enable_irqs(slider);
+
+	for (i = 0; i < SLIDER_NUM_SENSORS; i++)
+		regmap_write(slider->sensors[i].regmap, IST8801_REG_OPF, IST8801_OPF_STANDBY);
+
+	return 0;
+}
+
+static int slider_resume(struct device *dev)
+{
+	struct alert_slider *slider = dev_get_drvdata(dev);
+	int i;
+
+	for (i = 0; i < SLIDER_NUM_SENSORS; i++) {
+		regmap_write(slider->sensors[i].regmap, IST8801_REG_OPF, IST8801_OPF_10HZ);
+		enable_irq(slider->sensors[i].irq);
+	}
+
+	/* It may have moved during sleep, so read once a fresh sample is ready */
+	mod_delayed_work(system_percpu_wq, &slider->work, msecs_to_jiffies(250));
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(slider_pm_ops, slider_suspend, slider_resume);
+
+static void slider_cancel_work(void *data)
+{
+	cancel_delayed_work_sync(data);
+}
+
+static int slider_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct i2c_client *clients[SLIDER_NUM_SENSORS];
+	struct alert_slider *slider;
+	int i, ret;
+
+	slider = devm_kzalloc(dev, sizeof(*slider), GFP_KERNEL);
+	if (!slider)
+		return -ENOMEM;
+
+	slider->dev = dev;
+	slider->position = SLIDER_MIDDLE;
+	spin_lock_init(&slider->lock);
+	INIT_DELAYED_WORK(&slider->work, slider_work);
+	i2c_set_clientdata(client, slider);
+
+	clients[0] = client;
+	clients[1] = devm_i2c_new_dummy_device(dev, client->adapter, client->addr - 1);
+	if (IS_ERR(clients[1]))
+		return dev_err_probe(dev, PTR_ERR(clients[1]), "failed to add second sensor\n");
+
+	for (i = 0; i < SLIDER_NUM_SENSORS; i++) {
+		slider->sensors[i].regmap = devm_regmap_init_i2c(clients[i], &ist8801_regmap_config);
+		if (IS_ERR(slider->sensors[i].regmap))
+			return PTR_ERR(slider->sensors[i].regmap);
+
+		ret = ist8801_init(&slider->sensors[i]);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to set up sensor %d\n", i);
+	}
+
+	/* First samples at 10 Hz */
+	msleep(250);
+
+	ret = slider_update(slider);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read position\n");
+
+	slider->input = devm_input_allocate_device(dev);
+	if (!slider->input)
+		return -ENOMEM;
+
+	slider->input->name = "OnePlus Alert Slider";
+	input_set_abs_params(slider->input, ABS_MISC, SLIDER_TOP, SLIDER_BOTTOM, 0, 0);
+	input_abs_set_val(slider->input, ABS_MISC, slider->position);
+
+	ret = input_register_device(slider->input);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(dev, slider_cancel_work, &slider->work);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < SLIDER_NUM_SENSORS; i++) {
+		int irq = of_irq_get(dev->of_node, i);
+
+		if (irq < 0)
+			return dev_err_probe(dev, irq, "failed to get interrupt %d\n", i);
+
+		slider->sensors[i].irq = irq;
+		ret = devm_request_irq(dev, irq, slider_irq, 0, "alert-slider", slider);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to request interrupt %d\n", i);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id slider_of_match[] = {
+	{ .compatible = "oneplus,alert-slider" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, slider_of_match);
+
+static struct i2c_driver slider_driver = {
+	.driver = {
+		.name = "oneplus-alert-slider",
+		.of_match_table = slider_of_match,
+		.pm = pm_sleep_ptr(&slider_pm_ops),
+	},
+	.probe = slider_probe,
+};
+module_i2c_driver(slider_driver);
+
+MODULE_DESCRIPTION("OnePlus alert slider driver");
+MODULE_LICENSE("GPL");
