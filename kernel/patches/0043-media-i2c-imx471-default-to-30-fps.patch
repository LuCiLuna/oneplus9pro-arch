From 04d50ba86bc4fdf90569c1260513aff253557a3f Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 15:48:10 +0000
Subject: [PATCH 043/110] media: i2c: imx471: default to 30 fps

Double the default frame length so auto exposure gets 33 ms to work
with indoors; the minimum still allows 58 fps when vblank is lowered.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/imx471.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/media/i2c/imx471.c b/drivers/media/i2c/imx471.c
index 4e5230c8ee6..3a28b1e79c5 100644
--- a/drivers/media/i2c/imx471.c
+++ b/drivers/media/i2c/imx471.c
@@ -285,7 +285,7 @@ static const struct imx471_mode imx471_modes[] = {
 	{
 		.width = 1928,
 		.height = 1088,
-		.fll_def = 1308,
+		.fll_def = 2616,
 		.fll_min = 1308,
 		.llp = 2328,
 		/* 2x2 binned window at (8, 408), then a digital crop at (208, 108) */
