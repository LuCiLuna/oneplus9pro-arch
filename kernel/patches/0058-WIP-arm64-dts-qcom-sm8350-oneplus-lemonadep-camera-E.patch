From 47987b112679bf8dc86258736bcedbaea54bc1db Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:20:18 +0000
Subject: [PATCH 058/114] WIP: arm64: dts: qcom: sm8350-oneplus-lemonadep:
 camera EEPROMs, IMX789 binned link rate

Add the calibration EEPROMs of the main, ultrawide, front and telephoto
modules (addresses from the CamX module data) as read-only AT24s, and
the 1092 MHz link frequency of the IMX789 binned mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8350-oneplus-lemonadep.dts     | 36 ++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index c582e058539..3f2e22ce24e 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -339,11 +339,19 @@ port {
 			imx789_ep: endpoint {
 				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
 				data-lanes = <0 1 2>;
-				link-frequencies = /bits/ 64 <480000000>;
+				link-frequencies = /bits/ 64 <480000000 1092000000>;
 				remote-endpoint = <&csiphy1_ep>;
 			};
 		};
 	};
+
+	/* Main camera module calibration */
+	eeprom@50 {
+		compatible = "atmel,24c128";
+		reg = <0x50>;
+		vcc-supply = <&vreg_l5i>;
+		read-only;
+	};
 };
 
 &cci0_i2c1 {
@@ -378,12 +386,30 @@ imx766_ep: endpoint {
 			};
 		};
 	};
+
+	/* Ultrawide camera module calibration */
+	eeprom@51 {
+		compatible = "atmel,24c128";
+		reg = <0x51>;
+		vcc-supply = <&vreg_l5i>;
+		read-only;
+	};
 };
 
 &cci1 {
 	status = "okay";
 };
 
+&cci1_i2c0 {
+	/* Telephoto module calibration */
+	eeprom@50 {
+		compatible = "atmel,24c128";
+		reg = <0x50>;
+		vcc-supply = <&vreg_l5i>;
+		read-only;
+	};
+};
+
 &cci1_i2c1 {
 	/* Front camera, Truly IMX471 */
 	camera@10 {
@@ -414,6 +440,14 @@ imx471_ep: endpoint {
 			};
 		};
 	};
+
+	/* Front camera module calibration */
+	eeprom@54 {
+		compatible = "atmel,24c64";
+		reg = <0x54>;
+		vcc-supply = <&vreg_l5i>;
+		read-only;
+	};
 };
 
 &i2c19 {
