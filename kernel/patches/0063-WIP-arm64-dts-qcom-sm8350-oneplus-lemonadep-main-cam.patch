From ee87af5b903cfb7c106ef5a84508aba871ec447c Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:57:58 +0000
Subject: [PATCH 063/114] WIP: arm64: dts: qcom: sm8350-oneplus-lemonadep: main
 camera focus motor

The AK7377 VCM driver of the main camera sits at 0x0c on CCI0 bus 0,
powered from pm8350c L9; it is register compatible with the AK7375.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index 280e9d2adf0..b9e7fcc5465 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -376,6 +376,8 @@ camera@1a {
 		vana1-supply = <&vreg_cam_main_avdd1>;
 		vdig-supply = <&vreg_cam_main_dvdd>;
 
+		lens-focus = <&main_vcm>;
+
 		rotation = <90>;
 		orientation = <1>;
 
@@ -389,6 +391,14 @@ imx789_ep: endpoint {
 		};
 	};
 
+	/* Main camera focus motor, AKM AK7377 */
+	main_vcm: focus@c {
+		compatible = "asahi-kasei,ak7375";
+		reg = <0x0c>;
+		vdd-supply = <&pm8350c_l9>;
+		vio-supply = <&vreg_l5i>;
+	};
+
 	/* Main camera module calibration */
 	eeprom@50 {
 		compatible = "atmel,24c128";
