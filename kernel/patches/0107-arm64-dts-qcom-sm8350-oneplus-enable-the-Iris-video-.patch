From bcbdc006357e084ed15c0b2f5b28c70a04b11ad5 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 14:40:43 -0600
Subject: [PATCH 107/110] arm64: dts: qcom: sm8350-oneplus: enable the Iris
 video codec

Uses the firmware from the phone's vendor partition, as the phone only
accepts images signed for it. 4K H.264, HEVC and VP9 decode at 130-150 fps
with output identical to software decoding.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi
index c40f6155a33..f3a7b2ff93d 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi
@@ -831,6 +831,11 @@ &ipa {
 	status = "okay";
 };
 
+&iris {
+	firmware-name = "qcom/sm8350/OnePlus/lemonade/vpu20_4v.mbn";
+	status = "okay";
+};
+
 &mdss {
 	//status = "okay";
 };
