From 9d76360d6cdc1a880d589b0ae0012afecaecc135 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 08:42:41 +0000
Subject: [PATCH 093/110] WIP: drm/msm/dsi: phy: 7nm: adopt a PLL left running
 by the bootloader

Restarting the PLL and resetting the PHY digital block under a running
command mode panel corrupts the link. If the PLL is already on and
locked, just mark it on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
index 5d805a797ab..a66e172da22 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
@@ -491,11 +491,25 @@ static void dsi_pll_phy_dig_reset(struct dsi_pll_7nm *pll)
 	wmb(); /* Ensure that the reset is deasserted */
 }
 
+static int dsi_phy_hw_v4_0_is_pll_on(struct msm_dsi_phy *phy);
+
 static int dsi_pll_7nm_vco_prepare(struct clk_hw *hw)
 {
 	struct dsi_pll_7nm *pll_7nm = to_pll_7nm(hw);
 	int rc;
 
+	/*
+	 * The bootloader may have left the PLL running a splash screen. Adopt
+	 * it as is: restarting it or resetting the PHY digital block under a
+	 * running command mode panel corrupts the link and the panel shuts
+	 * itself off.
+	 */
+	if (!pll_7nm->slave && dsi_phy_hw_v4_0_is_pll_on(pll_7nm->phy) &&
+	    (readl(pll_7nm->phy->pll_base + REG_DSI_7nm_PHY_PLL_COMMON_STATUS_ONE) & BIT(0))) {
+		pll_7nm->phy->pll_on = true;
+		return 0;
+	}
+
 	dsi_pll_enable_pll_bias(pll_7nm);
 	if (pll_7nm->slave)
 		dsi_pll_enable_pll_bias(pll_7nm->slave);
