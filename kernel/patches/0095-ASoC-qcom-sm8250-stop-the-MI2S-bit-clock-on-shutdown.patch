From 057583a795cb1f7345dc598f026218576783ec69 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 09:39:21 -0600
Subject: [PATCH 095/114] ASoC: qcom: sm8250: stop the MI2S bit clock on
 shutdown

Startup turns on the port's bit clock in the DSP with set_sysclk(), but
nothing turns it off: shutdown was only qcom_snd_sdw_shutdown(). The clock
lives inside AFE, so the Linux clock counts all read zero while it runs.

The ADSP then never sleeps after the first stream, which on a desktop-style
session means from the moment PipeWire probes the card. On OnePlus 9 Pro it
went from sleeping through idle to 0 ms of every 8 s, staying that way with
every PCM closed. With this, it sleeps 100% of the time between streams.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/qcom/sm8250.c | 43 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 76dc3a3f4a3..8c6edb7da15 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -135,6 +135,47 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_startup(substream);
 }
 
+static void sm8250_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	int clk_id, dir = SNDRV_PCM_STREAM_PLAYBACK;
+
+	/*
+	 * Stopping the port leaves the bit clock from startup running in the
+	 * DSP, which then never sleeps and holds CX and DDR up with it.
+	 */
+	switch (cpu_dai->id) {
+	case PRIMARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT;
+		break;
+	case SECONDARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_SEC_MI2S_IBIT;
+		break;
+	case TERTIARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_TER_MI2S_IBIT;
+		break;
+	case QUINARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_QUI_MI2S_IBIT;
+		break;
+	case LPI_MI2S_RX_0:
+		clk_id = Q6AFE_LPASS_CLK_ID_INT0_MI2S_IBIT;
+		break;
+	case LPI_MI2S_TX_3:
+		clk_id = Q6AFE_LPASS_CLK_ID_INT3_MI2S_IBIT;
+		dir = SNDRV_PCM_STREAM_CAPTURE;
+		break;
+	default:
+		clk_id = 0;
+		break;
+	}
+
+	if (clk_id)
+		snd_soc_dai_set_sysclk(cpu_dai, clk_id, 0, dir);
+
+	qcom_snd_sdw_shutdown(substream);
+}
+
 static int sm8250_snd_prepare(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -155,7 +196,7 @@ static int sm8250_snd_hw_free(struct snd_pcm_substream *substream)
 
 static const struct snd_soc_ops sm8250_be_ops = {
 	.startup = sm8250_snd_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.shutdown = sm8250_snd_shutdown,
 	.hw_free = sm8250_snd_hw_free,
 	.prepare = sm8250_snd_prepare,
 };
