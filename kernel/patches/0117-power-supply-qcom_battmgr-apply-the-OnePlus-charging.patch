From 9e7469eb7d0af9e58c9b76beb4f2a9123de3fcb7 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Mon, 2 Nov 2026 02:03:01 -0600
Subject: [PATCH] power: supply: qcom_battmgr: apply the OnePlus charging
 limits to wireless

The charging firmware receives power from the wireless coil without any
help from the AP, so the receiver starts charging as soon as it is placed
on a pad. The policy worker only looked at USB, which left wireless at
the firmware's defaults, and the firmware believes the battery is always
at 25 C: nothing stopped charging on a hot battery.

Run the worker for wireless too, with the same temperature zones and stop
at full, and battery current capped at the firmware's default of 500 mA.
The firmware sends 0x3b on attach and 0x3c on detach. Input current is
left to the firmware and the receiver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_battmgr.c | 44 +++++++++++++++++++++++------
 1 file changed, 36 insertions(+), 8 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 2f1bde1b283..39e0e70dae3 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -45,6 +45,8 @@ enum qcom_battmgr_variant {
 /* OnePlus (oplus) firmware: USB events and OTG requests */
 #define NOTIF_OPLUS_USB_ONLINE		0x39
 #define NOTIF_OPLUS_USB_OFFLINE		0x3a
+#define NOTIF_OPLUS_WLS_ONLINE		0x3b
+#define NOTIF_OPLUS_WLS_OFFLINE		0x3c
 #define NOTIF_OPLUS_USB_PRESENT		0x3d
 #define NOTIF_OPLUS_USB_APSD_DONE	0x3e
 #define NOTIF_OPLUS_USB_NO_PRESENT	0x3f
@@ -1296,6 +1298,13 @@ static void qcom_battmgr_notification(struct qcom_battmgr *battmgr,
 		power_supply_changed(battmgr->usb_psy);
 		mod_delayed_work(system_percpu_wq, &battmgr->chg_work, HZ);
 		break;
+	case NOTIF_OPLUS_WLS_ONLINE:
+	case NOTIF_OPLUS_WLS_OFFLINE:
+		if (!battmgr->otg_boost)
+			goto unknown;
+		power_supply_changed(battmgr->wls_psy);
+		mod_delayed_work(system_percpu_wq, &battmgr->chg_work, HZ);
+		break;
 	case NOTIF_OPLUS_SVID:
 	case NOTIF_OTHER_SVID:
 		if (!battmgr->otg_boost)
@@ -1776,6 +1785,7 @@ static const struct {
 };
 
 #define CHG_FCC_5V		1100000
+#define CHG_FCC_WLS		500000
 #define CHG_ICL_9V		2000000
 #define CHG_ICL_CDP		1500000
 #define CHG_ICL_DEFAULT		500000
@@ -1849,7 +1859,7 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 	union power_supply_propval temp, volt, curr, status;
 	u32 online, type, vbus, vmax, cmax, icl = 0, fcc, fv;
 	unsigned long next = CHG_POLL;
-	bool pd, hv, detach, climbing = false, enable;
+	bool pd, hv = false, detach, climbing = false, enable, wireless = false;
 	int zone, ret;
 
 	if (!battmgr->service_up)
@@ -1882,8 +1892,15 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 	ret = qcom_battmgr_chg_get(battmgr, USB_ONLINE, &online);
 	if (ret)
 		goto out;
-	if (!online)
-		goto reset;
+	if (!online) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_WLS_PROPERTY_GET,
+						    WLS_ONLINE, 0);
+		if (ret)
+			goto out;
+		wireless = battmgr->wireless.online;
+		if (!wireless)
+			goto reset;
+	}
 
 	if (!battmgr->chg.online) {
 		battmgr->chg.online = true;
@@ -1903,6 +1920,10 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 	if (ret)
 		goto out;
 
+	/* the firmware and the receiver settle the input current between them */
+	if (wireless)
+		goto limits;
+
 	ret = qcom_battmgr_chg_get(battmgr, USB_ADAP_TYPE, &type);
 	if (!ret)
 		ret = qcom_battmgr_chg_get(battmgr, USB_VOLT_NOW, &vbus);
@@ -1957,11 +1978,14 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 		battmgr->chg.icl = icl;
 	}
 
+limits:
 	zone = qcom_battmgr_chg_zone(battmgr, temp.intval);
 	battmgr->chg.zone = zone;
 	fv = qcom_battmgr_chg_zones[zone].fv;
 	fcc = qcom_battmgr_chg_zones[zone].fcc;
-	if (!hv)
+	if (wireless)
+		fcc = min_t(u32, fcc, CHG_FCC_WLS);
+	else if (!hv)
 		fcc = min_t(u32, fcc, CHG_FCC_5V);
 
 	/* the gauge is set up for a higher float voltage and won't report full */
@@ -1990,10 +2014,14 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 		if (ret)
 			goto out;
 		battmgr->chg.fcc = fcc;
-		dev_info(battmgr->dev,
-			 "charging: type %u, %u mV, input %u mA, battery %u mA, %d.%d C\n",
-			 type, vmax / 1000, battmgr->chg.icl / 1000, fcc / 1000,
-			 temp.intval / 10, abs(temp.intval) % 10);
+		if (wireless)
+			dev_info(battmgr->dev, "charging: wireless, battery %u mA, %d.%d C\n",
+				 fcc / 1000, temp.intval / 10, abs(temp.intval) % 10);
+		else
+			dev_info(battmgr->dev,
+				 "charging: type %u, %u mV, input %u mA, battery %u mA, %d.%d C\n",
+				 type, vmax / 1000, battmgr->chg.icl / 1000, fcc / 1000,
+				 temp.intval / 10, abs(temp.intval) % 10);
 	}
 
 	enable = fcc && !battmgr->chg.full;
