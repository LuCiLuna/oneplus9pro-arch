From 181d960427bf32bdc152a4fbb1cba3fb803ce6dc Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 18:53:04 +0000
Subject: [PATCH 054/110] media: qcom: camss: vfe: scale camnoc_axi_src with
 the pipeline

The SM8250 resources (also used for SM8350) carry the CAMNOC AXI rate
table on "camnoc_axi_src", but only "camnoc_axi" was matched, so the
camera NoC stayed at its 19.2 MHz XO rate. That is enough for a small
sensor, but a 12 MP stream at 30 fps backs up the VFE write path and
CSID drops every frame (RDI ERROR_REC_FRAME_DROP). Scale it like the
VFE core clock.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/platform/qcom/camss/camss-vfe.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
index 319d1915898..8d3cffc289c 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -919,6 +919,7 @@ static int vfe_match_clock_names(struct vfe_device *vfe,
 		!strcmp(clock->name, vfe_lite_name) ||
 		!strcmp(clock->name, "vfe_lite") ||
 		!strcmp(clock->name, "camnoc_axi") ||
+		!strcmp(clock->name, "camnoc_axi_src") ||
 		!strcmp(clock->name, "camnoc_rt_axi"));
 }
 
