From c4125219a5f8a849d24a00a7b08d24bcc9aa49f6 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 06:22:32 +0000
Subject: [PATCH 090/110] HACK: power: qcom_battmgr: OnePlus OTG: enable the
 wireless RX path too

Without it the OTG boost also reaches the PM8350B USB input: the charger
firmware reports a charger present 5.5 s after OTG starts, runs charger
detection on DP/DM and takes the datapath from the host controller. The
vendor wireless driver sets wrx_en (PM8350C GPIO 6) whenever OTG is on;
with it USBIN never sees VBUS, there is no APSD, and USB stays offline.

Also log the firmware notifications and OTG steps at debug level.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8350-oneplus-lemonadep.dts     | 14 +++++++++++++-
 drivers/power/supply/qcom_battmgr.c                | 13 +++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index 99530b5e2b1..90c2efbb08e 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -879,10 +879,22 @@ &vamacro {
  */
 &pmic_glink {
 	oplus,otg-boost-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
-	pinctrl-0 = <&otg_boost_default>;
+	oplus,otg-wrx-en-gpios = <&pm8350c_gpios 6 GPIO_ACTIVE_HIGH>;
+	pinctrl-0 = <&otg_boost_default>, <&otg_wrx_en_default>;
 	pinctrl-names = "default";
 };
 
+&pm8350c_gpios {
+	otg_wrx_en_default: otg-wrx-en-default-state {
+		pins = "gpio6";
+		function = "normal";
+		power-source = <1>;
+		bias-disable;
+		qcom,drive-strength = <3>;
+		output-low;
+	};
+};
+
 &q6afedai {
 	dai@20 {
 		reg = <TERTIARY_MI2S_RX>;
diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 279bb135898..e926ca18945 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -353,6 +353,7 @@ struct qcom_battmgr {
 
 	/* OnePlus OTG: external VBUS boost, switched on at the firmware's request */
 	struct gpio_desc *otg_boost;
+	struct gpio_desc *otg_wrx_en;
 	struct work_struct otg_work;
 	bool otg_on;
 
@@ -1228,6 +1229,7 @@ static void qcom_battmgr_notification(struct qcom_battmgr *battmgr,
 
 	notification = le32_to_cpu(msg->notification);
 	notification &= 0xff;
+	dev_dbg(battmgr->dev, "notification %#x\n", notification);
 	switch (notification) {
 	case NOTIF_BAT_INFO:
 		battmgr->info.valid = false;
@@ -1679,11 +1681,13 @@ static void qcom_battmgr_otg_worker(struct work_struct *work)
 	if (on) {
 		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
 						    OPLUS_USB_OTG_EN, 1);
+		gpiod_set_value_cansleep(battmgr->otg_wrx_en, 1);
 		msleep(50);
 		gpiod_set_value_cansleep(battmgr->otg_boost, 1);
 	} else {
 		gpiod_set_value_cansleep(battmgr->otg_boost, 0);
 		msleep(50);
+		gpiod_set_value_cansleep(battmgr->otg_wrx_en, 0);
 		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
 						    OPLUS_USB_OTG_EN, 0);
 		if (!ret)
@@ -1694,6 +1698,8 @@ static void qcom_battmgr_otg_worker(struct work_struct *work)
 
 	if (ret)
 		dev_err(battmgr->dev, "failed to turn OTG %s: %d\n", on ? "on" : "off", ret);
+	else
+		dev_dbg(battmgr->dev, "OTG %s\n", on ? "on" : "off");
 }
 
 static void qcom_battmgr_otg_off(void *data)
@@ -1701,6 +1707,7 @@ static void qcom_battmgr_otg_off(void *data)
 	struct qcom_battmgr *battmgr = data;
 
 	gpiod_set_value_cansleep(battmgr->otg_boost, 0);
+	gpiod_set_value_cansleep(battmgr->otg_wrx_en, 0);
 }
 
 static void qcom_battmgr_pdr_notify(void *priv, int state)
@@ -1891,6 +1898,12 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 		return dev_err_probe(dev, PTR_ERR(battmgr->otg_boost),
 				     "failed to get OTG boost GPIO\n");
 
+	/* the vendor driver also enables the wireless receiver path for OTG */
+	battmgr->otg_wrx_en = devm_gpiod_get_optional(dev, "oplus,otg-wrx-en", GPIOD_OUT_LOW);
+	if (IS_ERR(battmgr->otg_wrx_en))
+		return dev_err_probe(dev, PTR_ERR(battmgr->otg_wrx_en),
+				     "failed to get OTG wireless RX enable GPIO\n");
+
 	if (battmgr->otg_boost) {
 		ret = devm_add_action_or_reset(dev, qcom_battmgr_otg_off, battmgr);
 		if (ret)
