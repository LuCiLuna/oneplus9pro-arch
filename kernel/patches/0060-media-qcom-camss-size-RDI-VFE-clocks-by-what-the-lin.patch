From f266b1a58987c2e5c5ac4a95489f5496cc880e37 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:20:18 +0000
Subject: [PATCH 060/110] media: qcom: camss: size RDI VFE clocks by what the
 link carries

The VFE clock for an RDI line is derived from the sensor's
V4L2_CID_PIXEL_RATE. For a binning sensor that is the pixel array
readout rate, which can be several times what reaches the CSI-2
receiver: the IMX789 4x4 binned mode reads 3.5 Gpixel/s but sends
1.5 Gpixel/s, and the computed rate exceeded every VFE level.

RDI only has to keep up with the link, so cap the rate by the pixel
rate the link (D-PHY lanes or C-PHY trios at the sensor's link
frequency) can deliver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/platform/qcom/camss/camss-vfe.c | 48 ++++++++++++++++++-
 1 file changed, 46 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
index 8d3cffc289c..600d485d268 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -939,6 +939,46 @@ static bool vfe_check_clock_levels(struct camss_clock *clock)
 	return false;
 }
 
+/*
+ * vfe_link_pixel_rate - Pixels per second the CSI-2 link into an RDI line carries
+ * @line: VFE RDI line
+ * @bpp: bits per pixel
+ *
+ * A binning sensor reads its array (V4L2_CID_PIXEL_RATE) much faster than it
+ * sends pixels, and RDI only has to keep up with what arrives.
+ *
+ * Return the rate, or U64_MAX when it is not known
+ */
+static u64 vfe_link_pixel_rate(struct vfe_line *line, u8 bpp)
+{
+	struct media_pad *pad;
+	struct csid_device *csid;
+	bool cphy;
+	s64 link_freq;
+	u64 bits;
+
+	pad = media_pad_remote_pad_first(&line->pads[MSM_VFE_PAD_SINK]);
+	if (!pad || !is_media_entity_v4l2_subdev(pad->entity) || !bpp)
+		return U64_MAX;
+
+	csid = v4l2_get_subdevdata(media_entity_to_v4l2_subdev(pad->entity));
+	if (!csid || !csid->phy.lane_cnt)
+		return U64_MAX;
+
+	cphy = csid->phy.phy_sel == CSID_PHY_SEL_CPHY;
+	link_freq = camss_get_link_freq(&csid->subdev.entity, bpp,
+					csid->phy.lane_cnt, cphy);
+	if (link_freq <= 0)
+		return U64_MAX;
+
+	/* two bits (D-PHY) or symbols (C-PHY) per clock; 16 bits per 7 symbols */
+	bits = (u64)link_freq * 2 * csid->phy.lane_cnt;
+	if (cphy)
+		bits = div_u64(bits * 16, 7);
+
+	return div_u64(bits, bpp);
+}
+
 /*
  * vfe_set_clock_rates - Calculate and set clock rates on VFE module
  * @vfe: VFE device
@@ -978,7 +1018,9 @@ static int vfe_set_clock_rates(struct vfe_device *vfe)
 					bpp = camss_format_get_bpp(l->formats,
 								   l->nformats,
 								   l->fmt[MSM_VFE_PAD_SINK].code);
-					tmp = pixel_clock[j] * bpp / 64;
+					tmp = min(pixel_clock[j],
+						  vfe_link_pixel_rate(l, bpp)) *
+					      bpp / 64;
 				}
 
 				if (min_rate < tmp)
@@ -1059,7 +1101,9 @@ static int vfe_check_clock_rates(struct vfe_device *vfe)
 					bpp = camss_format_get_bpp(l->formats,
 								   l->nformats,
 								   l->fmt[MSM_VFE_PAD_SINK].code);
-					tmp = pixel_clock[j] * bpp / 64;
+					tmp = min(pixel_clock[j],
+						  vfe_link_pixel_rate(l, bpp)) *
+					      bpp / 64;
 				}
 
 				if (min_rate < tmp)
