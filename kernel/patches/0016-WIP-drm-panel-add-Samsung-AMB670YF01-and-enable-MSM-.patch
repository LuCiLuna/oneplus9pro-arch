+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x00, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb9, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2a, 0x00, 0x00, 0x04, 0x37);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2b, 0x00, 0x00, 0x09, 0x6b);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc3, 0x89);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x24, 0xc3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc3, 0xfd, 0x00, 0xfd, 0x00, 0xfd, 0x00, 0xfd, 0x00, 0xfd, 0x00, 0xfd, 0x00, 0xfd, 0x00, 0xfd, 0x00, 0xfd);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x3a, 0xc3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc3, 0xb0, 0x00, 0xb0, 0x00, 0xb0, 0x00, 0xb0, 0x00, 0xb0, 0x00, 0xb0, 0x00, 0xb0, 0x00, 0xb0, 0x00, 0xb0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x50, 0xc3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc3, 0x43, 0x00, 0x43, 0x00, 0x43, 0x00, 0x43, 0x00, 0x43, 0x00, 0x43, 0x00, 0x43, 0x00, 0x43, 0x00, 0x43);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x61, 0xc3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc3, 0xcc, 0xcc, 0xcc, 0xcc, 0xc0, 0xfe, 0x00, 0xfe, 0x00, 0xfe, 0x00, 0xfe, 0x00, 0xfe, 0x00, 0xfe, 0x00, 0xfe, 0x00, 0xfe, 0x00, 0xfe);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x2b, 0xf6);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf6, 0x60, 0x63, 0x69);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x46, 0xf4);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf4, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x18, 0xb1);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb1, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0d, 0x63);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x63, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0c, 0x63);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x63, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x53, 0x28);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x52, 0x1f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1f, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x54, 0x1f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1f, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amb670yf01_enable(struct drm_panel *panel)
+{
+	struct amb670yf01 *ctx = to_amb670yf01(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* vendor qcom,mdss-dsi-post-on-backlight */
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amb670yf01_disable(struct drm_panel *panel)
+{
+	struct amb670yf01 *ctx = to_amb670yf01(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 21);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 101);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amb670yf01_prepare(struct drm_panel *panel)
+{
+	struct amb670yf01 *ctx = to_amb670yf01(panel);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(amb670yf01_supplies), ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	amb670yf01_reset(ctx);
+
+	ret = amb670yf01_on(ctx);
+	if (ret < 0) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(amb670yf01_supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int amb670yf01_unprepare(struct drm_panel *panel)
+{
+	struct amb670yf01 *ctx = to_amb670yf01(panel);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(amb670yf01_supplies), ctx->supplies);
+
+	return 0;
+}
+
+/*
+ * In command mode the porches only model transfer overhead, and msm derives
+ * the DSI bit clock from the mode clock. The vendor runs the link at
+ * 825.6 Mbps/lane (qcom,mdss-dsi-panel-clockrate) so a frame is sent in ~6 ms
+ * (qcom,mdss-mdp-transfer-time-us); with the vendor hfp of 64 the link only
+ * reaches 445 Mbps, the transfer takes most of the frame and the panel's scan
+ * overtakes it, which shows as text flickering on every update. Widen hfp so
+ * the derived bit clock matches the vendor rate.
+ */
+#define AMB670YF01_HFP	413
+
+static const struct drm_display_mode amb670yf01_mode = {
+	.clock = (1080 + AMB670YF01_HFP + 8 + 48) * (2412 + 2 + 2 + 8) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + AMB670YF01_HFP,
+	.hsync_end = 1080 + AMB670YF01_HFP + 8,
+	.htotal = 1080 + AMB670YF01_HFP + 8 + 48,
+	.vdisplay = 2412,
+	.vsync_start = 2412 + 2,
+	.vsync_end = 2412 + 2 + 2,
+	.vtotal = 2412 + 2 + 2 + 8,
+	.width_mm = 71,
+	.height_mm = 159,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int amb670yf01_get_modes(struct drm_panel *panel,
+				struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &amb670yf01_mode);
+}
+
+static const struct drm_panel_funcs amb670yf01_panel_funcs = {
+	.prepare = amb670yf01_prepare,
+	.unprepare = amb670yf01_unprepare,
+	.enable = amb670yf01_enable,
+	.disable = amb670yf01_disable,
+	.get_modes = amb670yf01_get_modes,
+};
+
+static int amb670yf01_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret < 0 ? ret : 0;
+}
+
+static const struct backlight_ops amb670yf01_bl_ops = {
+	.update_status = amb670yf01_bl_update_status,
+};
+
+static struct backlight_device *amb670yf01_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 400,	/* vendor qcom,mdss-brightness-default-level */
+		.max_brightness = 2047,	/* normal max; above is high-brightness mode */
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &amb670yf01_bl_ops, &props);
+}
+
+#ifdef CONFIG_DEBUG_FS
+/*
+ * Bring-up aid: echo "f0 5a 5a" > dcs sends a DCS write in HS mode,
+ * echo "r 0a 1" > dcs reads 1 byte of register 0x0a; cat dcs shows the result.
+ */
+static ssize_t amb670yf01_dcs_write(struct file *file, const char __user *ubuf,
+				    size_t len, loff_t *ppos)
+{
+	struct amb670yf01 *ctx = file->private_data;
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	char *buf, *p, *tok;
+	bool rd = false;
+	u8 data[64];
+	int n = 0, ret;
+
+	buf = memdup_user_nul(ubuf, len);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	p = buf;
+	ret = 0;
+	while ((tok = strsep(&p, " \t\n"))) {
+		if (!*tok)
+			continue;
+		if (!n && !rd && !strcmp(tok, "r")) {
+			rd = true;
+			continue;
+		}
+		if (n >= ARRAY_SIZE(data) || kstrtou8(tok, 16, &data[n++])) {
+			ret = -EINVAL;
+			break;
+		}
+	}
+	kfree(buf);
+	if (ret || !n)
+		return -EINVAL;
+
+	if (rd) {
+		ret = mipi_dsi_dcs_read(dsi, data[0], ctx->rbuf,
+					min_t(size_t, n > 1 ? data[1] : 1, sizeof(ctx->rbuf)));
+		ctx->rlen = max(ret, 0);
+	} else {
+		dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		ret = mipi_dsi_dcs_write_buffer(dsi, data, n);
+		dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	}
+
+	return ret < 0 ? ret : len;
+}
+
+static ssize_t amb670yf01_dcs_read(struct file *file, char __user *ubuf,
+				   size_t len, loff_t *ppos)
+{
+	struct amb670yf01 *ctx = file->private_data;
+	char out[3 * sizeof(ctx->rbuf) + 2];
+	int i, n = 0;
+
+	for (i = 0; i < ctx->rlen; i++)
+		n += scnprintf(out + n, sizeof(out) - n, "%02x ", ctx->rbuf[i]);
+	n += scnprintf(out + n, sizeof(out) - n, "\n");
+
+	return simple_read_from_buffer(ubuf, len, ppos, out, n);
+}
+
+static const struct file_operations amb670yf01_dcs_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = amb670yf01_dcs_read,
+	.write = amb670yf01_dcs_write,
+	.llseek = default_llseek,
+};
+
+static void amb670yf01_debugfs_init(struct amb670yf01 *ctx)
+{
+	ctx->debugfs = debugfs_create_dir("amb670yf01", NULL);
+	debugfs_create_file("dcs", 0600, ctx->debugfs, ctx, &amb670yf01_dcs_fops);
+}
+
+static void amb670yf01_debugfs_exit(struct amb670yf01 *ctx)
+{
+	debugfs_remove_recursive(ctx->debugfs);
+}
+#else
+static void amb670yf01_debugfs_init(struct amb670yf01 *ctx) {}
+static void amb670yf01_debugfs_exit(struct amb670yf01 *ctx) {}
+#endif
+
+static int amb670yf01_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct amb670yf01 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct amb670yf01, panel,
+				   &amb670yf01_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(amb670yf01_supplies),
+					    amb670yf01_supplies, &ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = bpc == 8 ? MIPI_DSI_FMT_RGB888 : MIPI_DSI_FMT_RGB101010;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	/* vendor qcom,mdss-dsi-lp11-init */
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = amb670yf01_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	dsi->dsc = &ctx->dsc;
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 36;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = bpc == 8 ? 8 : 10;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	amb670yf01_debugfs_init(ctx);
+
+	return 0;
+}
+
+static void amb670yf01_remove(struct mipi_dsi_device *dsi)
+{
+	struct amb670yf01 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	amb670yf01_debugfs_exit(ctx);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id amb670yf01_of_match[] = {
+	{ .compatible = "samsung,amb670yf01" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, amb670yf01_of_match);
+
+static struct mipi_dsi_driver amb670yf01_driver = {
+	.probe = amb670yf01_probe,
+	.remove = amb670yf01_remove,
+	.driver = {
+		.name = "panel-samsung-amb670yf01",
+		.of_match_table = amb670yf01_of_match,
+	},
+};
+module_mipi_dsi_driver(amb670yf01_driver);
+
+MODULE_DESCRIPTION("DRM driver for Samsung AMB670YF01 DSC cmd mode panel (OnePlus 9 Pro)");
+MODULE_LICENSE("GPL");
