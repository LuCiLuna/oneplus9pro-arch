From 3b2f485d2eab9425f687ec17ece4a5beb20d0985 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Mon, 2 Nov 2026 02:27:43 -0600
Subject: [PATCH 119/120] power: supply: qcom_battmgr: wake for a charger and
 don't sleep on one

The charging policy runs on the AP, and it's the only thing that knows
the battery's temperature. Nothing ran it during sleep, in two ways:

Plugging in or placing the phone on a wireless pad didn't wake it, so a
new charger waited at the firmware's defaults until something else did.
Wake on the firmware's attach notifications.

pm_stay_awake() doesn't keep the system up unless userspace goes through
wakeup_count, and systemd doesn't. After 15 idle minutes the phone slept
on a charger with no temperature limits. Refuse suspend from a PM notifier
while a charger is attached.

The worker reads the gauge over I2C, so move it to a freezable workqueue
to keep it away from suspended adapters.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_battmgr.c | 53 ++++++++++++++++++++++++-----
 1 file changed, 45 insertions(+), 8 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 39e0e70dae3..329203cb600 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -14,6 +14,7 @@
 #include <linux/nvmem-consumer.h>
 #include <linux/of_device.h>
 #include <linux/power_supply.h>
+#include <linux/suspend.h>
 #include <linux/property.h>
 #include <linux/soc/qcom/pdr.h>
 #include <linux/soc/qcom/pmic_glink.h>
@@ -366,6 +367,7 @@ struct qcom_battmgr {
 	/* OnePlus charging policy, which Android keeps on the AP side */
 	struct power_supply *gauge;
 	struct delayed_work chg_work;
+	struct notifier_block chg_pm_nb;
 	bool chg_reset;
 	struct {
 		bool svid;
@@ -1259,6 +1261,13 @@ static void qcom_battmgr_notification(struct qcom_battmgr *battmgr,
 	notification = le32_to_cpu(msg->notification);
 	notification &= 0xff;
 	dev_dbg(battmgr->dev, "notification %#x\n", notification);
+
+	/* the charging policy can't run during sleep, so a new charger has to wake the phone */
+	if (battmgr->otg_boost &&
+	    (notification == NOTIF_OPLUS_USB_ONLINE || notification == NOTIF_OPLUS_USB_PRESENT ||
+	     notification == NOTIF_OPLUS_WLS_ONLINE))
+		pm_wakeup_hard_event(battmgr->dev);
+
 	switch (notification) {
 	case NOTIF_BAT_INFO:
 		battmgr->info.valid = false;
@@ -1296,21 +1305,21 @@ static void qcom_battmgr_notification(struct qcom_battmgr *battmgr,
 		if (!battmgr->otg_boost)
 			goto unknown;
 		power_supply_changed(battmgr->usb_psy);
-		mod_delayed_work(system_percpu_wq, &battmgr->chg_work, HZ);
+		mod_delayed_work(system_freezable_wq, &battmgr->chg_work, HZ);
 		break;
 	case NOTIF_OPLUS_WLS_ONLINE:
 	case NOTIF_OPLUS_WLS_OFFLINE:
 		if (!battmgr->otg_boost)
 			goto unknown;
 		power_supply_changed(battmgr->wls_psy);
-		mod_delayed_work(system_percpu_wq, &battmgr->chg_work, HZ);
+		mod_delayed_work(system_freezable_wq, &battmgr->chg_work, HZ);
 		break;
 	case NOTIF_OPLUS_SVID:
 	case NOTIF_OTHER_SVID:
 		if (!battmgr->otg_boost)
 			goto unknown;
 		WRITE_ONCE(battmgr->chg.svid, true);
-		mod_delayed_work(system_percpu_wq, &battmgr->chg_work, 0);
+		mod_delayed_work(system_freezable_wq, &battmgr->chg_work, 0);
 		break;
 	default:
 unknown:
@@ -1717,7 +1726,7 @@ static void qcom_battmgr_enable_worker(struct work_struct *work)
 		mutex_unlock(&battmgr->lock);
 		if (ret)
 			dev_err(battmgr->dev, "failed to enable OTG: %d\n", ret);
-		mod_delayed_work(system_percpu_wq, &battmgr->chg_work, HZ);
+		mod_delayed_work(system_freezable_wq, &battmgr->chg_work, HZ);
 	}
 }
 
@@ -1873,7 +1882,8 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 		if (IS_ERR(gauge))
 			return;
 		if (!gauge) {
-			schedule_delayed_work(&battmgr->chg_work, CHG_POLL_SETTLE);
+			queue_delayed_work(system_freezable_wq, &battmgr->chg_work,
+					   CHG_POLL_SETTLE);
 			return;
 		}
 		if (devm_add_action(battmgr->dev, qcom_battmgr_put_gauge, battmgr)) {
@@ -2045,7 +2055,7 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 		next = CHG_POLL_SETTLE;
 	battmgr->chg.polls++;
 	mutex_unlock(&battmgr->lock);
-	schedule_delayed_work(&battmgr->chg_work, next);
+	queue_delayed_work(system_freezable_wq, &battmgr->chg_work, next);
 	return;
 
 reset:
@@ -2059,7 +2069,26 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 	mutex_unlock(&battmgr->lock);
 	/* could already be a new attach, whose notifications raced with this */
 	if (detach)
-		schedule_delayed_work(&battmgr->chg_work, CHG_POLL_SETTLE);
+		queue_delayed_work(system_freezable_wq, &battmgr->chg_work, CHG_POLL_SETTLE);
+}
+
+/* Nothing would watch the battery's temperature during sleep, so don't sleep while charging */
+static int qcom_battmgr_chg_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct qcom_battmgr *battmgr = container_of(nb, struct qcom_battmgr, chg_pm_nb);
+
+	if (action == PM_SUSPEND_PREPARE && READ_ONCE(battmgr->service_up) &&
+	    READ_ONCE(battmgr->chg.online))
+		return notifier_from_errno(-EBUSY);
+
+	return NOTIFY_DONE;
+}
+
+static void qcom_battmgr_chg_pm_unregister(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	unregister_pm_notifier(&battmgr->chg_pm_nb);
 }
 
 static void qcom_battmgr_pdr_notify(void *priv, int state)
@@ -2293,8 +2322,16 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 		if (ret)
 			return ret;
 
-		/* no temperature monitoring while suspended: stay up while charging */
 		device_init_wakeup(dev, true);
+
+		battmgr->chg_pm_nb.notifier_call = qcom_battmgr_chg_pm_notify;
+		ret = register_pm_notifier(&battmgr->chg_pm_nb);
+		if (ret)
+			return ret;
+
+		ret = devm_add_action_or_reset(dev, qcom_battmgr_chg_pm_unregister, battmgr);
+		if (ret)
+			return ret;
 	}
 
 	battmgr->client = devm_pmic_glink_client_alloc(dev, PMIC_GLINK_OWNER_BATTMGR,
