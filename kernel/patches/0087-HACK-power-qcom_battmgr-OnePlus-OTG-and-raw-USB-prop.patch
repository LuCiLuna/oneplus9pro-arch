From 6239bc13944653b483f8b09764b680f8de1c8cee Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 06:12:31 +0000
Subject: [PATCH 087/110] HACK: power: qcom_battmgr: OnePlus OTG and raw USB
 property debugfs

The OnePlus 9 Pro charger firmware keeps the Type-C port sink only until
the AP sets its OTG_AP_ENABLE and OTG_SWITCH USB properties (22, 23), and
turns the switch off again on every detach. With the switch on, it sees
an OTG device through the PMIC CID detection, moves the port to DRP and
sends notification 0x46; VBUS then comes from an external boost the AP
enables after setting OTG_EN (19), as the vendor oplus_chg driver does.
Notification 0x47 undoes it.

Do that when the pmic_glink node has an oplus,otg-boost GPIO, handle the
firmware's other USB notifications (0x39-0x3f) as USB property changes,
and add debugfs qcom_battmgr/usb_prop to read and write USB properties
by index for bring-up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_battmgr.c | 183 ++++++++++++++++++++++++++++
 1 file changed, 183 insertions(+)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index c4cacd64724..279bb135898 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -5,7 +5,10 @@
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
 #include <linux/auxiliary_bus.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
 #include <linux/devm-helpers.h>
+#include <linux/gpio/consumer.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/nvmem-consumer.h>
@@ -39,6 +42,20 @@ enum qcom_battmgr_variant {
 #define NOTIF_BAT_INFO			0x81
 #define NOTIF_BAT_CHARGING_STATE	0x83
 
+/* OnePlus (oplus) firmware: USB events and OTG requests */
+#define NOTIF_OPLUS_USB_ONLINE		0x39
+#define NOTIF_OPLUS_USB_OFFLINE		0x3a
+#define NOTIF_OPLUS_USB_PRESENT		0x3d
+#define NOTIF_OPLUS_USB_APSD_DONE	0x3e
+#define NOTIF_OPLUS_USB_NO_PRESENT	0x3f
+#define NOTIF_OPLUS_OTG_ENABLE		0x46
+#define NOTIF_OPLUS_OTG_DISABLE		0x47
+
+/* OnePlus (oplus) firmware USB properties */
+#define OPLUS_USB_OTG_EN		19
+#define OPLUS_USB_OTG_AP_ENABLE		22
+#define OPLUS_USB_OTG_SWITCH		23
+
 #define BATTMGR_BAT_INFO		0x9
 
 #define BATTMGR_BAT_DISCHARGE_TIME	0xc
@@ -334,6 +351,15 @@ struct qcom_battmgr {
 
 	struct work_struct enable_work;
 
+	/* OnePlus OTG: external VBUS boost, switched on at the firmware's request */
+	struct gpio_desc *otg_boost;
+	struct work_struct otg_work;
+	bool otg_on;
+
+	/* HACK: raw USB property access for OnePlus OTG bring-up */
+	u32 dbg_usb_prop;
+	u32 dbg_usb_value;
+
 	/*
 	 * @lock is used to prevent concurrent power supply requests to the
 	 * firmware, as it then stops responding.
@@ -1218,7 +1244,29 @@ static void qcom_battmgr_notification(struct qcom_battmgr *battmgr,
 	case NOTIF_WLS_PROPERTY:
 		power_supply_changed(battmgr->wls_psy);
 		break;
+	case NOTIF_OPLUS_OTG_ENABLE:
+	case NOTIF_OPLUS_OTG_DISABLE:
+		if (!battmgr->otg_boost)
+			goto unknown;
+		WRITE_ONCE(battmgr->otg_on, notification == NOTIF_OPLUS_OTG_ENABLE);
+		schedule_work(&battmgr->otg_work);
+		break;
+	case NOTIF_OPLUS_USB_OFFLINE:
+	case NOTIF_OPLUS_USB_NO_PRESENT:
+		if (!battmgr->otg_boost)
+			goto unknown;
+		/* the firmware turns the OTG switch off on every detach */
+		schedule_work(&battmgr->otg_work);
+		fallthrough;
+	case NOTIF_OPLUS_USB_ONLINE:
+	case NOTIF_OPLUS_USB_PRESENT:
+	case NOTIF_OPLUS_USB_APSD_DONE:
+		if (!battmgr->otg_boost)
+			goto unknown;
+		power_supply_changed(battmgr->usb_psy);
+		break;
 	default:
+unknown:
 		dev_err(battmgr->dev, "unknown notification: %#x\n", notification);
 		break;
 	}
@@ -1495,6 +1543,8 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 		if (battmgr->error)
 			goto out_complete;
 
+		battmgr->dbg_usb_value = le32_to_cpu(resp->intval.value);
+
 		switch (property) {
 		case USB_ONLINE:
 			battmgr->usb.online = le32_to_cpu(resp->intval.value);
@@ -1559,6 +1609,9 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 		break;
 	case BATTMGR_REQUEST_NOTIFICATION:
 	case BATTMGR_CHG_CTRL_LIMIT_EN:
+	case BATTMGR_BAT_PROPERTY_SET:
+	case BATTMGR_USB_PROPERTY_SET:
+	case BATTMGR_WLS_PROPERTY_SET:
 		battmgr->error = 0;
 		break;
 	default:
@@ -1598,6 +1651,56 @@ static void qcom_battmgr_enable_worker(struct work_struct *work)
 	ret = qcom_battmgr_request(battmgr, &req, sizeof(req));
 	if (ret)
 		dev_err(battmgr->dev, "failed to request power notifications\n");
+
+	if (battmgr->otg_boost) {
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						    OPLUS_USB_OTG_AP_ENABLE, 1);
+		if (!ret)
+			ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+							    OPLUS_USB_OTG_SWITCH, 1);
+		mutex_unlock(&battmgr->lock);
+		if (ret)
+			dev_err(battmgr->dev, "failed to enable OTG: %d\n", ret);
+	}
+}
+
+/*
+ * The OnePlus firmware asks for VBUS once it sees an OTG device; it comes from
+ * an external boost, sequenced as the vendor driver does.
+ */
+static void qcom_battmgr_otg_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr, otg_work);
+	bool on = READ_ONCE(battmgr->otg_on);
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	if (on) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						    OPLUS_USB_OTG_EN, 1);
+		msleep(50);
+		gpiod_set_value_cansleep(battmgr->otg_boost, 1);
+	} else {
+		gpiod_set_value_cansleep(battmgr->otg_boost, 0);
+		msleep(50);
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						    OPLUS_USB_OTG_EN, 0);
+		if (!ret)
+			ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+							    OPLUS_USB_OTG_SWITCH, 1);
+	}
+	mutex_unlock(&battmgr->lock);
+
+	if (ret)
+		dev_err(battmgr->dev, "failed to turn OTG %s: %d\n", on ? "on" : "off", ret);
+}
+
+static void qcom_battmgr_otg_off(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	gpiod_set_value_cansleep(battmgr->otg_boost, 0);
 }
 
 static void qcom_battmgr_pdr_notify(void *priv, int state)
@@ -1625,6 +1728,66 @@ static const struct of_device_id qcom_battmgr_of_variants[] = {
 
 static char *qcom_battmgr_battery[] = { "battery" };
 
+/*
+ * HACK: "echo <id> > usb_prop" reads a USB property by its firmware index,
+ * "echo <id> <value> > usb_prop" writes one; cat shows the last value read.
+ */
+static ssize_t qcom_battmgr_dbg_usb_write(struct file *file, const char __user *ubuf,
+					  size_t count, loff_t *ppos)
+{
+	struct qcom_battmgr *battmgr = ((struct seq_file *)file->private_data)->private;
+	char buf[32];
+	u32 prop, value;
+	int n, ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = 0;
+
+	n = sscanf(buf, "%u %u", &prop, &value);
+	if (n < 1)
+		return -EINVAL;
+
+	mutex_lock(&battmgr->lock);
+	battmgr->dbg_usb_prop = prop;
+	if (n == 2)
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						    prop, value);
+	else
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+						    prop, 0);
+	mutex_unlock(&battmgr->lock);
+	dev_info(battmgr->dev, "usb prop %u %s %u: %d\n", prop,
+		 n == 2 ? "set" : "get", n == 2 ? value : battmgr->dbg_usb_value, ret);
+
+	return ret ? ret : count;
+}
+
+static int qcom_battmgr_dbg_usb_show(struct seq_file *s, void *unused)
+{
+	struct qcom_battmgr *battmgr = s->private;
+
+	seq_printf(s, "%u %u\n", battmgr->dbg_usb_prop, battmgr->dbg_usb_value);
+
+	return 0;
+}
+
+static int qcom_battmgr_dbg_usb_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, qcom_battmgr_dbg_usb_show, inode->i_private);
+}
+
+static const struct file_operations qcom_battmgr_dbg_usb_fops = {
+	.owner = THIS_MODULE,
+	.open = qcom_battmgr_dbg_usb_open,
+	.read = seq_read,
+	.write = qcom_battmgr_dbg_usb_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
 static int qcom_battmgr_probe(struct auxiliary_device *adev,
 			      const struct auxiliary_device_id *id)
 {
@@ -1723,6 +1886,22 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	if (ret)
 		return ret;
 
+	battmgr->otg_boost = devm_gpiod_get_optional(dev, "oplus,otg-boost", GPIOD_OUT_LOW);
+	if (IS_ERR(battmgr->otg_boost))
+		return dev_err_probe(dev, PTR_ERR(battmgr->otg_boost),
+				     "failed to get OTG boost GPIO\n");
+
+	if (battmgr->otg_boost) {
+		ret = devm_add_action_or_reset(dev, qcom_battmgr_otg_off, battmgr);
+		if (ret)
+			return ret;
+
+		ret = devm_work_autocancel(dev, &battmgr->otg_work,
+					   qcom_battmgr_otg_worker);
+		if (ret)
+			return ret;
+	}
+
 	battmgr->client = devm_pmic_glink_client_alloc(dev, PMIC_GLINK_OWNER_BATTMGR,
 						       qcom_battmgr_callback,
 						       qcom_battmgr_pdr_notify,
@@ -1732,6 +1911,10 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 
 	pmic_glink_client_register(battmgr->client);
 
+	debugfs_create_file("usb_prop", 0600,
+			    debugfs_create_dir("qcom_battmgr", NULL),
+			    battmgr, &qcom_battmgr_dbg_usb_fops);
+
 	return 0;
 }
 
