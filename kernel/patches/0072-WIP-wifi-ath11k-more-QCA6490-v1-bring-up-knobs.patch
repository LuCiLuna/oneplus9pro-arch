From 1228625bd59e2a7bea0a11369c6654e867d79247 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 01:57:42 +0000
Subject: [PATCH 072/110] WIP: wifi: ath11k: more QCA6490 v1 bring-up knobs

Limit the v1 part to the 4 vdevs the vendor driver asks for, and add
experiment parameters: op9_ddr_start/op9_ddr_size send the host IOVA
window in the QMI host capabilities (TLV 0x1f, as cnss2 does; with it
the firmware page faults right after the memory request),
op9_iova_limit caps the device DMA mask so IOVAs fall inside the vendor
window, and op9_send_hw_mode sends the preferred hardware mode in
WMI_INIT as qcacld does. None of them gets past the WMI_INIT assert,
which is raised by the firmware's hardware error interrupt handler.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/ath/ath11k/core.c |  2 +
 drivers/net/wireless/ath/ath11k/pci.c  | 12 ++++++
 drivers/net/wireless/ath/ath11k/qmi.c  | 55 ++++++++++++++++++++++++++
 drivers/net/wireless/ath/ath11k/qmi.h  |  8 +++-
 drivers/net/wireless/ath/ath11k/wmi.c  |  9 ++++-
 5 files changed, 84 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/core.c b/drivers/net/wireless/ath/ath11k/core.c
index 874767ace15..af0c7991044 100644
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -2640,6 +2640,8 @@ static int ath11k_init_hw_params(struct ath11k_base *ab)
 		qca6490v1_regs.hal_seq_wcss_umac_ce1_dst_reg = wcn6855_regs.hal_seq_wcss_umac_ce1_dst_reg;
 		ab->hw_params.regs = &qca6490v1_regs;
 		ab->hw_params.fix_l1ss = false;
+		/* the v1 firmware runs out of RAM on 17 vdevs; the vendor driver asks for 4 */
+		ab->hw_params.num_vdevs = 4;
 		ath11k_info(ab, "QCA6490 v1: QCA6390 UMAC layout with WCN6855 copy engines\n");
 	}
 
diff --git a/drivers/net/wireless/ath/ath11k/pci.c b/drivers/net/wireless/ath/ath11k/pci.c
index 1723b2c0387..13f4f39bcc0 100644
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -38,6 +38,8 @@ static int op9_profile;	/* 0: WCN6855 hw2.1, 1: QCA6390 hw2.0 */
 module_param(op9_profile, int, 0444);
 static bool op9_fix_l1ss;
 module_param(op9_fix_l1ss, bool, 0444);
+static ulong op9_iova_limit;
+module_param(op9_iova_limit, ulong, 0444);
 
 static const struct pci_device_id ath11k_pci_id_table[] = {
 	{ PCI_VDEVICE(QCOM, QCA6390_DEVICE_ID) },
@@ -1053,6 +1055,16 @@ static int ath11k_pci_probe(struct pci_dev *pdev,
 			ath11k_info(ab, "QCA6490 v1 SoC (1.%x), profile %d, fix_l1ss %d\n",
 				    soc_hw_version_minor, op9_profile, op9_fix_l1ss);
 			ab->qcom_platform = true;
+			/*
+			 * The vendor stack keeps the device's DMA within an
+			 * IOVA window (0xa0000000 + 256 MB) that it tells the
+			 * firmware about; IOVAs come top-down below the mask.
+			 */
+			if (op9_iova_limit) {
+				dma_set_mask(&pdev->dev, op9_iova_limit);
+				dma_set_coherent_mask(&pdev->dev, op9_iova_limit);
+				ab_pci->dma_mask = op9_iova_limit;
+			}
 			break;
 		case 2:
 			switch (soc_hw_version_minor) {
diff --git a/drivers/net/wireless/ath/ath11k/qmi.c b/drivers/net/wireless/ath/ath11k/qmi.c
index 1b95c53bdd6..e24db45f077 100644
--- a/drivers/net/wireless/ath/ath11k/qmi.c
+++ b/drivers/net/wireless/ath/ath11k/qmi.c
@@ -33,6 +33,34 @@ MODULE_PARM_DESC(cold_boot_cal,
 /* BRING-UP knob for early QCA6490 (v1) silicon */
 static bool op9_no_regdb;
 module_param(op9_no_regdb, bool, 0444);
+static ulong op9_ddr_start = 0x80000000;
+module_param(op9_ddr_start, ulong, 0444);
+static ulong op9_ddr_size;
+module_param(op9_ddr_size, ulong, 0444);
+
+static const struct qmi_elem_info qmi_wlanfw_host_ddr_range_s_v01_ei[] = {
+	{
+		.data_type	= QMI_UNSIGNED_8_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u64),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0,
+		.offset		= offsetof(struct qmi_wlanfw_host_ddr_range_s_v01, start),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_8_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u64),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0,
+		.offset		= offsetof(struct qmi_wlanfw_host_ddr_range_s_v01, size),
+	},
+	{
+		.data_type	= QMI_EOTI,
+		.array_type	= NO_ARRAY,
+		.tlv_type	= QMI_COMMON_TLV_TYPE,
+	},
+};
 
 static const struct qmi_elem_info qmi_wlanfw_host_cap_req_msg_v01_ei[] = {
 	{
@@ -278,6 +306,25 @@ static const struct qmi_elem_info qmi_wlanfw_host_cap_req_msg_v01_ei[] = {
 		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
 					   mem_cfg_mode),
 	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x1F,
+		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
+					   ddr_range_valid),
+	},
+	{
+		.data_type	= QMI_STRUCT,
+		.elem_len	= 3,
+		.elem_size	= sizeof(struct qmi_wlanfw_host_ddr_range_s_v01),
+		.array_type	= STATIC_ARRAY,
+		.tlv_type	= 0x1F,
+		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
+					   ddr_range),
+		.ei_array	= qmi_wlanfw_host_ddr_range_s_v01_ei,
+	},
 	{
 		.data_type	= QMI_EOTI,
 		.array_type	= NO_ARRAY,
@@ -1731,6 +1778,14 @@ int ath11k_qmi_host_cap_send(struct ath11k_base *ab)
 	req.bdf_support_valid = 1;
 	req.bdf_support = 1;
 
+	if (ab->qcom_platform && op9_ddr_size) {
+		req.ddr_range_valid = 1;
+		req.ddr_range[0].start = op9_ddr_start;
+		req.ddr_range[0].size = op9_ddr_size;
+		ath11k_info(ab, "host ddr range 0x%lx size 0x%lx\n",
+			    op9_ddr_start, op9_ddr_size);
+	}
+
 	if (ab->hw_params.m3_fw_support) {
 		req.m3_support_valid = 1;
 		req.m3_support = 1;
diff --git a/drivers/net/wireless/ath/ath11k/qmi.h b/drivers/net/wireless/ath/ath11k/qmi.h
index 350816c81ee..519e72542f6 100644
--- a/drivers/net/wireless/ath/ath11k/qmi.h
+++ b/drivers/net/wireless/ath/ath11k/qmi.h
@@ -146,7 +146,7 @@ struct ath11k_qmi {
 	wait_queue_head_t cold_boot_waitq;
 };
 
-#define QMI_WLANFW_HOST_CAP_REQ_MSG_V01_MAX_LEN		261
+#define QMI_WLANFW_HOST_CAP_REQ_MSG_V01_MAX_LEN		313
 #define QMI_WLANFW_HOST_CAP_REQ_V01			0x0034
 #define QMI_WLANFW_HOST_CAP_RESP_MSG_V01_MAX_LEN	7
 #define QMI_WLFW_HOST_CAP_RESP_V01			0x0034
@@ -186,6 +186,12 @@ struct qmi_wlanfw_host_cap_req_msg_v01 {
 	u32 mem_bucket;
 	u8 mem_cfg_mode_valid;
 	u8 mem_cfg_mode;
+	/* BRING-UP: QCA6490 v1 wants the host IOVA window (TLV 0x1f) */
+	u8 ddr_range_valid;
+	struct qmi_wlanfw_host_ddr_range_s_v01 {
+		u64 start;
+		u64 size;
+	} ddr_range[3];
 };
 
 struct qmi_wlanfw_host_cap_resp_msg_v01 {
diff --git a/drivers/net/wireless/ath/ath11k/wmi.c b/drivers/net/wireless/ath/ath11k/wmi.c
index bbca275a828..d7239b3d934 100644
--- a/drivers/net/wireless/ath/ath11k/wmi.c
+++ b/drivers/net/wireless/ath/ath11k/wmi.c
@@ -90,6 +90,9 @@ struct wmi_tlv_mgmt_rx_parse {
 	bool frame_buf_done;
 };
 
+static bool op9_send_hw_mode;
+module_param(op9_send_hw_mode, bool, 0444);
+
 static const struct wmi_tlv_policy wmi_tlv_policies[] = {
 	[WMI_TAG_ARRAY_BYTE]
 		= { .min_len = 0 },
@@ -4488,8 +4491,12 @@ int ath11k_wmi_cmd_init(struct ath11k_base *ab)
 	init_param.hw_mode_id = wmi_ab->preferred_hw_mode;
 	init_param.mem_chunks = wmi_ab->mem_chunks;
 
-	if (ab->hw_params.single_pdev_only)
+	/* BRING-UP: QCA6490 v1 firmware may want its preferred mode, as qcacld sends */
+	if (ab->hw_params.single_pdev_only && !(ab->qcom_platform && op9_send_hw_mode))
 		init_param.hw_mode_id = WMI_HOST_HW_MODE_MAX;
+	if (ab->qcom_platform)
+		ath11k_info(ab, "wmi init hw_mode_id %u num_band_to_mac %u\n",
+			    init_param.hw_mode_id, ab->num_radios);
 
 	init_param.num_band_to_mac = ab->num_radios;
 	ath11k_fill_band_to_mac_param(ab, init_param.band_to_mac);
