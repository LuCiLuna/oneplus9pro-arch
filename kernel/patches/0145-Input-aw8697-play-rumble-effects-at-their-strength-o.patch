From 83378dd2ca452ee30132731fe5de097d68e2d564 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Fri, 6 Nov 2026 04:37:07 -0600
Subject: [PATCH] Input: aw8697: play rumble effects at their strength, on time

Every rumble played at the vendor's drive level, whatever its magnitude,
so a desktop-mode trackpad couldn't have a soft click or a faint ripple
next to firmer key presses.

Map the stronger of the two rumble magnitudes onto the continuous-mode
drive level: full scale is the vendor's level, and weaker rumbles go
down to a level a short pulse can still be felt at. Scale the overdrive
with it: overdrive spins the motor up at the start of each pulse, and at
the full value a short soft tick felt as strong as a full one. A level
that changes while the motor runs is written straight away.

Starting the motor rewrote all of the continuous-mode setup over I2C,
which took 4.5 ms of feedbackd's 7 ms key press: Squeekboard's keys ran
for 2.6 ms and, once played at their 0.2 strength, mostly weren't felt.
The setup never changes between pulses, so write it once with the rest
of the initialisation, and start with the mode, the level if it changed,
and GO. Key presses now run 6.3-6.8 ms.

A rumble that starts and ends before the work runs, while the motor is
still braking from the last one, now plays a 12 ms pulse instead of
being dropped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/misc/aw8697.c | 110 +++++++++++++++++++++++++++++++-----
 1 file changed, 96 insertions(+), 14 deletions(-)

diff --git a/drivers/input/misc/aw8697.c b/drivers/input/misc/aw8697.c
index 03ef71fc8e2..b1caa90430f 100644
--- a/drivers/input/misc/aw8697.c
+++ b/drivers/input/misc/aw8697.c
@@ -72,6 +72,12 @@
 #define AW8697_CONT_ZC_THR		0x0ff1
 #define AW8697_CONT_NUM_BRK		3
 
+/* The weakest drive level that a short pulse can still be felt at */
+#define AW8697_DRV_LVL_MIN		20
+
+/* A rumble that started and ended before the work ran still gets this long a pulse */
+#define AW8697_MIN_PULSE_US		12000
+
 struct aw8697 {
 	struct device *dev;
 	struct regmap *regmap;
@@ -79,7 +85,10 @@ struct aw8697 {
 	struct input_dev *input;
 	struct work_struct play_work;
 	bool playing;
+	bool pending;	/* a rumble started since the work last ran */
 	bool active;
+	unsigned int level;	/* drive level asked for, 1..AW8697_DRV_LVL */
+	unsigned int set_level;	/* drive level the chip runs at */
 };
 
 static const struct regmap_config aw8697_regmap_config = {
@@ -89,6 +98,8 @@ static const struct regmap_config aw8697_regmap_config = {
 	.cache_type = REGCACHE_NONE,
 };
 
+static int aw8697_setup_cont(struct aw8697 *hap);
+
 static int aw8697_init(struct aw8697 *hap)
 {
 	const struct reg_sequence seq[] = {
@@ -123,10 +134,34 @@ static int aw8697_init(struct aw8697 *hap)
 	if (ret)
 		return ret;
 
-	return regmap_set_bits(hap->regmap, AW8697_REG_ADCTEST, AW8697_ADCTEST_VBAT_HW_COMP);
+	ret = regmap_set_bits(hap->regmap, AW8697_REG_ADCTEST, AW8697_ADCTEST_VBAT_HW_COMP);
+	if (ret)
+		return ret;
+
+	return aw8697_setup_cont(hap);
 }
 
-static int aw8697_start(struct aw8697 *hap)
+/* Overdrive spins the motor up at the start of each pulse: scale it with the level, or a
+ * short soft tick would be mostly overdrive and feel as strong as a full one. */
+static int aw8697_set_level(struct aw8697 *hap, unsigned int level)
+{
+	int ret;
+
+	ret = regmap_write(hap->regmap, AW8697_REG_DRV_LVL, level);
+	if (!ret)
+		ret = regmap_write(hap->regmap, AW8697_REG_DRV_LVL_OV,
+				   DIV_ROUND_UP(level * AW8697_DRV_LVL_OV, AW8697_DRV_LVL));
+	if (!ret)
+		hap->set_level = level;
+	return ret;
+}
+
+/*
+ * The continuous-mode settings never change between pulses, so they are written once with
+ * the rest of the setup. Writing them for every pulse took 4.5 ms over I2C, most of
+ * feedbackd's 7 ms key press.
+ */
+static int aw8697_setup_cont(struct aw8697 *hap)
 {
 	u32 f_pre = 1000000000 / (AW8697_F0_DECIHZ * AW8697_F0_COEFF);
 	const struct reg_sequence seq[] = {
@@ -143,17 +178,9 @@ static int aw8697_start(struct aw8697 *hap)
 		{ AW8697_REG_BEMF_VTHL_H, 0x03 },
 		{ AW8697_REG_BEMF_VTHL_L, 0xf8 },
 		{ AW8697_REG_TIME_NZC, 0x23 },
-		{ AW8697_REG_DRV_LVL, AW8697_DRV_LVL },
-		{ AW8697_REG_DRV_LVL_OV, AW8697_DRV_LVL_OV },
 	};
 	int ret;
 
-	ret = regmap_update_bits(hap->regmap, AW8697_REG_SYSCTRL,
-				 AW8697_SYSCTRL_PLAY_MODE | AW8697_SYSCTRL_BOOST |
-				 AW8697_SYSCTRL_STANDBY, AW8697_SYSCTRL_PLAY_CONT);
-	if (ret)
-		return ret;
-
 	ret = regmap_set_bits(hap->regmap, AW8697_REG_DATCTRL, AW8697_DATCTRL_LPF);
 	if (ret)
 		return ret;
@@ -167,6 +194,27 @@ static int aw8697_start(struct aw8697 *hap)
 	if (ret)
 		return ret;
 
+	hap->set_level = 0;	/* written by the next start */
+	return 0;
+}
+
+static int aw8697_start(struct aw8697 *hap)
+{
+	unsigned int level = READ_ONCE(hap->level);
+	int ret;
+
+	ret = regmap_update_bits(hap->regmap, AW8697_REG_SYSCTRL,
+				 AW8697_SYSCTRL_PLAY_MODE | AW8697_SYSCTRL_BOOST |
+				 AW8697_SYSCTRL_STANDBY, AW8697_SYSCTRL_PLAY_CONT);
+	if (ret)
+		return ret;
+
+	if (level != hap->set_level) {
+		ret = aw8697_set_level(hap, level);
+		if (ret)
+			return ret;
+	}
+
 	return regmap_write(hap->regmap, AW8697_REG_GO, 1);
 }
 
@@ -195,10 +243,30 @@ static void aw8697_stop(struct aw8697 *hap)
 static void aw8697_play_work(struct work_struct *work)
 {
 	struct aw8697 *hap = container_of(work, struct aw8697, play_work);
+	bool pending = xchg(&hap->pending, false);
 	bool playing = READ_ONCE(hap->playing);
+	unsigned int level = READ_ONCE(hap->level);
+
+	/*
+	 * Stopping waits for the motor to brake, and a short rumble that arrives meanwhile
+	 * can start and end before this runs again (feedbackd's 12 ms key release, right
+	 * after the press). Play it briefly instead of dropping it.
+	 */
+	if (pending && !playing && !hap->active) {
+		if (aw8697_start(hap)) {
+			dev_err(hap->dev, "failed to start\n");
+			return;
+		}
+		usleep_range(AW8697_MIN_PULSE_US, AW8697_MIN_PULSE_US + 1000);
+		aw8697_stop(hap);
+		return;
+	}
 
-	if (playing == hap->active)
+	if (playing == hap->active) {
+		if (playing && level != hap->set_level)
+			aw8697_set_level(hap, level);
 		return;
+	}
 
 	if (playing) {
 		int ret = aw8697_start(hap);
@@ -217,9 +285,20 @@ static void aw8697_play_work(struct work_struct *work)
 static int aw8697_play(struct input_dev *input, void *data, struct ff_effect *effect)
 {
 	struct aw8697 *hap = input_get_drvdata(input);
-
-	WRITE_ONCE(hap->playing, effect->u.rumble.strong_magnitude ||
-				 effect->u.rumble.weak_magnitude);
+	unsigned int mag = max(effect->u.rumble.strong_magnitude,
+			       effect->u.rumble.weak_magnitude);
+
+	/*
+	 * Full scale is the vendor's drive level; weaker rumbles are softer, down to the
+	 * weakest level a short pulse can be felt at. Below it, feedbackd's key press (0.2)
+	 * was mostly not felt at all.
+	 */
+	if (mag) {
+		WRITE_ONCE(hap->level, AW8697_DRV_LVL_MIN +
+			   DIV_ROUND_UP(mag * (AW8697_DRV_LVL - AW8697_DRV_LVL_MIN), 0xffff));
+		WRITE_ONCE(hap->pending, true);
+	}
+	WRITE_ONCE(hap->playing, mag != 0);
 	schedule_work(&hap->play_work);
 
 	return 0;
@@ -231,6 +310,7 @@ static void aw8697_close(struct input_dev *input)
 
 	WRITE_ONCE(hap->playing, false);
 	cancel_work_sync(&hap->play_work);
+	WRITE_ONCE(hap->pending, false);
 	aw8697_play_work(&hap->play_work);
 }
 
@@ -246,6 +326,7 @@ static int aw8697_probe(struct i2c_client *client)
 		return -ENOMEM;
 
 	hap->dev = dev;
+	hap->level = AW8697_DRV_LVL;
 	INIT_WORK(&hap->play_work, aw8697_play_work);
 	i2c_set_clientdata(client, hap);
 
@@ -293,6 +374,7 @@ static int aw8697_suspend(struct device *dev)
 
 	WRITE_ONCE(hap->playing, false);
 	cancel_work_sync(&hap->play_work);
+	WRITE_ONCE(hap->pending, false);
 	aw8697_play_work(&hap->play_work);
 
 	return 0;
-- 
2.56.0

