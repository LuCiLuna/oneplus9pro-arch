+static const s64 gc02m1b_link_freqs[] = {
+	GC02M1B_LINK_FREQ,
+};
+
+static const char * const gc02m1b_test_pattern_menu[] = {
+	"Disabled",
+	"Test Pattern",
+};
+
+static int gc02m1b_set_gain(struct gc02m1b *sensor, u32 gain)
+{
+	unsigned int step = ARRAY_SIZE(gc02m1b_again) - 1;
+	u32 dgain;
+	int ret = 0;
+
+	while (step && gc02m1b_again[step] > gain)
+		step--;
+	dgain = gain * 1024 / gc02m1b_again[step];
+
+	cci_write(sensor->regmap, GC02M1B_REG_PAGE, 0, &ret);
+	cci_write(sensor->regmap, GC02M1B_REG_AGAIN, step, &ret);
+	cci_write(sensor->regmap, GC02M1B_REG_DGAIN_H, (dgain >> 8) & 0x3f, &ret);
+	cci_write(sensor->regmap, GC02M1B_REG_DGAIN_L, dgain & 0xff, &ret);
+
+	return ret;
+}
+
+static int gc02m1b_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc02m1b *sensor = container_of(ctrl->handler, struct gc02m1b,
+					      ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max = GC02M1B_HEIGHT + ctrl->val - GC02M1B_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(sensor->exposure,
+					       sensor->exposure->minimum, max,
+					       sensor->exposure->step,
+					       min(sensor->exposure->default_value,
+						   max));
+		if (ret)
+			return ret;
+	}
+
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = gc02m1b_set_gain(sensor, ctrl->val);
+		break;
+	case V4L2_CID_EXPOSURE:
+		cci_write(sensor->regmap, GC02M1B_REG_PAGE, 0, &ret);
+		cci_write(sensor->regmap, GC02M1B_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(sensor->regmap, GC02M1B_REG_PAGE, 0, &ret);
+		cci_write(sensor->regmap, GC02M1B_REG_VTS,
+			  GC02M1B_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(sensor->regmap, GC02M1B_REG_PAGE, 1, &ret);
+		cci_write(sensor->regmap, GC02M1B_REG_TEST_PATTERN,
+			  ctrl->val ? GC02M1B_TEST_PATTERN_ON :
+				      GC02M1B_TEST_PATTERN_OFF, &ret);
+		cci_write(sensor->regmap, GC02M1B_REG_PAGE, 0, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc02m1b_ctrl_ops = {
+	.s_ctrl = gc02m1b_set_ctrl,
+};
+
+static int gc02m1b_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_Y10_1X10;
+
+	return 0;
+}
+
+static int gc02m1b_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MEDIA_BUS_FMT_Y10_1X10)
+		return -EINVAL;
+
+	fse->min_width = GC02M1B_WIDTH;
+	fse->max_width = GC02M1B_WIDTH;
+	fse->min_height = GC02M1B_HEIGHT;
+	fse->max_height = GC02M1B_HEIGHT;
+
+	return 0;
+}
+
+static int gc02m1b_set_pad_format(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_format *fmt)
+{
+	fmt->format.code = MEDIA_BUS_FMT_Y10_1X10;
+	fmt->format.width = GC02M1B_WIDTH;
+	fmt->format.height = GC02M1B_HEIGHT;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+
+	return 0;
+}
+
+static int gc02m1b_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = GC02M1B_WIDTH;
+		sel->r.height = GC02M1B_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int gc02m1b_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+	};
+
+	return gc02m1b_set_pad_format(sd, state, &fmt);
+}
+
+static int gc02m1b_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct gc02m1b *sensor = to_gc02m1b(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(sensor->regmap, gc02m1b_init_regs,
+				  ARRAY_SIZE(gc02m1b_init_regs), NULL);
+	if (ret)
+		goto err_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
+	if (ret)
+		goto err_put;
+
+	cci_write(sensor->regmap, GC02M1B_REG_PAGE, 0, &ret);
+	cci_write(sensor->regmap, GC02M1B_REG_STREAM, GC02M1B_STREAM_ON, &ret);
+	if (ret)
+		goto err_put;
+
+	return 0;
+
+err_put:
+	dev_err(sensor->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static int gc02m1b_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct gc02m1b *sensor = to_gc02m1b(sd);
+	int ret = 0;
+
+	cci_write(sensor->regmap, GC02M1B_REG_PAGE, 0, &ret);
+	cci_write(sensor->regmap, GC02M1B_REG_STREAM, GC02M1B_STREAM_OFF, &ret);
+	if (ret)
+		dev_err(sensor->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put(sensor->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops gc02m1b_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops gc02m1b_pad_ops = {
+	.enum_mbus_code = gc02m1b_enum_mbus_code,
+	.enum_frame_size = gc02m1b_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc02m1b_set_pad_format,
+	.get_selection = gc02m1b_get_selection,
+	.enable_streams = gc02m1b_enable_streams,
+	.disable_streams = gc02m1b_disable_streams,
+};
+
+static const struct v4l2_subdev_ops gc02m1b_subdev_ops = {
+	.video = &gc02m1b_video_ops,
+	.pad = &gc02m1b_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc02m1b_internal_ops = {
+	.init_state = gc02m1b_init_state,
+};
+
+static int gc02m1b_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc02m1b *sensor = to_gc02m1b(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
+				    sensor->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(sensor->clk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(sensor->supplies),
+				       sensor->supplies);
+		return ret;
+	}
+
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	return 0;
+}
+
+static int gc02m1b_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc02m1b *sensor = to_gc02m1b(sd);
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	clk_disable_unprepare(sensor->clk);
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+
+	return 0;
+}
+
+static int gc02m1b_init_controls(struct gc02m1b *sensor)
+{
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, &gc02m1b_ctrl_ops,
+				      V4L2_CID_LINK_FREQ, 0, 0,
+				      gc02m1b_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &gc02m1b_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  GC02M1B_PIXEL_RATE, GC02M1B_PIXEL_RATE, 1,
+			  GC02M1B_PIXEL_RATE);
+
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &gc02m1b_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   GC02M1B_VTS - GC02M1B_HEIGHT,
+					   GC02M1B_VTS_MAX - GC02M1B_HEIGHT, 1,
+					   GC02M1B_VTS - GC02M1B_HEIGHT);
+
+	ctrl = v4l2_ctrl_new_std(hdl, &gc02m1b_ctrl_ops, V4L2_CID_HBLANK,
+				 GC02M1B_LLP - GC02M1B_WIDTH,
+				 GC02M1B_LLP - GC02M1B_WIDTH, 1,
+				 GC02M1B_LLP - GC02M1B_WIDTH);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &gc02m1b_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     GC02M1B_EXPOSURE_MIN,
+					     GC02M1B_VTS - GC02M1B_EXPOSURE_MARGIN,
+					     1, 1000);
+
+	v4l2_ctrl_new_std(hdl, &gc02m1b_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  GC02M1B_GAIN_MIN, GC02M1B_GAIN_MAX, 1,
+			  GC02M1B_GAIN_MIN);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &gc02m1b_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(gc02m1b_test_pattern_menu) - 1,
+				     0, 0, gc02m1b_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &gc02m1b_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int gc02m1b_parse_endpoint(struct gc02m1b *sensor)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *fwnode;
+	unsigned long bitmap;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!fwnode)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 1) {
+		ret = dev_err_probe(sensor->dev, -EINVAL,
+				    "need 1 data lane, got %u\n",
+				    ep.bus.mipi_csi2.num_data_lanes);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(sensor->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       gc02m1b_link_freqs,
+				       ARRAY_SIZE(gc02m1b_link_freqs), &bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int gc02m1b_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc02m1b *sensor;
+	u64 id;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->dev = dev;
+
+	ret = gc02m1b_parse_endpoint(sensor);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	sensor->clk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->clk))
+		return dev_err_probe(dev, PTR_ERR(sensor->clk),
+				     "failed to get clock\n");
+	if (clk_get_rate(sensor->clk) != GC02M1B_EXT_CLK)
+		return dev_err_probe(dev, -EINVAL, "unsupported clock rate %lu\n",
+				     clk_get_rate(sensor->clk));
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(gc02m1b_supply_names); i++)
+		sensor->supplies[i].supply = gc02m1b_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sensor->supplies),
+				      sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	sensor->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(sensor->regmap))
+		return PTR_ERR(sensor->regmap);
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &gc02m1b_subdev_ops);
+
+	ret = gc02m1b_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = cci_read(sensor->regmap, GC02M1B_REG_CHIP_ID, &id, NULL);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to read chip id\n");
+		goto err_power_off;
+	}
+	if (id != GC02M1B_CHIP_ID) {
+		ret = dev_err_probe(dev, -ENODEV, "unexpected chip id 0x%04llx\n",
+				    id);
+		goto err_power_off;
+	}
+
+	ret = gc02m1b_init_controls(sensor);
+	if (ret)
+		goto err_power_off;
+
+	sensor->sd.internal_ops = &gc02m1b_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_ctrls;
+
+	sensor->sd.state_lock = sensor->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto err_pm;
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+err_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+err_power_off:
+	gc02m1b_power_off(dev);
+
+	return ret;
+}
+
+static void gc02m1b_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		gc02m1b_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(gc02m1b_pm_ops, gc02m1b_power_off,
+				 gc02m1b_power_on, NULL);
+
+static const struct of_device_id gc02m1b_of_match[] = {
+	{ .compatible = "galaxycore,gc02m1b" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gc02m1b_of_match);
+
+static struct i2c_driver gc02m1b_driver = {
+	.driver = {
+		.name = "gc02m1b",
+		.of_match_table = gc02m1b_of_match,
+		.pm = pm_ptr(&gc02m1b_pm_ops),
+	},
+	.probe = gc02m1b_probe,
+	.remove = gc02m1b_remove,
+};
+module_i2c_driver(gc02m1b_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC02M1B monochrome image sensor driver");
+MODULE_LICENSE("GPL");
