+			regulator-always-on;
 		};
 	};
 };
@@ -708,20 +752,41 @@ &pcie0 {
 	pinctrl-0 = <&pcie0_default_state>;//, <&pcie0_sleep_state>;
 	pinctrl-names = "default";//, "sleep";
 
-	//power-domains = <&qca6490_pd>;
-
-	perst-gpios = <&tlmm 94 GPIO_ACTIVE_HIGH>;
