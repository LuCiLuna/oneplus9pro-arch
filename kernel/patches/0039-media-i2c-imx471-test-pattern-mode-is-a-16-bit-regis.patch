From 64208efc8b4c8e72dfb31310180ed26f700dacba Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 11:06:19 +0000
Subject: [PATCH 039/110] media: i2c: imx471: test pattern mode is a 16-bit
 register

TEST_PATTERN_MODE spans 0x0600-0x0601; writing the menu index to 0x0600
alone sets the high byte and selects no valid pattern.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/imx471.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/media/i2c/imx471.c b/drivers/media/i2c/imx471.c
index 1e05db6a70d..c4e98843e27 100644
--- a/drivers/media/i2c/imx471.c
+++ b/drivers/media/i2c/imx471.c
@@ -57,7 +57,7 @@
 #define IMX471_REG_ORIENTATION			CCI_REG8(0x0101)
 
 /* Test Pattern Control */
-#define IMX471_REG_TEST_PATTERN			CCI_REG8(0x0600)
+#define IMX471_REG_TEST_PATTERN			CCI_REG16(0x0600)
 
 /* default link frequency and external clock */
 #define IMX471_LINK_FREQ_DEFAULT		200000000LL
