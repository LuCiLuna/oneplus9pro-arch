From 486723e556aed64bfde42be9f2d2f04cb22256c6 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 10:49:09 +0000
Subject: [PATCH 033/114] HACK: mfd: qcom-pm8008: allow boards without an
 interrupt line

The OnePlus 9 Pro camera PM8008s have no interrupt wired to the SoC. Register
only the regulators in that case.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mfd/qcom-pm8008.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/mfd/qcom-pm8008.c b/drivers/mfd/qcom-pm8008.c
index 60204cc9a2d..b60709e578b 100644
--- a/drivers/mfd/qcom-pm8008.c
+++ b/drivers/mfd/qcom-pm8008.c
@@ -231,6 +231,16 @@ static int pm8008_probe(struct i2c_client *client)
 	 */
 	usleep_range(1000, 2000);
 
+	/*
+	 * HACK: some boards (OnePlus 9 Pro) do not wire the interrupt; the
+	 * regulators work without it.
+	 */
+	if (client->irq <= 0) {
+		dev_warn(dev, "no interrupt, registering regulators only\n");
+		return devm_mfd_add_devices(dev, PLATFORM_DEVID_AUTO, pm8008_cells, 1,
+					    NULL, 0, NULL);
+	}
+
 	name = devm_kasprintf(dev, GFP_KERNEL, "%pOF-internal", dev->of_node);
 	if (!name)
 		return -ENOMEM;
