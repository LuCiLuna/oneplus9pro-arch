From b8cd71bf3c17851d07ec47e84a95b2d420eb96fd Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:52:53 +0000
Subject: [PATCH 062/114] WIP: arm64: dts: qcom: sm8350-oneplus-lemonadep: mono
 camera, rear module rotations

GC02M1B on CCI0 bus 1 and CSIPHY3 (one lane): MCLK4, reset GPIO 117,
AVDD switched from BOB by GPIO 66. The mono and telephoto modules are
mounted upside down relative to the main one: rotation 270.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8350-oneplus-lemonadep.dts     | 74 ++++++++++++++++++-
 1 file changed, 73 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index 3395e5688f4..280e9d2adf0 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -60,6 +60,19 @@ vreg_cam_tele_avdd: regulator-cam-tele-avdd {
 		pinctrl-names = "default";
 	};
 
+	/* Mono camera analog supply, switched from BOB by GPIO 66 */
+	vreg_cam_mono_avdd: regulator-cam-mono-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_mono_avdd";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 66 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-0 = <&cam_mono_avdd_en>;
+		pinctrl-names = "default";
+	};
+
 	vreg_cam_main_avdd: regulator-cam-main-avdd {
 		compatible = "regulator-fixed";
 		regulator-name = "cam_main_avdd";
@@ -319,6 +332,15 @@ csiphy0_ep: endpoint {
 			};
 		};
 
+		/* Mono camera on CSIPHY3, one lane */
+		port@3 {
+			csiphy3_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0>;
+				remote-endpoint = <&gc02m1b_ep>;
+			};
+		};
+
 		/* Front camera on CSIPHY5 */
 		port@5 {
 			csiphy5_ep: endpoint {
@@ -409,6 +431,35 @@ imx766_ep: endpoint {
 		};
 	};
 
+	/* Mono camera, Holitech GC02M1B */
+	camera@37 {
+		compatible = "galaxycore,gc02m1b";
+		reg = <0x37>;
+
+		clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		reset-gpios = <&tlmm 117 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk4_active>, <&cam_mono_reset>;
+		pinctrl-names = "default";
+
+		dovdd-supply = <&vreg_l5i>;
+		avdd-supply = <&vreg_cam_mono_avdd>;
+
+		rotation = <270>;
+		orientation = <1>;
+
+		port {
+			gc02m1b_ep: endpoint {
+				data-lanes = <1>;
+				link-frequencies = /bits/ 64 <336000000>;
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
+	};
+
 	/* Ultrawide camera module calibration */
 	eeprom@51 {
 		compatible = "atmel,24c128";
@@ -441,7 +492,7 @@ camera@36 {
 		avdd-supply = <&vreg_cam_tele_avdd>;
 		dvdd-supply = <&vreg_l1i>;
 
-		rotation = <90>;
+		rotation = <270>;
 		orientation = <1>;
 
 		port {
@@ -760,6 +811,27 @@ cam_tele_avdd_en: cam-tele-avdd-en-state {
 		bias-disable;
 	};
 
+	cam_mclk4_active: cam-mclk4-active-state {
+		pins = "gpio104";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mono_reset: cam-mono-reset-state {
+		pins = "gpio117";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mono_avdd_en: cam-mono-avdd-en-state {
+		pins = "gpio66";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	cam_mclk3_active: cam-mclk3-active-state {
 		pins = "gpio103";
 		function = "cam_mclk";
