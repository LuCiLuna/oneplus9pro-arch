From f9b8d70a5ed8580908e222e7805bdb6c9ce9e010 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 19:01:10 +0000
Subject: [PATCH 057/110] fixup! media: i2c: add Sony IMX789 driver

Drop the H+V flip the stock init table applies (it turned the image
upside down and moved the Bayer phase to BGGR while RGGB was reported)
and expose HFLIP/VFLIP with the matching Bayer codes instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/imx789.c | 46 ++++++++++++++++++++++++++++++++++----
 1 file changed, 42 insertions(+), 4 deletions(-)

diff --git a/drivers/media/i2c/imx789.c b/drivers/media/i2c/imx789.c
index b80994452b2..6d5e63309b0 100644
--- a/drivers/media/i2c/imx789.c
+++ b/drivers/media/i2c/imx789.c
@@ -44,6 +44,8 @@
 
 #define IMX789_REG_TEST_PATTERN		CCI_REG16(0x0600)
 
+#define IMX789_REG_ORIENTATION		CCI_REG8(0x0101)
+
 #define IMX789_EXT_CLK			19200000
 /* C-PHY: 960 Msps per trio, reported as half the symbol rate */
 #define IMX789_LINK_FREQ		480000000LL
@@ -84,6 +86,8 @@ struct imx789 {
 	struct v4l2_ctrl *vblank;
 	struct v4l2_ctrl *hblank;
 	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
 };
 
 #define to_imx789(_sd) container_of(_sd, struct imx789, sd)
@@ -553,7 +557,6 @@ static const struct cci_reg_sequence imx789_init_regs[] = {
 	{ CCI_REG8(0xee15), 0x2c },
 	{ CCI_REG8(0xee16), 0x01 },
 	{ CCI_REG8(0xee17), 0x2c },
-	{ CCI_REG8(0x0101), 0x03 },
 	{ CCI_REG8(0x0106), 0x01 },
 	{ CCI_REG8(0x3075), 0x30 },
 	{ CCI_REG8(0x3071), 0x30 },
@@ -761,6 +764,19 @@ static const s64 imx789_link_freqs[] = {
 	IMX789_LINK_FREQ,
 };
 
+/* Bayer order by flip: none, h, v, h + v */
+static const u32 imx789_bayer_codes[] = {
+	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+static u32 imx789_code(struct imx789 *sensor)
+{
+	return imx789_bayer_codes[sensor->vflip->val << 1 | sensor->hflip->val];
+}
+
 static const char * const imx789_test_pattern_menu[] = {
 	"Disabled",
 	"Solid Colour",
@@ -811,6 +827,12 @@ static int imx789_set_ctrl(struct v4l2_ctrl *ctrl)
 		ret = cci_write(sensor->regmap, IMX789_REG_FLL,
 				fmt->height + ctrl->val, NULL);
 		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(sensor->regmap, IMX789_REG_ORIENTATION,
+				sensor->hflip->val | sensor->vflip->val << 1,
+				NULL);
+		break;
 	case V4L2_CID_TEST_PATTERN:
 		ret = cci_write(sensor->regmap, IMX789_REG_TEST_PATTERN,
 				ctrl->val, NULL);
@@ -836,7 +858,7 @@ static int imx789_enum_mbus_code(struct v4l2_subdev *sd,
 	if (code->index)
 		return -EINVAL;
 
-	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	code->code = imx789_code(to_imx789(sd));
 
 	return 0;
 }
@@ -846,7 +868,7 @@ static int imx789_enum_frame_size(struct v4l2_subdev *sd,
 				  struct v4l2_subdev_frame_size_enum *fse)
 {
 	if (fse->index >= ARRAY_SIZE(imx789_modes) ||
-	    fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+	    fse->code != imx789_code(to_imx789(sd)))
 		return -EINVAL;
 
 	fse->min_width = imx789_modes[fse->index].width;
@@ -869,7 +891,7 @@ static int imx789_set_pad_format(struct v4l2_subdev *sd,
 				      width, height, fmt->format.width,
 				      fmt->format.height);
 
-	fmt->format.code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->format.code = imx789_code(sensor);
 	fmt->format.width = mode->width;
 	fmt->format.height = mode->height;
 	fmt->format.field = V4L2_FIELD_NONE;
@@ -965,6 +987,9 @@ static int imx789_enable_streams(struct v4l2_subdev *sd,
 	if (ret)
 		goto err_put;
 
+	__v4l2_ctrl_grab(sensor->hflip, true);
+	__v4l2_ctrl_grab(sensor->vflip, true);
+
 	return 0;
 
 err_put:
@@ -986,6 +1011,9 @@ static int imx789_disable_streams(struct v4l2_subdev *sd,
 	if (ret)
 		dev_err(sensor->dev, "failed to stop streaming: %d\n", ret);
 
+	__v4l2_ctrl_grab(sensor->hflip, false);
+	__v4l2_ctrl_grab(sensor->vflip, false);
+
 	pm_runtime_put(sensor->dev);
 
 	return 0;
@@ -1111,6 +1139,16 @@ static int imx789_init_controls(struct imx789 *sensor)
 				     ARRAY_SIZE(imx789_test_pattern_menu) - 1,
 				     0, 0, imx789_test_pattern_menu);
 
+	sensor->hflip = v4l2_ctrl_new_std(hdl, &imx789_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (sensor->hflip)
+		sensor->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	sensor->vflip = v4l2_ctrl_new_std(hdl, &imx789_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (sensor->vflip)
+		sensor->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
 	v4l2_ctrl_new_fwnode_properties(hdl, &imx789_ctrl_ops, &props);
 
 	if (hdl->error) {
