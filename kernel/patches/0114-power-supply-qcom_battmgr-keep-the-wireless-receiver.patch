From de50a086ae583d9c3ab40f9047ea71015f54a9c7 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Mon, 2 Nov 2026 03:33:04 -0600
Subject: [PATCH 114/114] power: supply: qcom_battmgr: keep the wireless
 receiver off while on USB

USB and the wireless receiver appear to share an input. If both are powered,
the firmware loses track of them: USB keeps dropping out, and wireless is
left charging while reported offline, so the charging limits don't run.

The bootloader leaves the receiver off if USB is attached at boot, and
nothing on Linux turned it back on, so wireless charging didn't work for
the rest of that boot. Drive the enable pin from the charging worker, on
when USB is absent and off while it's attached.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8350-oneplus-lemonadep.dts     |  1 +
 drivers/power/supply/qcom_battmgr.c           | 29 ++++++++++++++++++-
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index 59125ccfaa8..26a1aa8a5c8 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -905,6 +905,7 @@ &pmic_glink {
 	oplus,fuel-gauge = <&bq27541>;
 	oplus,otg-boost-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
 	oplus,otg-wrx-en-gpios = <&pm8350c_gpios 6 GPIO_ACTIVE_HIGH>;
+	oplus,wireless-rx-en-gpios = <&pm8350c_gpios 2 GPIO_ACTIVE_LOW>;
 	pinctrl-0 = <&otg_boost_default>, <&otg_wrx_en_default>;
 	pinctrl-names = "default";
 };
diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 329203cb600..8024d7f27d2 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -361,6 +361,8 @@ struct qcom_battmgr {
 	/* OnePlus OTG: external VBUS boost, switched on at the firmware's request */
 	struct gpio_desc *otg_boost;
 	struct gpio_desc *otg_wrx_en;
+	struct gpio_desc *wls_rx_en;
+	int wls_rx_on;
 	struct work_struct otg_work;
 	bool otg_on;
 
@@ -1861,6 +1863,21 @@ static void qcom_battmgr_chg_climb_icl(struct qcom_battmgr *battmgr, u32 vbus, u
 	*icl = steps[step];
 }
 
+/*
+ * USB and the wireless receiver appear to share an input: with both powered the
+ * firmware loses track of them: USB keeps dropping out, and wireless is left
+ * charging while reported offline. Like the bootloader, which leaves the
+ * receiver off if USB was attached at boot, only enable it without USB.
+ */
+static void qcom_battmgr_chg_set_wls_rx(struct qcom_battmgr *battmgr, bool on)
+{
+	if (!battmgr->wls_rx_en || battmgr->wls_rx_on == on)
+		return;
+
+	if (!gpiod_direction_output(battmgr->wls_rx_en, on))
+		battmgr->wls_rx_on = on;
+}
+
 static void qcom_battmgr_chg_worker(struct work_struct *work)
 {
 	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work), struct qcom_battmgr,
@@ -1896,12 +1913,15 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 	mutex_lock(&battmgr->lock);
 
 	detach = xchg(&battmgr->chg_reset, false);
-	if (detach)
+	if (detach) {
+		qcom_battmgr_chg_set_wls_rx(battmgr, true);
 		goto reset;
+	}
 
 	ret = qcom_battmgr_chg_get(battmgr, USB_ONLINE, &online);
 	if (ret)
 		goto out;
+	qcom_battmgr_chg_set_wls_rx(battmgr, !online);
 	if (!online) {
 		ret = qcom_battmgr_request_property(battmgr, BATTMGR_WLS_PROPERTY_GET,
 						    WLS_ONLINE, 0);
@@ -2307,6 +2327,13 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 		return dev_err_probe(dev, PTR_ERR(battmgr->otg_wrx_en),
 				     "failed to get OTG wireless RX enable GPIO\n");
 
+	/* stays as the bootloader left it until the firmware says whether USB is attached */
+	battmgr->wls_rx_on = -1;
+	battmgr->wls_rx_en = devm_gpiod_get_optional(dev, "oplus,wireless-rx-en", GPIOD_ASIS);
+	if (IS_ERR(battmgr->wls_rx_en))
+		return dev_err_probe(dev, PTR_ERR(battmgr->wls_rx_en),
+				     "failed to get wireless RX enable GPIO\n");
+
 	if (battmgr->otg_boost) {
 		ret = devm_add_action_or_reset(dev, qcom_battmgr_otg_off, battmgr);
 		if (ret)
