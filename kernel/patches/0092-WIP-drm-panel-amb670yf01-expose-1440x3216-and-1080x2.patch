+#define AMB670YF01_MODE(w, h, hfp, hbp, vfp, vs, vbp, hz) {		\
+	.clock = ((w) + (hfp) + 8 + (hbp)) *				\
+		 ((h) + (vfp) + (vs) + (vbp)) * (hz) / 1000,		\
+	.hdisplay = (w),						\
+	.hsync_start = (w) + (hfp),					\
+	.hsync_end = (w) + (hfp) + 8,					\
+	.htotal = (w) + (hfp) + 8 + (hbp),				\
+	.vdisplay = (h),						\
+	.vsync_start = (h) + (vfp),					\
+	.vsync_end = (h) + (vfp) + (vs),				\
+	.vtotal = (h) + (vfp) + (vs) + (vbp),				\
+	.width_mm = 71,							\
+	.height_mm = 159,						\
+	.type = DRM_MODE_TYPE_DRIVER,					\
+}
 
