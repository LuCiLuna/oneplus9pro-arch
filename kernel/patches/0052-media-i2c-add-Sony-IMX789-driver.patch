From 281de003fdd8cd3d340c889c554b563b13bbc0ac Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 18:53:04 +0000
Subject: [PATCH 052/114] media: i2c: add Sony IMX789 driver

Sony IMX789 is a 48 MP sensor with a MIPI C-PHY (3 trio) interface,
used as the main camera of the OnePlus 9 Pro. The init and mode
settings come from the phone's camera module data; for now the driver
offers the 2x2 binned 4000x3008 mode at 30 fps.

Drop the H+V flip the stock init table applies (it turned the image
upside down and moved the Bayer phase to BGGR while RGGB was reported)
and expose HFLIP/VFLIP with the matching Bayer codes instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx789.c | 1338 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1350 insertions(+)
 create mode 100644 drivers/media/i2c/imx789.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5c52007f9cb..d851dfd3616 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -299,6 +299,17 @@ config VIDEO_IMX471
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx471.
 
+config VIDEO_IMX789
+	tristate "Sony IMX789 sensor support"
+	depends on GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX789 camera, a 48 MP sensor with a MIPI C-PHY interface.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx789.
+
 config VIDEO_IMX678
 	tristate "Sony IMX678 sensor support"
 	depends on GPIOLIB
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index d04bd572455..e00debccb9d 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -63,6 +63,7 @@ obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IMX678) += imx678.o
 obj-$(CONFIG_VIDEO_IMX471) += imx471.o
+obj-$(CONFIG_VIDEO_IMX789) += imx789.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
diff --git a/drivers/media/i2c/imx789.c b/drivers/media/i2c/imx789.c
new file mode 100644
index 00000000000..6d5e63309b0
--- /dev/null
+++ b/drivers/media/i2c/imx789.c
@@ -0,0 +1,1338 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sony IMX789 image sensor driver
+ *
+ * Register settings come from the OnePlus 9 Pro camera module data
+ * (com.qti.sensormodule.lemonadep.semco_imx789.bin). The sensor talks
+ * MIPI C-PHY over three trios.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define IMX789_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX789_MODE_STANDBY		0x00
+#define IMX789_MODE_STREAMING		0x01
+
+#define IMX789_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX789_CHIP_ID			0x0789
+
+#define IMX789_REG_FLL			CCI_REG16(0x0340)
+#define IMX789_FLL_MAX			0xffff
+
+#define IMX789_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX789_EXPOSURE_MIN		8
+#define IMX789_EXPOSURE_MARGIN		48
+
+/* Sony gain code: gain = 1024 / (1024 - code), 16x at 960 */
+#define IMX789_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define IMX789_ANA_GAIN_MAX		960
+
+#define IMX789_REG_DIG_GAIN_GLOBAL	CCI_REG16(0x020e)
+#define IMX789_DGTL_GAIN_MIN		0x0100
+#define IMX789_DGTL_GAIN_MAX		0x0fff
+#define IMX789_DGTL_GAIN_DEFAULT	0x0100
+
+#define IMX789_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define IMX789_REG_ORIENTATION		CCI_REG8(0x0101)
+
+#define IMX789_EXT_CLK			19200000
+/* C-PHY: 960 Msps per trio, reported as half the symbol rate */
+#define IMX789_LINK_FREQ		480000000LL
+/* VT PLL: 19.2 MHz / 3 * 174 / 5, eight pixels per clock */
+#define IMX789_PIXEL_RATE		1781760000LL
+
+#define IMX789_NATIVE_WIDTH		8000
+#define IMX789_NATIVE_HEIGHT		6016
+
+static const char * const imx789_supply_names[] = {
+	"vio",
+	"vana",
+	"vana1",
+	"vdig",
+};
+
+struct imx789_mode {
+	u32 width;
+	u32 height;
+	u32 fll;
+	u32 llp;
+	struct v4l2_rect crop;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct imx789 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct clk *clk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx789_supply_names)];
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+#define to_imx789(_sd) container_of(_sd, struct imx789, sd)
