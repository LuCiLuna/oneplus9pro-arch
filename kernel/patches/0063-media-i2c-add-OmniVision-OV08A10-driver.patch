From 4cf23216ae3a47c38efca0c9b2e0183e6c7254ef Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:46:02 +0000
Subject: [PATCH 063/110] media: i2c: add OmniVision OV08A10 driver

The OV08A10 is the 8 MP telephoto sensor of the OnePlus 9 Pro. One
3264x2448 BGGR mode at 30 fps over two D-PHY lanes at 1.6 Gbps, with the
register settings from the phone's camera module data. Analogue gain is
gain * 256 from 1x to 15.5x, as in the vendor sensor library;
exposure is in lines.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/Kconfig   |  11 +
 drivers/media/i2c/Makefile  |   1 +
 drivers/media/i2c/ov08a10.c | 909 ++++++++++++++++++++++++++++++++++++
 3 files changed, 921 insertions(+)
 create mode 100644 drivers/media/i2c/ov08a10.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index efe038849a7..251a7e7f49a 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -456,6 +456,17 @@ config VIDEO_OV02C10
 	  To compile this driver as a module, choose M here: the
 	  module will be called ov02c10.
 
+config VIDEO_OV08A10
+	tristate "OmniVision OV08A10 sensor support"
+	depends on GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the OmniVision
+	  OV08A10 8 MP camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called ov08a10.
+
 config VIDEO_OV08D10
         tristate "OmniVision OV08D10 sensor support"
         help
