index e00debccb9d..bb6abc63d95 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -92,6 +92,7 @@ obj-$(CONFIG_VIDEO_OV01A10) += ov01a10.o
