+static int ov08a10_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov08a10 *sensor = container_of(ctrl->handler, struct ov08a10,
+					      ctrls);
+	struct v4l2_subdev_state *state =
+		v4l2_subdev_get_locked_active_state(&sensor->sd);
+	const struct v4l2_mbus_framefmt *fmt =
+		v4l2_subdev_state_get_format(state, 0);
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max = fmt->height + ctrl->val - OV08A10_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(sensor->exposure,
+					       sensor->exposure->minimum, max,
+					       sensor->exposure->step,
+					       min(sensor->exposure->default_value,
+						   max));
+		if (ret)
+			return ret;
+	}
+
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(sensor->regmap, OV08A10_REG_ANALOG_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sensor->regmap, OV08A10_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sensor->regmap, OV08A10_REG_VTS,
+				fmt->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(sensor->regmap, OV08A10_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov08a10_ctrl_ops = {
+	.s_ctrl = ov08a10_set_ctrl,
+};
+
+static int ov08a10_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int ov08a10_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(ov08a10_modes) ||
+	    fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = ov08a10_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = ov08a10_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int ov08a10_set_pad_format(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_format *fmt)
+{
+	struct ov08a10 *sensor = to_ov08a10(sd);
+	const struct ov08a10_mode *mode;
+	int ret;
+
+	mode = v4l2_find_nearest_size(ov08a10_modes, ARRAY_SIZE(ov08a10_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	fmt->format.code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, fmt->pad) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	ret = __v4l2_ctrl_modify_range(sensor->vblank,
+				       mode->vts - mode->height,
+				       OV08A10_VTS_MAX - mode->height, 1,
+				       mode->vts - mode->height);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_s_ctrl(sensor->vblank, mode->vts - mode->height);
+}
+
+static int ov08a10_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, sel->pad);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV08A10_NATIVE_WIDTH;
+		sel->r.height = OV08A10_NATIVE_HEIGHT;
+		return 0;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r = ov08a10_modes[0].crop;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int ov08a10_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.width = ov08a10_modes[0].width,
+			.height = ov08a10_modes[0].height,
+		},
+	};
+
+	return ov08a10_set_pad_format(sd, state, &fmt);
+}
+
+static int ov08a10_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct ov08a10 *sensor = to_ov08a10(sd);
+	const struct v4l2_mbus_framefmt *fmt;
+	const struct ov08a10_mode *mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret)
+		return ret;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	mode = v4l2_find_nearest_size(ov08a10_modes, ARRAY_SIZE(ov08a10_modes),
+				      width, height, fmt->width, fmt->height);
+
+	ret = cci_write(sensor->regmap, OV08A10_REG_SOFTWARE_RESET, 0x01, NULL);
+	if (ret)
+		goto err_put;
+	usleep_range(5000, 6000);
+
+	ret = cci_multi_reg_write(sensor->regmap, ov08a10_init_regs,
+				  ARRAY_SIZE(ov08a10_init_regs), NULL);
+	if (ret)
+		goto err_put;
+
+	ret = cci_multi_reg_write(sensor->regmap, mode->regs, mode->num_regs,
+				  NULL);
+	if (ret)
+		goto err_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
+	if (ret)
+		goto err_put;
+
+	ret = cci_write(sensor->regmap, OV08A10_REG_MODE_SELECT,
+			OV08A10_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_put;
+
+	return 0;
+
+err_put:
+	dev_err(sensor->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static int ov08a10_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct ov08a10 *sensor = to_ov08a10(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, OV08A10_REG_MODE_SELECT,
+			OV08A10_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(sensor->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put(sensor->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov08a10_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov08a10_pad_ops = {
+	.enum_mbus_code = ov08a10_enum_mbus_code,
+	.enum_frame_size = ov08a10_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = ov08a10_set_pad_format,
+	.get_selection = ov08a10_get_selection,
+	.enable_streams = ov08a10_enable_streams,
+	.disable_streams = ov08a10_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov08a10_subdev_ops = {
+	.video = &ov08a10_video_ops,
+	.pad = &ov08a10_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov08a10_internal_ops = {
+	.init_state = ov08a10_init_state,
+};
+
+static int ov08a10_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov08a10 *sensor = to_ov08a10(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
+				    sensor->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(sensor->clk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(sensor->supplies),
+				       sensor->supplies);
+		return ret;
+	}
+
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	/* 8192 MCLK cycles before the first SCCB access */
+	usleep_range(5000, 6000);
+
+	return 0;
+}
+
+static int ov08a10_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov08a10 *sensor = to_ov08a10(sd);
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	clk_disable_unprepare(sensor->clk);
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+
+	return 0;
+}
+
+static int ov08a10_init_controls(struct ov08a10 *sensor)
+{
+	const struct ov08a10_mode *mode = &ov08a10_modes[0];
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, &ov08a10_ctrl_ops,
+				      V4L2_CID_LINK_FREQ, 0, 0,
+				      ov08a10_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &ov08a10_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  OV08A10_PIXEL_RATE, OV08A10_PIXEL_RATE, 1,
+			  OV08A10_PIXEL_RATE);
+
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &ov08a10_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   mode->vts - mode->height,
+					   OV08A10_VTS_MAX - mode->height, 1,
+					   mode->vts - mode->height);
+
+	ctrl = v4l2_ctrl_new_std(hdl, &ov08a10_ctrl_ops, V4L2_CID_HBLANK,
+				 OV08A10_LLP - mode->width,
+				 OV08A10_LLP - mode->width, 1,
+				 OV08A10_LLP - mode->width);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &ov08a10_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     OV08A10_EXPOSURE_MIN,
+					     mode->vts - OV08A10_EXPOSURE_MARGIN,
+					     1, 1000);
+
+	v4l2_ctrl_new_std(hdl, &ov08a10_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  OV08A10_ANA_GAIN_MIN, OV08A10_ANA_GAIN_MAX, 1,
+			  OV08A10_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &ov08a10_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov08a10_test_pattern_menu) - 1,
+				     0, 0, ov08a10_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &ov08a10_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int ov08a10_parse_endpoint(struct ov08a10 *sensor)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *fwnode;
+	unsigned long bitmap;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!fwnode)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		ret = dev_err_probe(sensor->dev, -EINVAL,
+				    "need 2 data lanes, got %u\n",
+				    ep.bus.mipi_csi2.num_data_lanes);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(sensor->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       ov08a10_link_freqs,
+				       ARRAY_SIZE(ov08a10_link_freqs), &bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int ov08a10_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov08a10 *sensor;
+	u64 id;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->dev = dev;
+
+	ret = ov08a10_parse_endpoint(sensor);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	sensor->clk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->clk))
+		return dev_err_probe(dev, PTR_ERR(sensor->clk),
+				     "failed to get clock\n");
+	if (clk_get_rate(sensor->clk) != OV08A10_EXT_CLK)
+		return dev_err_probe(dev, -EINVAL, "unsupported clock rate %lu\n",
+				     clk_get_rate(sensor->clk));
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(ov08a10_supply_names); i++)
+		sensor->supplies[i].supply = ov08a10_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sensor->supplies),
+				      sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	sensor->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return PTR_ERR(sensor->regmap);
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &ov08a10_subdev_ops);
+
+	ret = ov08a10_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = cci_read(sensor->regmap, OV08A10_REG_CHIP_ID, &id, NULL);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to read chip id\n");
+		goto err_power_off;
+	}
+	if (id != OV08A10_CHIP_ID) {
+		ret = dev_err_probe(dev, -ENODEV, "unexpected chip id 0x%04llx\n",
+				    id);
+		goto err_power_off;
+	}
+
+	ret = ov08a10_init_controls(sensor);
+	if (ret)
+		goto err_power_off;
+
+	sensor->sd.internal_ops = &ov08a10_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_ctrls;
+
+	sensor->sd.state_lock = sensor->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto err_pm;
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+err_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+err_power_off:
+	ov08a10_power_off(dev);
+
+	return ret;
+}
+
+static void ov08a10_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		ov08a10_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov08a10_pm_ops, ov08a10_power_off,
+				 ov08a10_power_on, NULL);
+
+static const struct of_device_id ov08a10_of_match[] = {
+	{ .compatible = "ovti,ov08a10" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ov08a10_of_match);
+
+static struct i2c_driver ov08a10_driver = {
+	.driver = {
+		.name = "ov08a10",
+		.of_match_table = ov08a10_of_match,
+		.pm = pm_ptr(&ov08a10_pm_ops),
+	},
+	.probe = ov08a10_probe,
+	.remove = ov08a10_remove,
+};
+module_i2c_driver(ov08a10_driver);
+
+MODULE_DESCRIPTION("OmniVision OV08A10 image sensor driver");
+MODULE_LICENSE("GPL");
