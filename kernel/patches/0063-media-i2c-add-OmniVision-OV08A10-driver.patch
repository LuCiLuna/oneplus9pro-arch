+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define OV08A10_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define OV08A10_MODE_STANDBY		0x00
+#define OV08A10_MODE_STREAMING		0x01
+
+#define OV08A10_REG_SOFTWARE_RESET	CCI_REG8(0x0103)
+
+#define OV08A10_REG_CHIP_ID		CCI_REG16(0x300b)
+#define OV08A10_CHIP_ID			0x0841
+
+#define OV08A10_REG_VTS			CCI_REG16(0x380e)
+#define OV08A10_VTS_MAX			0xffff
+
+/* in lines */
+#define OV08A10_REG_EXPOSURE		CCI_REG16(0x3501)
+#define OV08A10_EXPOSURE_MIN		8
+#define OV08A10_EXPOSURE_MARGIN		24
+
+/* gain * 256, 1x to 15.5x */
+#define OV08A10_REG_ANALOG_GAIN		CCI_REG16(0x3508)
+#define OV08A10_ANA_GAIN_MIN		0x0100
+#define OV08A10_ANA_GAIN_MAX		0x0f80
+#define OV08A10_ANA_GAIN_DEFAULT	0x0100
+
+#define OV08A10_REG_TEST_PATTERN	CCI_REG8(0x5081)
+
+#define OV08A10_EXT_CLK			19200000
+/* 19.2 MHz MCLK, 1.6 Gbps per lane */
+#define OV08A10_LINK_FREQ		800000000
+/*
+ * 160 MHz VT clock with HTS 902; libcamera works in pixels, so report a
+ * line of 4 * 902 pixels at four times the rate.
+ */
+#define OV08A10_PIXEL_RATE		640000000
+#define OV08A10_LLP			3608
+
+#define OV08A10_NATIVE_WIDTH		3296
+#define OV08A10_NATIVE_HEIGHT		2480
+
+static const char * const ov08a10_supply_names[] = {
+	"dovdd",
+	"avdd",
+	"dvdd",
+};
+
+struct ov08a10_mode {
+	u32 width;
+	u32 height;
+	u32 vts;
+	struct v4l2_rect crop;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct ov08a10 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct clk *clk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov08a10_supply_names)];
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+};
+
+#define to_ov08a10(_sd) container_of(_sd, struct ov08a10, sd)
