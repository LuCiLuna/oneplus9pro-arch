From 06536c0c9da2e870190f8f387e6a3487a09725aa Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 09:58:07 +0000
Subject: [PATCH 025/114] HACK: power: qcom_battmgr: allow skipping the ADSP
 battery on OnePlus 9 Pro

The OnePlus 9 Pro gauges its dual-cell battery with an external bq27541
and the ADSP battery manager always reports 0%. With both registered,
upower shows two batteries and the wrong percentage. Add a
"qcom,no-battery" pmic-glink property to skip the ADSP battery psy and
set it on lemonade/lemonadep.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8350-oneplus-common.dtsi    |  2 ++
 drivers/power/supply/qcom_battmgr.c             | 17 ++++++++++++-----
 2 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi
index 16356b74fd1..d2a95636631 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-common.dtsi
@@ -105,6 +105,8 @@ key-vol-down {
 
 	pmic-glink {
 		compatible = "qcom,sm8350-pmic-glink", "qcom,pmic-glink";
+		/* the ADSP battery reads 0%; the bq27541 gauges the cells */
+		qcom,no-battery;
 		#address-cells = <1>;
 		#size-cells = <0>;
 
diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 7716eb9e1af..c4cacd64724 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -1209,7 +1209,8 @@ static void qcom_battmgr_notification(struct qcom_battmgr *battmgr,
 	case NOTIF_BAT_STATUS:
 	case NOTIF_BAT_PROPERTY:
 	case NOTIF_BAT_CHARGING_STATE:
-		power_supply_changed(battmgr->bat_psy);
+		if (battmgr->bat_psy)
+			power_supply_changed(battmgr->bat_psy);
 		break;
 	case NOTIF_USB_PROPERTY:
 		power_supply_changed(battmgr->usb_psy);
@@ -1695,10 +1696,16 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 		else
 			psy_desc = &sm8350_bat_psy_desc;
 
-		battmgr->bat_psy = devm_power_supply_register(dev, psy_desc, &psy_cfg);
-		if (IS_ERR(battmgr->bat_psy))
-			return dev_err_probe(dev, PTR_ERR(battmgr->bat_psy),
-					     "failed to register battery power supply\n");
+		/*
+		 * HACK: some phones (OnePlus 9 Pro) gauge the battery with an
+		 * external fuel gauge and the ADSP only reports 0%.
+		 */
+		if (!device_property_read_bool(dev->parent, "qcom,no-battery")) {
+			battmgr->bat_psy = devm_power_supply_register(dev, psy_desc, &psy_cfg);
+			if (IS_ERR(battmgr->bat_psy))
+				return dev_err_probe(dev, PTR_ERR(battmgr->bat_psy),
+						     "failed to register battery power supply\n");
+		}
 
 		battmgr->usb_psy = devm_power_supply_register(dev, &sm8350_usb_psy_desc, &psy_cfg_supply);
 		if (IS_ERR(battmgr->usb_psy))
