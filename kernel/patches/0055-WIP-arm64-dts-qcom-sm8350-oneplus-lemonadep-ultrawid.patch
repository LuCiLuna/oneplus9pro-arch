From 5049693739058ee4175b6f9930ba2276acd660a1 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 19:12:22 +0000
Subject: [PATCH 055/114] WIP: arm64: dts: qcom: sm8350-oneplus-lemonadep:
 ultrawide camera

Add the IMX766 ultrawide on CCI0 bus 1 / CSIPHY2 (C-PHY) with its
rails, and put all camera sensors in the TITAN_TOP power domain so
their MCLK branches can always be switched on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8350-oneplus-lemonadep.dts     | 89 +++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index cf7e402827a..c582e058539 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -83,6 +83,29 @@ vreg_cam_main_dvdd: regulator-cam-main-dvdd {
 		pinctrl-names = "default";
 	};
 
+	/* Ultrawide camera rails */
+	vreg_cam_wide_avdd: regulator-cam-wide-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_wide_avdd";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 195 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8350c_s1>;
+		pinctrl-0 = <&cam_wide_avdd_en>;
+		pinctrl-names = "default";
+	};
+
+	vreg_cam_wide_dvdd: regulator-cam-wide-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_wide_dvdd";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		gpio = <&pm8350c_gpios 3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+	};
+
 	wcd938x: audio-codec {
 		compatible = "qcom,wcd9380-codec";
 
@@ -265,6 +288,15 @@ csiphy1_ep: endpoint {
 			};
 		};
 
+		/* Ultrawide camera on CSIPHY2, C-PHY */
+		port@2 {
+			csiphy2_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				remote-endpoint = <&imx766_ep>;
+			};
+		};
+
 		/* Front camera on CSIPHY5 */
 		port@5 {
 			csiphy5_ep: endpoint {
@@ -289,6 +321,7 @@ camera@1a {
 		clocks = <&camcc CAM_CC_MCLK0_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
 		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
 
 		reset-gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
 		pinctrl-0 = <&cam_mclk0_active>, <&cam_main_reset>;
@@ -313,6 +346,40 @@ imx789_ep: endpoint {
 	};
 };
 
+&cci0_i2c1 {
+	/* Ultrawide camera, Sunny IMX766 */
+	camera@1a {
+		compatible = "sony,imx766";
+		reg = <0x1a>;
+
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		reset-gpios = <&tlmm 106 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk1_active>, <&cam_wide_reset>;
+		pinctrl-names = "default";
+
+		vio-supply = <&vreg_l5i>;
+		vana-supply = <&vreg_cam_wide_avdd>;
+		vana1-supply = <&vreg_l7i>;
+		vdig-supply = <&vreg_cam_wide_dvdd>;
+
+		rotation = <90>;
+		orientation = <1>;
+
+		port {
+			imx766_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				link-frequencies = /bits/ 64 <537600000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+};
+
 &cci1 {
 	status = "okay";
 };
@@ -326,6 +393,7 @@ camera@10 {
 		clocks = <&camcc CAM_CC_MCLK3_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
 		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
 
 		reset-gpios = <&tlmm 115 GPIO_ACTIVE_LOW>;
 		pinctrl-0 = <&cam_mclk3_active>, <&cam_front_reset>;
@@ -564,6 +632,27 @@ cam_main_dvdd_en: cam-main-dvdd-en-state {
 		bias-disable;
 	};
 
+	cam_mclk1_active: cam-mclk1-active-state {
+		pins = "gpio101";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_wide_reset: cam-wide-reset-state {
+		pins = "gpio106";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_wide_avdd_en: cam-wide-avdd-en-state {
+		pins = "gpio195";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	cam_mclk3_active: cam-mclk3-active-state {
 		pins = "gpio103";
 		function = "cam_mclk";
