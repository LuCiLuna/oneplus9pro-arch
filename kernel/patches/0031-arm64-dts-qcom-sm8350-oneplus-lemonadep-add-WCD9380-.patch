From 9e43240f9d9ba1ffa367dae3071e69fe6e604380 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 10:37:50 +0000
Subject: [PATCH 031/114] arm64: dts: qcom: sm8350-oneplus-lemonadep: add
 WCD9380 and microphones

WCD9380 on the RX/TX SoundWire buses, the two built-in DMICs (DMIC1 and
DMIC3, read by the TX macro, clocked by the VA macro) and the headset mic.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8350-oneplus-lemonadep.dts     | 181 ++++++++++++++++++
 1 file changed, 181 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index 90e8fbf85df..489e4a6c40f 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -32,12 +32,56 @@ memory@80000000 {
 		      <0x0 0xc0000000 0x1 0x40000000>;
 	};
 
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9380-codec";
+
+		pinctrl-0 = <&wcd_reset_n>;
+		pinctrl-names = "default";
+
+		reset-gpios = <&tlmm 88 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&pm8350_s10>;
+		vdd-rxtx-supply = <&pm8350_s10>;
+		vdd-io-supply = <&pm8350_s10>;
+		vdd-mic-bias-supply = <&vreg_bob>;
+
+		qcom,micbias1-microvolt = <1800000>;
+		qcom,micbias2-microvolt = <2700000>;
+		qcom,micbias3-microvolt = <1800000>;
+		qcom,micbias4-microvolt = <1800000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+
 	sound {
 		compatible = "qcom,sm8250-sndcard";
 		model = "OnePlus 9 Pro";
 		pinctrl-0 = <&tert_mi2s_active>;
 		pinctrl-names = "default";
 
+		/*
+		 * Built-in mics are DMICs read by the TX macro, clocked by the VA
+		 * macro and powered by WCD938x mic biases (as downstream).
+		 */
+		audio-routing = "TX DMIC0", "MIC BIAS3",
+				"TX DMIC0", "VA DMIC01 CLK",
+				"TX DMIC1", "MIC BIAS1",
+				"TX DMIC1", "VA DMIC01 CLK",
+				"TX DMIC2", "MIC BIAS1",
+				"TX DMIC2", "VA DMIC23 CLK",
+				"TX DMIC3", "MIC BIAS3",
+				"TX DMIC3", "VA DMIC23 CLK",
+				"TX DMIC4", "MIC BIAS4",
+				"TX DMIC4", "VA DMIC45 CLK",
+				"TX DMIC5", "MIC BIAS4",
+				"TX DMIC5", "VA DMIC45 CLK",
+				"AMIC2", "MIC BIAS2";
+
 		mm1-dai-link {
 			link-name = "MultiMedia1";
 
@@ -77,6 +121,54 @@ codec {
 				sound-dai = <&speaker_top>, <&speaker_bottom>;
 			};
 		};
+
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			cpu {
+				sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+			};
+
+			codec {
+				sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
+
+		va-dai-link {
+			link-name = "VA Capture";
+
+			cpu {
+				sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>;
+			};
+
+			codec {
+				sound-dai = <&vamacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+
+			cpu {
+				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+			};
+
+			codec {
+				sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
 	};
 };
 
@@ -163,6 +255,88 @@ &mpss {
 	status = "okay";
 };
 
+&rxmacro {
+	status = "okay";
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010d00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010d00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <1 1 2 3>;
+	};
+};
+
+&lpass_tlmm {
+	dmic01_active: dmic01-active-state {
+		clk-pins {
+			pins = "gpio6";
+			function = "dmic1_clk";
+			drive-strength = <8>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio7";
+			function = "dmic1_data";
+			drive-strength = <8>;
+		};
+	};
+
+	dmic23_active: dmic23-active-state {
+		clk-pins {
+			pins = "gpio8";
+			function = "dmic2_clk";
+			drive-strength = <8>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio9";
+			function = "dmic2_data";
+			drive-strength = <8>;
+		};
+	};
+
+	dmic45_active: dmic45-active-state {
+		clk-pins {
+			pins = "gpio12";
+			function = "dmic3_clk";
+			drive-strength = <8>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio13";
+			function = "dmic3_data";
+			drive-strength = <8>;
+		};
+	};
+};
+
+&txmacro {
+	status = "okay";
+};
+
+&vamacro {
+	pinctrl-0 = <&dmic01_active>, <&dmic23_active>, <&dmic45_active>;
+	pinctrl-names = "default";
+	qcom,dmic-sample-rate = <600000>;
+	status = "okay";
+};
+
 /* Speaker amplifiers: tertiary MI2S, SD1 out to the amps, SD0 feedback in */
 &q6afedai {
 	dai@20 {
@@ -202,6 +376,13 @@ data1-pins {
 		};
 	};
 
+	wcd_reset_n: wcd-reset-n-state {
+		pins = "gpio88";
+		function = "gpio";
+		drive-strength = <16>;
+		output-high;
+	};
+
 	tp_enable_2v8: tp-2v8-enable-state {
 		pins = "gpio31", "gpio197";
 		function = "gpio";
