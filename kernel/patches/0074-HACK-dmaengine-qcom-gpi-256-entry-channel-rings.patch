From ce9f028e1abdb29aa9929157f67f408fe032f22e Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 02:05:14 +0000
Subject: [PATCH 074/110] HACK: dmaengine: qcom: gpi: 256 entry channel rings

The touchscreen on the OnePlus 9 Pro sits behind a GPI only I2C SE
(firmware disabled its FIFO). A read leaves its TX config and go TREs on
the TX ring until a later TX event reclaims them, so a burst of touch
reads filled the 64 entry ring and about one read in ten failed with
"not enough space in ring". Give the rings room for bursts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/dma/qcom/gpi.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/dma/qcom/gpi.c b/drivers/dma/qcom/gpi.c
index a5055a6273a..d4b90b6222b 100644
--- a/drivers/dma/qcom/gpi.c
+++ b/drivers/dma/qcom/gpi.c
@@ -237,7 +237,7 @@ enum msm_gpi_tce_code {
 #define STATE_IGNORE		(U32_MAX)
 #define EV_FACTOR		(2)
 #define REQ_OF_DMA_ARGS		(5) /* # of arguments required from client */
-#define CHAN_TRES		64
+#define CHAN_TRES		256
 
 struct __packed xfer_compl_event {
 	u64 ptr;
