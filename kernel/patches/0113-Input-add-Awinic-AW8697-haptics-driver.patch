From 193331a6af0f179ff048141299c3b4ccac4cd76c Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 23:22:57 -0600
Subject: [PATCH 113/114] Input: add Awinic AW8697 haptics driver

Drives an LRA in closed-loop continuous mode through the force feedback
interface, which needs no waveform data. Settings come from the OnePlus vendor
driver for the 170 Hz motor in the OnePlus 9 Pro.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/misc/Kconfig  |  12 ++
 drivers/input/misc/Makefile |   1 +
 drivers/input/misc/aw8697.c | 320 ++++++++++++++++++++++++++++++++++++
 3 files changed, 333 insertions(+)
 create mode 100644 drivers/input/misc/aw8697.c

diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
index 169768e3d5b..081c09bef2e 100644
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -126,6 +126,18 @@ config INPUT_ATMEL_CAPTOUCH
 	  To compile this driver as a module, choose M here: the
 	  module will be called atmel_captouch.
 
+config INPUT_AW8697
+	tristate "Awinic AW8697 Haptic Driver Support"
+	depends on I2C && GPIOLIB
+	select INPUT_FF_MEMLESS
+	select REGMAP_I2C
+	help
+	  Say Y here to include support for the Awinic AW8697 LRA haptics
+	  driver found on the OnePlus 9 Pro.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called aw8697.
+
 config INPUT_AW86927
 	tristate "Awinic AW86927 Haptic Driver Support"
 	depends on I2C && INPUT
diff --git a/drivers/input/misc/Makefile b/drivers/input/misc/Makefile
index 1339619f076..171d3ff1f16 100644
--- a/drivers/input/misc/Makefile
+++ b/drivers/input/misc/Makefile
@@ -23,6 +23,7 @@ obj-$(CONFIG_INPUT_ATC260X_ONKEY)	+= atc260x-onkey.o
 obj-$(CONFIG_INPUT_ATI_REMOTE2)		+= ati_remote2.o
 obj-$(CONFIG_INPUT_ATLAS_BTNS)		+= atlas_btns.o
 obj-$(CONFIG_INPUT_ATMEL_CAPTOUCH)	+= atmel_captouch.o
+obj-$(CONFIG_INPUT_AW8697)		+= aw8697.o
 obj-$(CONFIG_INPUT_AW86927)		+= aw86927.o
 obj-$(CONFIG_INPUT_BBNSM_PWRKEY)	+= nxp-bbnsm-pwrkey.o
 obj-$(CONFIG_INPUT_BMA150)		+= bma150.o
diff --git a/drivers/input/misc/aw8697.c b/drivers/input/misc/aw8697.c
new file mode 100644
index 00000000000..03ef71fc8e2
--- /dev/null
+++ b/drivers/input/misc/aw8697.c
@@ -0,0 +1,320 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Awinic AW8697 haptics driver
+ *
+ * Drives an LRA in the chip's closed-loop continuous mode, which needs no waveform
+ * data. Register values and motor settings come from the OnePlus vendor driver.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/pm.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define AW8697_REG_ID			0x00
+#define AW8697_CHIP_ID			0x97
+#define AW8697_RESET_MAGIC		0xaa
+#define AW8697_REG_SYSCTRL		0x04
+#define AW8697_SYSCTRL_PLAY_MODE	GENMASK(3, 2)
+#define AW8697_SYSCTRL_PLAY_CONT	FIELD_PREP(AW8697_SYSCTRL_PLAY_MODE, 2)
+#define AW8697_SYSCTRL_BOOST		BIT(1)
+#define AW8697_SYSCTRL_STANDBY		BIT(0)
+#define AW8697_REG_GO			0x05
+#define AW8697_REG_DATCTRL		0x2b
+#define AW8697_DATCTRL_LPF		GENMASK(7, 5)
+#define AW8697_REG_PWMDBG		0x2e
+#define AW8697_PWMDBG_MODE		GENMASK(6, 5)
+#define AW8697_PWMDBG_24K		FIELD_PREP(AW8697_PWMDBG_MODE, 2)
+#define AW8697_REG_BSTDBG1		0x31
+#define AW8697_REG_BSTDBG2		0x32
+#define AW8697_REG_BSTDBG3		0x33
+#define AW8697_REG_BSTCFG		0x34
+#define AW8697_BSTCFG_PEAKCUR		GENMASK(2, 0)
+#define AW8697_BSTCFG_3P5A		5
+#define AW8697_REG_ANADBG		0x35
+#define AW8697_ANADBG_IOC		GENMASK(3, 2)
+#define AW8697_REG_GLB_STATE		0x46
+#define AW8697_GLB_STATE_MASK		GENMASK(3, 0)
+#define AW8697_REG_CONT_CTRL		0x48
+#define AW8697_CONT_CTRL_RUN		(BIT(7) | BIT(3) | BIT(0)) /* zero cross, closed loop, brake */
+#define AW8697_REG_F_PRE_H		0x49
+#define AW8697_REG_F_PRE_L		0x4a
+#define AW8697_REG_TD_H			0x4b
+#define AW8697_REG_TD_L			0x4c
+#define AW8697_REG_TSET			0x4d
+#define AW8697_REG_R_SPARE		0x5d
+#define AW8697_REG_ZC_THRSH_H		0x72
+#define AW8697_REG_ZC_THRSH_L		0x73
+#define AW8697_REG_ADCTEST		0x66
+#define AW8697_ADCTEST_VBAT_HW_COMP	BIT(6)
+#define AW8697_REG_BEMF_VTHH_H		0x74
+#define AW8697_REG_BEMF_VTHH_L		0x75
+#define AW8697_REG_BEMF_VTHL_H		0x76
+#define AW8697_REG_BEMF_VTHL_L		0x77
+#define AW8697_REG_BEMF_NUM		0x78
+#define AW8697_BEMF_NUM_BRK		GENMASK(3, 0)
+#define AW8697_REG_TIME_NZC		0x7a
+#define AW8697_REG_DRV_LVL		0x7b
+#define AW8697_REG_DRV_LVL_OV		0x7c
+
+/* The motor in the OnePlus 9 Pro (vendor device id 9595) */
+#define AW8697_F0_DECIHZ		1700
+#define AW8697_F0_COEFF			260
+#define AW8697_DRV_LVL			60
+#define AW8697_DRV_LVL_OV		125
+#define AW8697_CONT_TD			0x009a
+#define AW8697_CONT_ZC_THR		0x0ff1
+#define AW8697_CONT_NUM_BRK		3
+
+struct aw8697 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct gpio_desc *reset;
+	struct input_dev *input;
+	struct work_struct play_work;
+	bool playing;
+	bool active;
+};
+
+static const struct regmap_config aw8697_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int aw8697_init(struct aw8697 *hap)
+{
+	const struct reg_sequence seq[] = {
+		{ AW8697_REG_BSTDBG1, 0x30 },
+		{ AW8697_REG_BSTDBG2, 0xeb },
+		{ AW8697_REG_BSTDBG3, 0xd4 },
+		{ AW8697_REG_TSET, 0x12 },
+		{ AW8697_REG_R_SPARE, 0x68 },
+	};
+	int ret;
+
+	ret = regmap_update_bits(hap->regmap, AW8697_REG_SYSCTRL,
+				 AW8697_SYSCTRL_STANDBY, AW8697_SYSCTRL_STANDBY);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(hap->regmap, AW8697_REG_PWMDBG,
+				 AW8697_PWMDBG_MODE, AW8697_PWMDBG_24K);
+	if (ret)
+		return ret;
+
+	ret = regmap_multi_reg_write(hap->regmap, seq, ARRAY_SIZE(seq));
+	if (ret)
+		return ret;
+
+	ret = regmap_set_bits(hap->regmap, AW8697_REG_ANADBG, AW8697_ANADBG_IOC);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(hap->regmap, AW8697_REG_BSTCFG,
+				 AW8697_BSTCFG_PEAKCUR, AW8697_BSTCFG_3P5A);
+	if (ret)
+		return ret;
+
+	return regmap_set_bits(hap->regmap, AW8697_REG_ADCTEST, AW8697_ADCTEST_VBAT_HW_COMP);
+}
+
+static int aw8697_start(struct aw8697 *hap)
+{
+	u32 f_pre = 1000000000 / (AW8697_F0_DECIHZ * AW8697_F0_COEFF);
+	const struct reg_sequence seq[] = {
+		{ AW8697_REG_F_PRE_H, f_pre >> 8 },
+		{ AW8697_REG_F_PRE_L, f_pre & 0xff },
+		{ AW8697_REG_CONT_CTRL, AW8697_CONT_CTRL_RUN },
+		{ AW8697_REG_TD_H, AW8697_CONT_TD >> 8 },
+		{ AW8697_REG_TD_L, AW8697_CONT_TD & 0xff },
+		{ AW8697_REG_TSET, 0x12 },
+		{ AW8697_REG_ZC_THRSH_H, AW8697_CONT_ZC_THR >> 8 },
+		{ AW8697_REG_ZC_THRSH_L, AW8697_CONT_ZC_THR & 0xff },
+		{ AW8697_REG_BEMF_VTHH_H, 0x10 },
+		{ AW8697_REG_BEMF_VTHH_L, 0x08 },
+		{ AW8697_REG_BEMF_VTHL_H, 0x03 },
+		{ AW8697_REG_BEMF_VTHL_L, 0xf8 },
+		{ AW8697_REG_TIME_NZC, 0x23 },
+		{ AW8697_REG_DRV_LVL, AW8697_DRV_LVL },
+		{ AW8697_REG_DRV_LVL_OV, AW8697_DRV_LVL_OV },
+	};
+	int ret;
+
+	ret = regmap_update_bits(hap->regmap, AW8697_REG_SYSCTRL,
+				 AW8697_SYSCTRL_PLAY_MODE | AW8697_SYSCTRL_BOOST |
+				 AW8697_SYSCTRL_STANDBY, AW8697_SYSCTRL_PLAY_CONT);
+	if (ret)
+		return ret;
+
+	ret = regmap_set_bits(hap->regmap, AW8697_REG_DATCTRL, AW8697_DATCTRL_LPF);
+	if (ret)
+		return ret;
+
+	ret = regmap_multi_reg_write(hap->regmap, seq, ARRAY_SIZE(seq));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(hap->regmap, AW8697_REG_BEMF_NUM,
+				 AW8697_BEMF_NUM_BRK, AW8697_CONT_NUM_BRK);
+	if (ret)
+		return ret;
+
+	return regmap_write(hap->regmap, AW8697_REG_GO, 1);
+}
+
+static void aw8697_stop(struct aw8697 *hap)
+{
+	unsigned int state;
+	int ret;
+
+	regmap_write(hap->regmap, AW8697_REG_GO, 0);
+
+	/* The chip brakes the motor, then drops to standby by itself */
+	ret = regmap_read_poll_timeout(hap->regmap, AW8697_REG_GLB_STATE, state,
+				       !(state & AW8697_GLB_STATE_MASK), 2000, 400000);
+	if (ret) {
+		dev_warn(hap->dev, "motor didn't stop, resetting: %d\n", ret);
+		regmap_write(hap->regmap, AW8697_REG_ID, AW8697_RESET_MAGIC);
+		usleep_range(3000, 3500);
+		aw8697_init(hap);
+		return;
+	}
+
+	regmap_update_bits(hap->regmap, AW8697_REG_SYSCTRL,
+			   AW8697_SYSCTRL_STANDBY, AW8697_SYSCTRL_STANDBY);
+}
+
+static void aw8697_play_work(struct work_struct *work)
+{
+	struct aw8697 *hap = container_of(work, struct aw8697, play_work);
+	bool playing = READ_ONCE(hap->playing);
+
+	if (playing == hap->active)
+		return;
+
+	if (playing) {
+		int ret = aw8697_start(hap);
+
+		if (ret) {
+			dev_err(hap->dev, "failed to start: %d\n", ret);
+			return;
+		}
+	} else {
+		aw8697_stop(hap);
+	}
+
+	hap->active = playing;
+}
+
+static int aw8697_play(struct input_dev *input, void *data, struct ff_effect *effect)
+{
+	struct aw8697 *hap = input_get_drvdata(input);
+
+	WRITE_ONCE(hap->playing, effect->u.rumble.strong_magnitude ||
+				 effect->u.rumble.weak_magnitude);
+	schedule_work(&hap->play_work);
+
+	return 0;
+}
+
+static void aw8697_close(struct input_dev *input)
+{
+	struct aw8697 *hap = input_get_drvdata(input);
+
+	WRITE_ONCE(hap->playing, false);
+	cancel_work_sync(&hap->play_work);
+	aw8697_play_work(&hap->play_work);
+}
+
+static int aw8697_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct aw8697 *hap;
+	unsigned int id;
+	int ret;
+
+	hap = devm_kzalloc(dev, sizeof(*hap), GFP_KERNEL);
+	if (!hap)
+		return -ENOMEM;
+
+	hap->dev = dev;
+	INIT_WORK(&hap->play_work, aw8697_play_work);
+	i2c_set_clientdata(client, hap);
+
+	hap->regmap = devm_regmap_init_i2c(client, &aw8697_regmap_config);
+	if (IS_ERR(hap->regmap))
+		return PTR_ERR(hap->regmap);
+
+	hap->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(hap->reset))
+		return dev_err_probe(dev, PTR_ERR(hap->reset), "failed to get reset gpio\n");
+
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(hap->reset, 0);
+	usleep_range(3500, 4000);
+
+	ret = regmap_read(hap->regmap, AW8697_REG_ID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip id\n");
+	if (id != AW8697_CHIP_ID)
+		return dev_err_probe(dev, -ENODEV, "unexpected chip id %#x\n", id);
+
+	ret = aw8697_init(hap);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to initialise\n");
+
+	hap->input = devm_input_allocate_device(dev);
+	if (!hap->input)
+		return -ENOMEM;
+
+	hap->input->name = "aw8697-haptics";
+	hap->input->close = aw8697_close;
+	input_set_drvdata(hap->input, hap);
+	input_set_capability(hap->input, EV_FF, FF_RUMBLE);
+
+	ret = input_ff_create_memless(hap->input, NULL, aw8697_play);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to create force feedback\n");
+
+	return input_register_device(hap->input);
+}
+
+static int aw8697_suspend(struct device *dev)
+{
+	struct aw8697 *hap = dev_get_drvdata(dev);
+
+	WRITE_ONCE(hap->playing, false);
+	cancel_work_sync(&hap->play_work);
+	aw8697_play_work(&hap->play_work);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(aw8697_pm_ops, aw8697_suspend, NULL);
+
+static const struct of_device_id aw8697_of_match[] = {
+	{ .compatible = "awinic,aw8697" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw8697_of_match);
+
+static struct i2c_driver aw8697_driver = {
+	.driver = {
+		.name = "aw8697-haptics",
+		.of_match_table = aw8697_of_match,
+		.pm = pm_sleep_ptr(&aw8697_pm_ops),
+	},
+	.probe = aw8697_probe,
+};
+module_i2c_driver(aw8697_driver);
+
+MODULE_DESCRIPTION("Awinic AW8697 haptics driver");
+MODULE_LICENSE("GPL");
