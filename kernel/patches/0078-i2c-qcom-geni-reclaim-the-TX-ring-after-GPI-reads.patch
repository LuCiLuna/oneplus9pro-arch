From b03e6088e689fcfba3224797736a481e8b22def8 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 04:15:27 +0000
Subject: [PATCH 078/114] i2c: qcom-geni: reclaim the TX ring after GPI reads

For a read message the TX channel gets a config TRE and a GO TRE that is
linked to the RX DMA TRE, but neither asks for an event. Nothing then
moves the TX ring read pointer or completes the TX descriptor, so every
read leaks two TX ring elements and leaves a descriptor at the head of
the TX queue until some later write's event sweeps them up. A device
that only reads, like the Synaptics TouchComm touchscreen on the OnePlus
9 Pro, fills the ring and then fails transfers with "not enough space in
ring".

Set IEOB on the read GO TRE, as the downstream driver and the GPI SPI
path do, so the TX side gets its own EOB event, and give that
descriptor a callback that only records errors: the transfer is still
complete only once the RX data has landed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/dma/qcom/gpi.c             | 12 ++++++++++--
 drivers/i2c/busses/i2c-qcom-geni.c | 19 ++++++++++++++++++-
 2 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/drivers/dma/qcom/gpi.c b/drivers/dma/qcom/gpi.c
index a5055a6273a..5c1ad3d2830 100644
--- a/drivers/dma/qcom/gpi.c
+++ b/drivers/dma/qcom/gpi.c
@@ -1668,10 +1668,18 @@ static int gpi_create_i2c_tre(struct gchan *chan, struct gpi_desc *desc,
 
 		tre->dword[3] = u32_encode_bits(TRE_TYPE_GO, TRE_FLAGS_TYPE);
 
-		if (i2c->multi_msg)
+		/*
+		 * A read's GO TRE is the last TRE on the TX ring for that
+		 * message, so ask for an EOB event on it: without one nothing
+		 * reclaims the TX ring or completes the TX descriptor, and a
+		 * device that only reads (touchscreens) fills the ring.
+		 */
+		if (i2c->multi_msg) {
+			tre->dword[3] |= u32_encode_bits(1, TRE_FLAGS_IEOB);
 			tre->dword[3] |= u32_encode_bits(1, TRE_FLAGS_LINK);
-		else
+		} else {
 			tre->dword[3] |= u32_encode_bits(1, TRE_FLAGS_CHAIN);
+		}
 	}
 
 	if (i2c->op == I2C_READ || i2c->multi_msg == false) {
diff --git a/drivers/i2c/busses/i2c-qcom-geni.c b/drivers/i2c/busses/i2c-qcom-geni.c
index c4c6202ff15..41efb5ecdfe 100644
--- a/drivers/i2c/busses/i2c-qcom-geni.c
+++ b/drivers/i2c/busses/i2c-qcom-geni.c
@@ -616,6 +616,20 @@ static void i2c_gpi_cb_result(void *cb, const struct dmaengine_result *result)
 	complete(&gi2c->done);
 }
 
+/*
+ * TX side of a read (config + GO TREs): its EOB event only frees the TX ring,
+ * the transfer is done when the RX data has landed (i2c_gpi_cb_result()).
+ */
+static void i2c_gpi_tx_rd_cb_result(void *cb, const struct dmaengine_result *result)
+{
+	struct geni_i2c_dev *gi2c = cb;
+
+	if (result->result != DMA_TRANS_NOERROR) {
+		dev_err(gi2c->se.dev, "DMA txn failed:%d\n", result->result);
+		gi2c->err = -EIO;
+	}
+}
+
 static void geni_i2c_gpi_unmap(struct geni_i2c_dev *gi2c, struct i2c_msg *msg,
 			       void *tx_buf, dma_addr_t tx_addr,
 			       void *rx_buf, dma_addr_t rx_addr)
@@ -789,7 +803,10 @@ static int geni_i2c_gpi(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[],
 		goto err_config;
 	}
 
-	desc->callback_result = i2c_gpi_cb_result;
+	if (op == I2C_WRITE && msgs[msg_idx].flags & I2C_M_RD)
+		desc->callback_result = i2c_gpi_tx_rd_cb_result;
+	else
+		desc->callback_result = i2c_gpi_cb_result;
 	desc->callback_param = gi2c;
 
 	if (!((msgs[msg_idx].flags & I2C_M_RD) && op == I2C_WRITE))
