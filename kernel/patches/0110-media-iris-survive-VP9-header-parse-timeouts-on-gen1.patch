From 05dba1c719be3a5addb08b1a3ce6bbdcf69159c2 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:13:05 -0600
Subject: [PATCH 110/110] media: iris: survive VP9 header parse timeouts on
 gen1 firmware

Firefox lost hardware decoding of 4K60 VP9 within seconds. The firmware
was failing ordinary frames with HFI_ERR_SESSION_UNSUPPORTED_STREAM, which
iris treats as fatal, so Firefox fell back to software and YouTube stepped
the resolution down.

Turning on the firmware log gives the reason:

  VenusParseVP9FrmHdr(2322): HW polling reached max iterations.

so these frames are valid: the firmware gave up waiting for the bitstream
parser. With the firmware's error log enabled, timeouts still happened but
were no longer followed by a rejection, most likely because writing the
message lets the hardware finish before the firmware reads the result.
Both venus and the vendor driver enable that log by default, so iris has
been the odd one out. Do the same, and after a power collapse too since
that reboots the firmware.

Keep the session alive if a frame is rejected anyway once decoding has
started. Only a stream that never produced a frame is really unsupported,
and a damaged frame recovers at the next keyframe, which is far better than
losing the decoder. Report what the firmware logs, as it is now only errors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../platform/qcom/iris/iris_hfi_common.c      | 12 +++++++-
 .../platform/qcom/iris/iris_hfi_common.h      |  1 +
 .../qcom/iris/iris_hfi_gen1_command.c         | 28 +++++++++++++++++++
 .../qcom/iris/iris_hfi_gen1_defines.h         | 10 +++++++
 .../qcom/iris/iris_hfi_gen1_response.c        | 17 +++++++++--
 5 files changed, 64 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_hfi_common.c b/drivers/media/platform/qcom/iris/iris_hfi_common.c
index 8769ec61f11..e178be935d6 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_common.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_common.c
@@ -87,7 +87,11 @@ int iris_hfi_core_init(struct iris_core *core)
 	if (ret)
 		return ret;
 
-	return hfi_ops->sys_interframe_powercollapse(core);
+	ret = hfi_ops->sys_interframe_powercollapse(core);
+	if (ret)
+		return ret;
+
+	return hfi_ops->sys_debug_config ? hfi_ops->sys_debug_config(core) : 0;
 }
 
 irqreturn_t iris_hfi_isr(int irq, void *data)
@@ -167,6 +171,12 @@ int iris_hfi_pm_resume(struct iris_core *core)
 	if (ret)
 		goto err_suspend_hw;
 
+	if (ops->sys_debug_config) {
+		ret = ops->sys_debug_config(core);
+		if (ret)
+			goto err_suspend_hw;
+	}
+
 	return 0;
 
 err_suspend_hw:
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_common.h b/drivers/media/platform/qcom/iris/iris_hfi_common.h
index a27447eb251..424bde1a3a9 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_common.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_common.h
@@ -109,6 +109,7 @@ struct iris_hfi_sys_ops {
 	int (*sys_init)(struct iris_core *core);
 	int (*sys_image_version)(struct iris_core *core);
 	int (*sys_interframe_powercollapse)(struct iris_core *core);
+	int (*sys_debug_config)(struct iris_core *core);
 	int (*sys_pc_prep)(struct iris_core *core);
 
 	void (*sys_hfi_response_handler)(struct iris_core *core);
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
index f6e9cbfccd0..7738ed9be2a 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
@@ -79,6 +79,33 @@ static int iris_hfi_gen1_sys_interframe_powercollapse(struct iris_core *core)
 	return ret;
 }
 
+static int iris_hfi_gen1_sys_debug_config(struct iris_core *core)
+{
+	struct hfi_sys_set_property_pkt *pkt;
+	struct hfi_debug_config *hfi;
+	u32 packet_size;
+	int ret;
+
+	packet_size = struct_size(pkt, data, 1) + sizeof(*hfi);
+	pkt = kzalloc(packet_size, GFP_KERNEL);
+	if (!pkt)
+		return -ENOMEM;
+
+	hfi = (struct hfi_debug_config *)&pkt->data[1];
+
+	pkt->hdr.size = packet_size;
+	pkt->hdr.pkt_type = HFI_CMD_SYS_SET_PROPERTY;
+	pkt->num_properties = 1;
+	pkt->data[0] = HFI_PROPERTY_SYS_DEBUG_CONFIG;
+	hfi->config = HFI_DEBUG_MSG_ERROR | HFI_DEBUG_MSG_FATAL;
+	hfi->mode = HFI_DEBUG_MODE_QUEUE;
+
+	ret = iris_hfi_queue_cmd_write_locked(core, pkt, pkt->hdr.size);
+	kfree(pkt);
+
+	return ret;
+}
+
 static int iris_hfi_gen1_sys_pc_prep(struct iris_core *core)
 {
 	struct hfi_sys_pc_prep_pkt pkt;
@@ -1150,6 +1177,7 @@ static const struct iris_hfi_sys_ops iris_hfi_gen1_sys_ops = {
 	.sys_init = iris_hfi_gen1_sys_init,
 	.sys_image_version = iris_hfi_gen1_sys_image_version,
 	.sys_interframe_powercollapse = iris_hfi_gen1_sys_interframe_powercollapse,
+	.sys_debug_config = iris_hfi_gen1_sys_debug_config,
 	.sys_pc_prep = iris_hfi_gen1_sys_pc_prep,
 
 	.sys_hfi_response_handler = iris_hfi_gen1_response_handler,
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h b/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
index 275f3fea3d2..5e17d17533a 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
@@ -80,6 +80,7 @@
 #define HFI_BUFFER_INTERNAL_SCRATCH_1			0x7
 #define HFI_BUFFER_INTERNAL_SCRATCH_2			0x8
 
+#define HFI_PROPERTY_SYS_DEBUG_CONFIG			0x1
 #define HFI_PROPERTY_SYS_CODEC_POWER_PLANE_CTRL		0x5
 #define HFI_PROPERTY_SYS_IMAGE_VERSION			0x6
 
@@ -327,6 +328,15 @@ struct hfi_enable {
 	u32 enable;
 };
 
+#define HFI_DEBUG_MSG_ERROR				0x8
+#define HFI_DEBUG_MSG_FATAL				0x10
+#define HFI_DEBUG_MODE_QUEUE				0x1
+
+struct hfi_debug_config {
+	u32 config;
+	u32 mode;
+};
+
 struct hfi_profile_level {
 	u32 profile;
 	u32 level;
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
index bfd7495bf44..7eb1af43b7e 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
@@ -364,8 +364,18 @@ static void iris_hfi_gen1_session_etb_done(struct iris_inst *inst, void *packet)
 
 	if (pkt->shdr.error_type == HFI_ERR_SESSION_UNSUPPORTED_STREAM) {
 		buf->flags = V4L2_BUF_FLAG_ERROR;
-		iris_vb2_queue_error(inst);
-		iris_inst_change_state(inst, IRIS_INST_ERROR);
+
+		/*
+		 * Firmware also reports this when parsing one frame's header times
+		 * out, so only a stream that never decoded is really unsupported.
+		 */
+		if (inst->sequence_cap) {
+			dev_warn_ratelimited(inst->core->dev, "firmware rejected frame at %llu us\n",
+					     div_u64(m2m_buffer->vb.vb2_buf.timestamp, NSEC_PER_USEC));
+		} else {
+			iris_vb2_queue_error(inst);
+			iris_inst_change_state(inst, IRIS_INST_ERROR);
+		}
 	}
 
 	if (!(buf->attr & BUF_ATTR_QUEUED))
@@ -683,7 +693,8 @@ static void iris_hfi_gen1_flush_debug_queue(struct iris_core *core, u8 *packet)
 			struct hfi_msg_sys_debug_pkt *pkt =
 				(struct hfi_msg_sys_debug_pkt *)packet;
 
-			dev_dbg(core->dev, "%s", pkt->msg_data);
+			/* Messages start with a newline */
+			dev_warn_ratelimited(core->dev, "firmware: %s", pkt->msg_data + 1);
 		}
 	}
 }
