From e750fd9f830a68b1671fc9561644834978a9e492 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 8 Nov 2026 22:11:59 -0600
Subject: [PATCH 147/148] drm/panel: amb670yf01: add high-brightness mode

Stock reaches 600-800 nits by switching the panel into high-brightness mode
(0x53 = 0xe0) and using brightness levels 3538-4095, only from automatic
brightness in bright light, and never on panel revisions (ID2) below 3.

Add an hbm attribute that asks for it. While it is set and the panel is lit,
the brightness range maps onto 3538-4095, so the slider keeps working; the
normal range and the slider's maximum are unchanged. hbm_active reports
whether the panel is in it. The panel revision is read at power-on, and
high-brightness mode is left off when it can't be read.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../gpu/drm/panel/panel-samsung-amb670yf01.c  | 128 ++++++++++++++++--
 1 file changed, 119 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-amb670yf01.c b/drivers/gpu/drm/panel/panel-samsung-amb670yf01.c
index 8b38cdf3fae..c04850220f0 100644
--- a/drivers/gpu/drm/panel/panel-samsung-amb670yf01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-amb670yf01.c
@@ -42,8 +42,24 @@ struct amb670yf01 {
 	struct dentry *debugfs;
 	u8 rbuf[32];
 	int rlen;
+
+	/* High-brightness mode: asked for through sysfs, and what the panel is in */
+	bool hbm_requested;
+	bool hbm_active;
+	/* Panel revision (DCS 0xdb); stock keeps revisions up to 2 out of HBM */
+	u8 id2;
+	bool id2_read;
 };
 
+/*
+ * Brightness levels, from stock (oplus_bl.h): 0-2047 is normal mode. In
+ * high-brightness mode the panel takes 3538-4095, stock's 600-800 nit range.
+ */
+#define AMB670YF01_BL_MAX	2047
+#define AMB670YF01_HBM_MIN	3538
+#define AMB670YF01_HBM_MAX	4095
+#define AMB670YF01_HBM_MIN_ID2	3
+
 static const struct regulator_bulk_data amb670yf01_supplies[] = {
 	{ .supply = "vddio" },	/* 1.8V */
 	{ .supply = "vdd" },	/* 3.0V */
@@ -179,7 +195,23 @@ static int amb670yf01_on(struct amb670yf01 *ctx)
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1f, 0x00);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
 
-	return dsi_ctx.accum_err;
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	/* The sequence above leaves 0x53 at 0x28: high-brightness mode off */
+	ctx->hbm_active = false;
+
+	if (!ctx->id2_read) {
+		u8 id2;
+
+		if (mipi_dsi_dcs_read(ctx->dsi, 0xdb, &id2, 1) == 1) {
+			ctx->id2 = id2;
+			ctx->id2_read = true;
+			dev_info(&ctx->dsi->dev, "panel revision (ID2) 0x%02x\n", id2);
+		}
+	}
+
+	return 0;
 }
 
 static int amb670yf01_enable(struct drm_panel *panel)
@@ -321,36 +353,113 @@ static const struct drm_panel_funcs amb670yf01_panel_funcs = {
 	.get_modes = amb670yf01_get_modes,
 };
 
+static bool amb670yf01_hbm_capable(struct amb670yf01 *ctx)
+{
+	return ctx->id2_read && ctx->id2 >= AMB670YF01_HBM_MIN_ID2;
+}
+
 static int amb670yf01_bl_update_status(struct backlight_device *bl)
 {
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct amb670yf01 *ctx = bl_get_data(bl);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 	u16 brightness = backlight_get_brightness(bl);
+	bool hbm = ctx->hbm_requested && brightness &&
+		   amb670yf01_hbm_capable(ctx);
+	u8 ctrl[] = { MIPI_DCS_WRITE_CONTROL_DISPLAY, hbm ? 0xe0 : 0x28 };
+	u16 level = brightness;
 	int ret;
 
+	/* The slider keeps working in high-brightness mode, over its range */
+	if (hbm)
+		level = AMB670YF01_HBM_MIN +
+			brightness * (AMB670YF01_HBM_MAX - AMB670YF01_HBM_MIN) /
+			AMB670YF01_BL_MAX;
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+
+	/* vendor qcom,mdss-dsi-hbm-enter-switch / -exit-switch */
+	if (hbm != ctx->hbm_active)
+		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, ctrl, sizeof(ctrl));
+
+	ret = dsi_ctx.accum_err;
+	if (!ret)
+		ret = mipi_dsi_dcs_set_display_brightness_large(dsi, level);
+
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	return ret < 0 ? ret : 0;
+	if (ret < 0)
+		return ret;
+
+	ctx->hbm_active = hbm;
+	return 0;
 }
 
 static const struct backlight_ops amb670yf01_bl_ops = {
 	.update_status = amb670yf01_bl_update_status,
 };
 
-static struct backlight_device *amb670yf01_create_backlight(struct mipi_dsi_device *dsi)
+static struct backlight_device *amb670yf01_create_backlight(struct amb670yf01 *ctx)
 {
-	struct device *dev = &dsi->dev;
+	struct device *dev = &ctx->dsi->dev;
 	const struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
 		.brightness = 400,	/* vendor qcom,mdss-brightness-default-level */
-		.max_brightness = 2047,	/* normal max; above is high-brightness mode */
+		/* normal max; above is high-brightness mode, see the hbm attribute */
+		.max_brightness = AMB670YF01_BL_MAX,
 	};
 
-	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+	return devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
 					      &amb670yf01_bl_ops, &props);
 }
 
+/*
+ * hbm: 1 asks for high-brightness mode, which the panel then uses whenever it
+ * is lit. Stock enters it only from automatic brightness in bright light.
+ */
+static ssize_t hbm_show(struct device *dev, struct device_attribute *attr,
+			char *buf)
+{
+	struct amb670yf01 *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+
+	return sysfs_emit(buf, "%d\n", ctx->hbm_requested);
+}
+
+static ssize_t hbm_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct amb670yf01 *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+
+	ctx->hbm_requested = on;
+	ret = backlight_update_status(ctx->panel.backlight);
+
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(hbm);
+
+/* hbm_active: whether the panel is in high-brightness mode right now */
+static ssize_t hbm_active_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct amb670yf01 *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+
+	return sysfs_emit(buf, "%d\n", ctx->hbm_active);
+}
+static DEVICE_ATTR_RO(hbm_active);
+
+static struct attribute *amb670yf01_attrs[] = {
+	&dev_attr_hbm.attr,
+	&dev_attr_hbm_active.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(amb670yf01);
+
 #ifdef CONFIG_DEBUG_FS
 /*
  * Bring-up aid: echo "f0 5a 5a" > dcs sends a DCS write in HS mode,
@@ -475,7 +584,7 @@ static int amb670yf01_probe(struct mipi_dsi_device *dsi)
 	/* vendor qcom,mdss-dsi-lp11-init */
 	ctx->panel.prepare_prev_first = true;
 
-	ctx->panel.backlight = amb670yf01_create_backlight(dsi);
+	ctx->panel.backlight = amb670yf01_create_backlight(ctx);
 	if (IS_ERR(ctx->panel.backlight))
 		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
 				     "Failed to create backlight\n");
@@ -522,6 +631,7 @@ static struct mipi_dsi_driver amb670yf01_driver = {
 	.driver = {
 		.name = "panel-samsung-amb670yf01",
 		.of_match_table = amb670yf01_of_match,
+		.dev_groups = amb670yf01_groups,
 	},
 };
 module_mipi_dsi_driver(amb670yf01_driver);
-- 
2.56.0

