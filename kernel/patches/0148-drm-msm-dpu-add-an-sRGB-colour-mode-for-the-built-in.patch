From a2819ba62f9823e9266034db051b0559d67a0d30 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 8 Nov 2026 22:11:59 -0600
Subject: [PATCH 148/148] drm/msm/dpu: add an sRGB colour mode for the built-in
 panel

The OnePlus 9 Pro panel has Display P3 primaries, so unmanaged sRGB content
looks oversaturated (stock's default "Vivid" look). Stock's "Natural" mode
maps sRGB onto the panel's gamut in the display engine.

Add an msm.natural_colour parameter that programs the DSPP colour matrix
(PCC) of the built-in (DSI) display with the sRGB to Display P3 matrix
whenever the compositor sets no CTM itself. The built-in display always gets
its DSPPs reserved so the setting can change on the next commit, without a
modeset. A CTM from the compositor still takes precedence.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c | 67 ++++++++++++++++++++++--
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h |  3 ++
 2 files changed, 67 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index 42d0a529b4d..0ccb92b8437 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -790,6 +790,53 @@ static int _dpu_crtc_check_and_setup_lm_bounds(struct drm_crtc *crtc,
 	return 0;
 }
 
+/*
+ * natural_colour: show sRGB content with sRGB colours on a built-in panel
+ * with a wider native gamut, through the DSPP colour matrix (PCC), when the
+ * compositor sets no CTM of its own. It is applied on the next commit.
+ */
+static bool dpu_natural_colour;
+static atomic_t dpu_natural_colour_gen = ATOMIC_INIT(0);
+
+static int dpu_natural_colour_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (!ret)
+		atomic_inc(&dpu_natural_colour_gen);
+	return ret;
+}
+
+static const struct kernel_param_ops dpu_natural_colour_ops = {
+	.set = dpu_natural_colour_set,
+	.get = param_get_bool,
+};
+module_param_cb(natural_colour, &dpu_natural_colour_ops, &dpu_natural_colour, 0644);
+MODULE_PARM_DESC(natural_colour, "Map sRGB to the built-in panel's gamut when no CTM is set");
+
+/*
+ * sRGB to Display P3 (D65), the OnePlus 9 Pro panel's primaries, in the PCC's
+ * S3.15 format. Indexed [input].[output] like _dpu_crtc_get_pcc_coeff().
+ */
+static const struct dpu_hw_pcc_cfg dpu_srgb_to_p3_pcc = {
+	.r = { .r = 26950, .g = 1088,  .b = 560 },
+	.g = { .r = 5818,  .g = 31680, .b = 2372 },
+	.b = { .r = 0,     .g = 0,     .b = 29836 },
+};
+
+/* The built-in display: a DSI panel */
+static bool dpu_crtc_is_builtin(struct drm_crtc *crtc,
+				struct drm_crtc_state *crtc_state)
+{
+	struct drm_encoder *drm_enc;
+
+	drm_for_each_encoder_mask(drm_enc, crtc->dev, crtc_state->encoder_mask)
+		if (drm_enc->encoder_type == DRM_MODE_ENCODER_DSI)
+			return true;
+
+	return false;
+}
+
 static void _dpu_crtc_get_pcc_coeff(struct drm_crtc_state *state,
 		struct dpu_hw_pcc_cfg *cfg)
 {
@@ -853,10 +900,19 @@ static void _dpu_crtc_setup_cp_blocks(struct drm_crtc *crtc)
 	struct dpu_hw_gc_lut *gc_lut;
 	struct dpu_hw_ctl *ctl;
 	struct dpu_hw_dspp *dspp;
+	struct dpu_crtc *dpu_crtc = to_dpu_crtc(crtc);
+	int natural_gen = atomic_read(&dpu_natural_colour_gen);
+	bool natural = false, natural_changed = false;
 	int i;
 
+	if (!state->ctm && dpu_crtc_is_builtin(crtc, state)) {
+		natural = READ_ONCE(dpu_natural_colour);
+		natural_changed = natural_gen != dpu_crtc->natural_colour_gen;
+		dpu_crtc->natural_colour_gen = natural_gen;
+	}
 
-	if (!state->color_mgmt_changed && !drm_atomic_crtc_needs_modeset(state))
+	if (!state->color_mgmt_changed && !natural_changed &&
+	    !drm_atomic_crtc_needs_modeset(state))
 		return;
 
 	for (i = 0; i < cstate->num_mixers; i++) {
@@ -867,7 +923,10 @@ static void _dpu_crtc_setup_cp_blocks(struct drm_crtc *crtc)
 			continue;
 
 		if (dspp->ops.setup_pcc) {
-			if (!state->ctm) {
+			if (natural) {
+				cfg = dpu_srgb_to_p3_pcc;
+				dspp->ops.setup_pcc(dspp, &cfg);
+			} else if (!state->ctm) {
 				dspp->ops.setup_pcc(dspp, NULL);
 			} else {
 				_dpu_crtc_get_pcc_coeff(state, &cfg);
@@ -1423,7 +1482,9 @@ static struct msm_display_topology dpu_crtc_get_topology(
 	else
 		topology.num_lm = 1;
 
-	if (crtc_state->ctm || crtc_state->gamma_lut)
+	/* The built-in display always gets them, for natural_colour */
+	if (crtc_state->ctm || crtc_state->gamma_lut ||
+	    dpu_crtc_is_builtin(crtc, crtc_state))
 		topology.num_dspp = topology.num_lm;
 
 	return topology;
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
index 6eaba5696e8..56d0f3a8dbd 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
@@ -183,6 +183,9 @@ struct dpu_crtc {
 	struct dpu_core_perf_params cur_perf;
 
 	struct dpu_crtc_smmu_state_data smmu_state;
+
+	/* natural_colour setting last programmed into this CRTC's PCC */
+	int natural_colour_gen;
 };
 
 #define to_dpu_crtc(x) container_of(x, struct dpu_crtc, base)
-- 
2.56.0

