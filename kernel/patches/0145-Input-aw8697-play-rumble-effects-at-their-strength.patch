From 31d288ac0f039a2c3b8423c0fafdd77447f6d7ca Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Fri, 6 Nov 2026 04:37:07 -0600
Subject: [PATCH] Input: aw8697: play rumble effects at their strength

Every rumble played at the vendor's drive level, whatever its magnitude,
so a desktop-mode trackpad couldn't have a soft click or a faint ripple
next to firmer key presses.

Map the stronger of the two rumble magnitudes onto the continuous-mode
drive level, with full scale at the vendor's level so feedbackd's
events feel as before. Scale the overdrive with it: overdrive spins the
motor up at the start of each pulse, and at the full value a short soft
tick was mostly overdrive and felt as strong as a full one. A level
that changes while the motor runs is written straight away.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/misc/aw8697.c | 38 ++++++++++++++++++++++++++++++++-----
 1 file changed, 33 insertions(+), 5 deletions(-)

diff --git a/drivers/input/misc/aw8697.c b/drivers/input/misc/aw8697.c
index 03ef71fc8e2..0fcae7be5ac 100644
--- a/drivers/input/misc/aw8697.c
+++ b/drivers/input/misc/aw8697.c
@@ -80,6 +80,8 @@ struct aw8697 {
 	struct work_struct play_work;
 	bool playing;
 	bool active;
+	unsigned int level;	/* drive level asked for, 1..AW8697_DRV_LVL */
+	unsigned int set_level;	/* drive level the chip runs at */
 };
 
 static const struct regmap_config aw8697_regmap_config = {
@@ -126,6 +128,21 @@ static int aw8697_init(struct aw8697 *hap)
 	return regmap_set_bits(hap->regmap, AW8697_REG_ADCTEST, AW8697_ADCTEST_VBAT_HW_COMP);
 }
 
+/* Overdrive spins the motor up at the start of each pulse: scale it with the level, or a
+ * short soft tick would be mostly overdrive and feel as strong as a full one. */
+static int aw8697_set_level(struct aw8697 *hap, unsigned int level)
+{
+	int ret;
+
+	ret = regmap_write(hap->regmap, AW8697_REG_DRV_LVL, level);
+	if (!ret)
+		ret = regmap_write(hap->regmap, AW8697_REG_DRV_LVL_OV,
+				   DIV_ROUND_UP(level * AW8697_DRV_LVL_OV, AW8697_DRV_LVL));
+	if (!ret)
+		hap->set_level = level;
+	return ret;
+}
+
 static int aw8697_start(struct aw8697 *hap)
 {
 	u32 f_pre = 1000000000 / (AW8697_F0_DECIHZ * AW8697_F0_COEFF);
@@ -143,8 +160,6 @@ static int aw8697_start(struct aw8697 *hap)
 		{ AW8697_REG_BEMF_VTHL_H, 0x03 },
 		{ AW8697_REG_BEMF_VTHL_L, 0xf8 },
 		{ AW8697_REG_TIME_NZC, 0x23 },
-		{ AW8697_REG_DRV_LVL, AW8697_DRV_LVL },
-		{ AW8697_REG_DRV_LVL_OV, AW8697_DRV_LVL_OV },
 	};
 	int ret;
 
@@ -162,6 +177,10 @@ static int aw8697_start(struct aw8697 *hap)
 	if (ret)
 		return ret;
 
+	ret = aw8697_set_level(hap, READ_ONCE(hap->level));
+	if (ret)
+		return ret;
+
 	ret = regmap_update_bits(hap->regmap, AW8697_REG_BEMF_NUM,
 				 AW8697_BEMF_NUM_BRK, AW8697_CONT_NUM_BRK);
 	if (ret)
@@ -196,9 +215,13 @@ static void aw8697_play_work(struct work_struct *work)
 {
 	struct aw8697 *hap = container_of(work, struct aw8697, play_work);
 	bool playing = READ_ONCE(hap->playing);
+	unsigned int level = READ_ONCE(hap->level);
 
-	if (playing == hap->active)
+	if (playing == hap->active) {
+		if (playing && level != hap->set_level)
+			aw8697_set_level(hap, level);
 		return;
+	}
 
 	if (playing) {
 		int ret = aw8697_start(hap);
@@ -217,9 +240,13 @@ static void aw8697_play_work(struct work_struct *work)
 static int aw8697_play(struct input_dev *input, void *data, struct ff_effect *effect)
 {
 	struct aw8697 *hap = input_get_drvdata(input);
+	unsigned int mag = max(effect->u.rumble.strong_magnitude,
+			       effect->u.rumble.weak_magnitude);
 
-	WRITE_ONCE(hap->playing, effect->u.rumble.strong_magnitude ||
-				 effect->u.rumble.weak_magnitude);
+	/* Full scale is the vendor's drive level; weaker rumbles are softer */
+	if (mag)
+		WRITE_ONCE(hap->level, max(1U, DIV_ROUND_UP(mag * AW8697_DRV_LVL, 0xffff)));
+	WRITE_ONCE(hap->playing, mag != 0);
 	schedule_work(&hap->play_work);
 
 	return 0;
@@ -246,6 +273,7 @@ static int aw8697_probe(struct i2c_client *client)
 		return -ENOMEM;
 
 	hap->dev = dev;
+	hap->level = AW8697_DRV_LVL;
 	INIT_WORK(&hap->play_work, aw8697_play_work);
 	i2c_set_clientdata(client, hap);
 
-- 
2.56.0

