From 2426cfa3d4a76d51de882e65e8f93cdd577958ed Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Fri, 30 Oct 2026 09:16:01 +0000
Subject: [PATCH 012/110] HACK: OnePlus 9 Pro bring-up: built-in DTB, Gunyah
 wdt, splash autorefresh

The stock ABL only boots DTBs its downstream DTBO overlay applies to, so
hand it the stock DTB and switch to a built-in mainline DTB in
setup_machine_fdt(), carrying over /chosen and /memory. Disable the Gunyah
watchdog early and optionally force a bite (op9.bite_after=) to get a
RAM dump. Real RAM banks in the board DT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/Kconfig                            |  13 +++
 .../dts/qcom/sm8350-oneplus-lemonadep.dts     |  19 +++-
 arch/arm64/kernel/Makefile                    |   1 +
 arch/arm64/kernel/op9-builtin-dtb.S           |   9 ++
 arch/arm64/kernel/setup.c                     |  63 ++++++++++-
 drivers/soc/qcom/Makefile                     |   1 +
 drivers/soc/qcom/op9-splash-autorefresh.c     | 107 ++++++++++++++++++
 7 files changed, 210 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm64/kernel/op9-builtin-dtb.S
 create mode 100644 drivers/soc/qcom/op9-splash-autorefresh.c

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index cab741a695f..46235c323bc 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2594,6 +2594,19 @@ config DMI
 	  However, even with this option, the resultant kernel should
 	  continue to boot on existing non-UEFI platforms.
 
+config ARM64_OP9_BUILTIN_DTB
+	bool "OnePlus 9 Pro bring-up: boot with a built-in DTB"
+	help
+	  The OnePlus 9 Pro's stock ABL only boots DTBs its downstream DTBO
+	  overlay can be applied to. With this enabled, give ABL the stock DTB
+	  and the kernel switches to the built-in mainline DTB at
+	  ARM64_OP9_BUILTIN_DTB_PATH, carrying over /chosen boot parameters and
+	  the /memory banks from the DTB ABL passed.
+
+config ARM64_OP9_BUILTIN_DTB_PATH
+	string "Path to the built-in DTB"
+	depends on ARM64_OP9_BUILTIN_DTB
+
 endmenu # "Boot options"
 
 menu "Power management options"
diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index 87d94653c61..78f09af8dfd 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -13,9 +13,24 @@ / {
 	compatible = "oneplus,lemonadep", "qcom,sm8350";
 	model = "OnePlus 9 Pro";
 
-	/* Needed by the stock ABL to accept an appended DTB (values from dtbo entry 2) */
+	/*
+	 * Stock ABL selects the SoC DTB by msm-id (no board-id here: a board-id
+	 * makes ABL treat this as a board DTB and look for a separate SoC DTB).
+	 */
 	qcom,msm-id = <0x19f 0x20001>;
-	qcom,board-id = <0x10008 0>;
+	/* OnePlus ABL rejects DTBs without a matching project ("oplus dtsi not match"); 0x4d67 = 19815 */
+	oplus,dtsi_no = <0x4d67 0x2085a>;
+
+	/*
+	 * BRING-UP: RAM banks as the stock ABL reports them on this 12 GB unit
+	 * (live /sys/firmware/fdt "memory" node), in case ABL does not fill in
+	 * a "memory@80000000" node. 8 GB units differ.
+	 */
+	memory@80000000 {
+		reg = <0x0 0x80000000 0x0 0x37500000>,
+		      <0x2 0x00000000 0x1 0x80000000>,
+		      <0x0 0xc0000000 0x1 0x40000000>;
+	};
 };
 
 &display_panel {
diff --git a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
index ea66339435b..ce853ef7737 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -90,3 +90,4 @@ endif
 
 # for cleaning
 subdir- += vdso vdso32
+obj-$(CONFIG_ARM64_OP9_BUILTIN_DTB)	+= op9-builtin-dtb.o
diff --git a/arch/arm64/kernel/op9-builtin-dtb.S b/arch/arm64/kernel/op9-builtin-dtb.S
new file mode 100644
index 00000000000..5a69ff08d31
--- /dev/null
+++ b/arch/arm64/kernel/op9-builtin-dtb.S
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* BRING-UP: built-in mainline DTB for the OnePlus 9 Pro (see setup.c) */
+	.section .rodata, "a"
+	.balign 8
+	.global __op9_dtb_start
+__op9_dtb_start:
+	.incbin CONFIG_ARM64_OP9_BUILTIN_DTB_PATH
+	.global __op9_dtb_end
+__op9_dtb_end:
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 29c6100f0c5..b307d0a373b 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -27,6 +27,7 @@
 #include <linux/proc_fs.h>
 #include <linux/memblock.h>
 #include <linux/of_fdt.h>
+#include <linux/libfdt.h>
 #include <linux/efi.h>
 #include <linux/psci.h>
 #include <linux/sched/task.h>
@@ -167,15 +168,74 @@ static void __init smp_build_mpidr_hash(void)
 		pr_warn("Large number of MPIDR hash buckets detected\n");
 }
 
+#ifdef CONFIG_ARM64_OP9_BUILTIN_DTB
+/*
+ * BRING-UP: the OnePlus 9 Pro's ABL refuses DTBs its downstream DTBO overlay
+ * cannot be applied to. Hand it the stock DTB and boot with a built-in
+ * mainline DTB instead, carrying over what ABL legitimately provides.
+ */
+extern const u8 __op9_dtb_start[];
+static u8 op9_fdt[SZ_1M] __aligned(SZ_4K);
+
+static const char * const op9_chosen_props[] = {
+	"bootargs", "linux,initrd-start", "linux,initrd-end", "kaslr-seed", "rng-seed",
+};
+
+static void * __init op9_builtin_fdt(const void *boot)
+{
+	int bc, oc, bm, om, len, i;
+	const void *p;
+
+	if (fdt_open_into(__op9_dtb_start, op9_fdt, sizeof(op9_fdt)))
+		return NULL;
+
+	bc = fdt_path_offset(boot, "/chosen");
+	oc = fdt_path_offset(op9_fdt, "/chosen");
+	if (oc < 0)
+		oc = fdt_add_subnode(op9_fdt, 0, "chosen");
+	if (bc >= 0 && oc >= 0) {
+		for (i = 0; i < ARRAY_SIZE(op9_chosen_props); i++) {
+			p = fdt_getprop(boot, bc, op9_chosen_props[i], &len);
+			if (p)
+				fdt_setprop(op9_fdt, oc, op9_chosen_props[i], p, len);
+		}
+	}
+
+	bm = fdt_path_offset(boot, "/memory");
+	om = fdt_path_offset(op9_fdt, "/memory");
+	if (bm >= 0 && om >= 0) {
+		p = fdt_getprop(boot, bm, "reg", &len);
+		if (p)
+			fdt_setprop(op9_fdt, om, "reg", p, len);
+	}
+
+	return op9_fdt;
+}
+#endif
+
 static void __init setup_machine_fdt(phys_addr_t dt_phys)
 {
 	int size = 0;
 	void *dt_virt = fixmap_remap_fdt(dt_phys, &size, PAGE_KERNEL);
 	const char *name;
 
+	bool builtin = false;
+
 	if (dt_virt)
 		memblock_reserve(dt_phys, size);
 
+#ifdef CONFIG_ARM64_OP9_BUILTIN_DTB
+	if (dt_virt) {
+		void *b = op9_builtin_fdt(dt_virt);
+
+		if (b) {
+			dt_virt = b;
+			dt_phys = __pa_symbol(b);
+			builtin = true;
+		}
+	}
+#endif
+
 	/*
 	 * dt_virt is a fixmap address, hence __pa(dt_virt) can't be used.
 	 * Pass dt_phys directly.
@@ -197,7 +257,8 @@ static void __init setup_machine_fdt(phys_addr_t dt_phys)
 	}
 
 	/* Early fixups are done, map the FDT as read-only now */
-	fixmap_remap_fdt(dt_phys, &size, PAGE_KERNEL_RO);
+	if (!builtin)
+		fixmap_remap_fdt(dt_phys, &size, PAGE_KERNEL_RO);
 
 	name = of_flat_dt_get_machine_name();
 	if (!name)
diff --git a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
index 798643be359..cab124305a0 100644
--- a/drivers/soc/qcom/Makefile
+++ b/drivers/soc/qcom/Makefile
@@ -41,3 +41,4 @@ qcom_ice-objs			+= ice.o
 obj-$(CONFIG_QCOM_INLINE_CRYPTO_ENGINE)	+= qcom_ice.o
 obj-$(CONFIG_QCOM_PBS) +=	qcom-pbs.o
 obj-$(CONFIG_QCOM_UBWC_CONFIG) += ubwc_config.o
+obj-$(CONFIG_ARCH_QCOM) += op9-splash-autorefresh.o
diff --git a/drivers/soc/qcom/op9-splash-autorefresh.c b/drivers/soc/qcom/op9-splash-autorefresh.c
new file mode 100644
index 00000000000..c5582dda518
--- /dev/null
+++ b/drivers/soc/qcom/op9-splash-autorefresh.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BRING-UP HACK: the OnePlus 9 Pro panel is a DSI command-mode panel, so the
+ * bootloader's framebuffer only reaches the glass when the display controller
+ * pushes a frame. Turn on DPU INTF tear-check autorefresh for the DSI
+ * interfaces the bootloader left running, so simple-framebuffer output (and
+ * the kernel console) becomes visible before a real panel driver exists.
+ *
+ * Addresses are absolute: MDSS at 0x0ae00000, INTF_1/INTF_2 (DSI0/DSI1) at
+ * +0x36000/+0x37000 (downstream qcom,sde-intf-off; mainline catalog offsets
+ * are relative to the "mdp" region at 0x0ae01000).
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/hrtimer.h>
+#include <linux/kstrtox.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+
+#define INTF_TEAR_TEAR_CHECK_EN		0x284
+#define INTF_TEAR_AUTOREFRESH_CONFIG	0x2b4
+
+static const phys_addr_t op9_dsi_intf[] = { 0x0ae36000, 0x0ae37000 };
+
+/*
+ * BRING-UP: op9.bite_after=<seconds> forces a Gunyah watchdog bite after that
+ * long. On this firmware a bite lands in Qualcomm RAM-dump mode (05c6:900e),
+ * so the kernel log can be pulled out of RAM with edl.
+ */
+static unsigned int op9_bite_after;
+static struct hrtimer op9_bite_timer;
+
+static int __init op9_bite_setup(char *s)
+{
+	return kstrtouint(s, 0, &op9_bite_after);
+}
+early_param("op9.bite_after", op9_bite_setup);
+
+static enum hrtimer_restart op9_bite(struct hrtimer *t)
+{
+	struct arm_smccc_res res;
+	u32 fn = ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32,
+				    ARM_SMCCC_OWNER_VENDOR_HYP, 0);
+
+	pr_emerg("op9: forcing Gunyah watchdog bite for RAM dump\n");
+	arm_smccc_1_1_smc(fn | 0x5, BIT(1), 0, &res);			/* disable */
+	arm_smccc_1_1_smc(fn | 0x8, 1, 1, &res);			/* 1ms */
+	arm_smccc_1_1_smc(fn | 0x5, BIT(1) | BIT(0), 0, &res);		/* enable */
+	arm_smccc_1_1_smc(fn | 0x7, 0, 0, &res);			/* ping */
+	return HRTIMER_NORESTART;
+}
+
+static int __init op9_splash_autorefresh(void)
+{
+	int i;
+
+	if (!of_machine_is_compatible("oneplus,lemonadep"))
+		return 0;
+
+	/*
+	 * BRING-UP: the Gunyah/Haven hypervisor watchdog resets the phone ~10s
+	 * after handoff unless pinged. Disable it here (same SMCCC call as
+	 * drivers/watchdog/gunyah_wdt.c) until gunyah-wdt takes over.
+	 */
+	{
+		struct arm_smccc_res res;
+
+		arm_smccc_1_1_smc(ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_32,
+						     ARM_SMCCC_OWNER_VENDOR_HYP, 0x0005),
+				  BIT(1), 0, &res);
+		pr_info("op9: gunyah wdt disable -> %ld\n", (long)res.a0);
+	}
+
+	if (op9_bite_after) {
+		hrtimer_setup(&op9_bite_timer, op9_bite, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+		hrtimer_start(&op9_bite_timer, ktime_set(op9_bite_after, 0), HRTIMER_MODE_REL);
+		pr_info("op9: watchdog bite armed for %us\n", op9_bite_after);
+	}
+
+
+	for (i = 0; i < ARRAY_SIZE(op9_dsi_intf); i++) {
+		void __iomem *intf = ioremap(op9_dsi_intf[i], 0x300);
+		u32 te, ar;
+
+		if (!intf)
+			continue;
+
+		te = readl_relaxed(intf + INTF_TEAR_TEAR_CHECK_EN);
+		ar = readl_relaxed(intf + INTF_TEAR_AUTOREFRESH_CONFIG);
+		pr_info("op9-autorefresh: intf@%pa tear_check=%#x autorefresh=%#x\n",
+			&op9_dsi_intf[i], te, ar);
+
+		if (te & BIT(0)) {
+			writel(BIT(31) | 1, intf + INTF_TEAR_AUTOREFRESH_CONFIG);
+			pr_info("op9-autorefresh: enabled on intf@%pa\n", &op9_dsi_intf[i]);
+		}
+		iounmap(intf);
+
+	}
+
+	return 0;
+}
+early_initcall(op9_splash_autorefresh);
