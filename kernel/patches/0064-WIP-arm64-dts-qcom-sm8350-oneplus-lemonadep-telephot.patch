From c9c3ce3a96bf382c6d376e2ef4c15a06fdcf3e09 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:46:02 +0000
Subject: [PATCH 064/110] WIP: arm64: dts: qcom: sm8350-oneplus-lemonadep:
 telephoto camera

OV08A10 on CCI1 bus 0 and CSIPHY0 (two lanes): MCLK2, reset GPIO 17,
AVDD switched from BOB by GPIO 93, DVDD from pm8008i L1 at 1.2 V.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8350-oneplus-lemonadep.dts     | 79 +++++++++++++++++++
 1 file changed, 79 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
index 3f2e22ce24e..3395e5688f4 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonadep.dts
@@ -47,6 +47,19 @@ vreg_cam_front_vana: regulator-cam-front-vana {
 	};
 
 	/* Main camera rails: GPIO-switched load switches/LDOs */
+	/* Telephoto camera analog supply, switched from BOB by GPIO 93 */
+	vreg_cam_tele_avdd: regulator-cam-tele-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_tele_avdd";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 93 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-0 = <&cam_tele_avdd_en>;
+		pinctrl-names = "default";
+	};
+
 	vreg_cam_main_avdd: regulator-cam-main-avdd {
 		compatible = "regulator-fixed";
 		regulator-name = "cam_main_avdd";
@@ -297,6 +310,15 @@ csiphy2_ep: endpoint {
 			};
 		};
 
+		/* Telephoto camera on CSIPHY0 */
+		port@0 {
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				remote-endpoint = <&ov08a10_ep>;
+			};
+		};
+
 		/* Front camera on CSIPHY5 */
 		port@5 {
 			csiphy5_ep: endpoint {
@@ -401,6 +423,36 @@ &cci1 {
 };
 
 &cci1_i2c0 {
+	/* Telephoto camera, Qtech OV08A10 */
+	camera@36 {
+		compatible = "ovti,ov08a10";
+		reg = <0x36>;
+
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		reset-gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk2_active>, <&cam_tele_reset>;
+		pinctrl-names = "default";
+
+		dovdd-supply = <&vreg_l5i>;
+		avdd-supply = <&vreg_cam_tele_avdd>;
+		dvdd-supply = <&vreg_l1i>;
+
+		rotation = <90>;
+		orientation = <1>;
+
+		port {
+			ov08a10_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <800000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+
 	/* Telephoto module calibration */
 	eeprom@50 {
 		compatible = "atmel,24c128";
@@ -687,6 +739,27 @@ cam_wide_avdd_en: cam-wide-avdd-en-state {
 		bias-disable;
 	};
 
+	cam_tele_reset: cam-tele-reset-state {
+		pins = "gpio17";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk2_active: cam-mclk2-active-state {
+		pins = "gpio102";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_tele_avdd_en: cam-tele-avdd-en-state {
+		pins = "gpio93";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	cam_mclk3_active: cam-mclk3-active-state {
 		pins = "gpio103";
 		function = "cam_mclk";
@@ -744,6 +817,12 @@ &usb_1_dwc3 {
 
 
 /* Not populated on lemonadep (no ACK at 0x0c/0x0d); no camera uses it */
+/* pm8008i L1 only feeds the telephoto sensor core (DVDD, 1.2 V) */
+&vreg_l1i {
+	regulator-min-microvolt = <1200000>;
+	regulator-max-microvolt = <1200000>;
+};
+
 &pm8008j {
 	status = "disabled";
 };
