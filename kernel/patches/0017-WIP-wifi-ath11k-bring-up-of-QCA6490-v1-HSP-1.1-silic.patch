From a58728c4d0eaa721143755015eb84ba641602c38 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Fri, 30 Oct 2026 13:03:40 +0000
Subject: [PATCH 017/110] WIP: wifi: ath11k: bring-up of QCA6490 v1 (HSP 1.1)
 silicon

Accept SoC version 1.0x10, run it with QCA6390 UMAC registers plus WCN6855
copy-engine addresses, skip regdb download and nm_modem/mem_cfg_mode host
capabilities on Qualcomm hosts, and collect RDDM dumps of init crashes.
Firmware (vendor v1 amss.bin/m3.bin + /odm/etc/wifi/bdwlan.elf) reaches
HTC/WMI service ready but asserts after WMI_INIT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/ath/ath11k/core.c | 20 ++++++++++++++++++++
 drivers/net/wireless/ath/ath11k/core.h |  2 ++
 drivers/net/wireless/ath/ath11k/pci.c  | 21 ++++++++++++++++++++-
 drivers/net/wireless/ath/ath11k/qmi.c  | 18 +++++++++++++-----
 4 files changed, 55 insertions(+), 6 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/core.c b/drivers/net/wireless/ath/ath11k/core.c
index 8039124e783..874767ace15 100644
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -2538,6 +2538,9 @@ static void ath11k_core_reset(struct work_struct *work)
 
 	if (!(test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags))) {
 		ath11k_warn(ab, "ignore reset dev flags 0x%lx\n", ab->dev_flags);
+		/* BRING-UP: still collect the RDDM dump of a crash during init */
+		if (ab->qcom_platform)
+			ath11k_coredump_collect(ab);
 		return;
 	}
 
@@ -2623,6 +2626,23 @@ static int ath11k_init_hw_params(struct ath11k_base *ab)
 
 	ab->hw_params = *hw_params;
 
+	/*
+	 * BRING-UP: early QCA6490 (v1) silicon keeps the QCA6390 UMAC ring
+	 * layout but has the copy engines where WCN6855 has them.
+	 */
+	if (ab->qcom_platform && ab->hw_rev == ATH11K_HW_QCA6390_HW20) {
+		static struct ath11k_hw_regs qca6490v1_regs;
+
+		qca6490v1_regs = qca6390_regs;
+		qca6490v1_regs.hal_seq_wcss_umac_ce0_src_reg = wcn6855_regs.hal_seq_wcss_umac_ce0_src_reg;
+		qca6490v1_regs.hal_seq_wcss_umac_ce0_dst_reg = wcn6855_regs.hal_seq_wcss_umac_ce0_dst_reg;
+		qca6490v1_regs.hal_seq_wcss_umac_ce1_src_reg = wcn6855_regs.hal_seq_wcss_umac_ce1_src_reg;
+		qca6490v1_regs.hal_seq_wcss_umac_ce1_dst_reg = wcn6855_regs.hal_seq_wcss_umac_ce1_dst_reg;
+		ab->hw_params.regs = &qca6490v1_regs;
+		ab->hw_params.fix_l1ss = false;
+		ath11k_info(ab, "QCA6490 v1: QCA6390 UMAC layout with WCN6855 copy engines\n");
+	}
+
 	ath11k_info(ab, "%s\n", ab->hw_params.name);
 
 	return 0;
diff --git a/drivers/net/wireless/ath/ath11k/core.h b/drivers/net/wireless/ath/ath11k/core.h
index a0d725923ef..b3b14232f8c 100644
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -923,6 +923,8 @@ enum ath11k_pm_policy {
 /* Master structure to hold the hw data which may be used in core module */
 struct ath11k_base {
 	enum ath11k_hw_rev hw_rev;
+	/* Host is a Qualcomm SoC providing the sleep clock (QCA6490 v1 phones) */
+	bool qcom_platform;
 	enum ath11k_firmware_mode fw_mode;
 	struct platform_device *pdev;
 	struct device *dev;
diff --git a/drivers/net/wireless/ath/ath11k/pci.c b/drivers/net/wireless/ath/ath11k/pci.c
index a163168f361..1723b2c0387 100644
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -33,6 +33,12 @@
 
 #define TCSR_SOC_HW_SUB_VER	0x1910010
 
+/* BRING-UP knobs for early QCA6490 (v1) silicon */
+static int op9_profile;	/* 0: WCN6855 hw2.1, 1: QCA6390 hw2.0 */
+module_param(op9_profile, int, 0444);
+static bool op9_fix_l1ss;
+module_param(op9_fix_l1ss, bool, 0444);
+
 static const struct pci_device_id ath11k_pci_id_table[] = {
 	{ PCI_VDEVICE(QCOM, QCA6390_DEVICE_ID) },
 	{ PCI_VDEVICE(QCOM, WCN6855_DEVICE_ID) },
@@ -385,7 +391,7 @@ static void ath11k_pci_sw_reset(struct ath11k_base *ab, bool power_on)
 		ath11k_pci_enable_ltssm(ab);
 		ath11k_pci_clear_all_intrs(ab);
 		ath11k_pci_set_wlaon_pwr_ctrl(ab);
-		if (ab->hw_params.fix_l1ss)
+		if (ab->hw_params.fix_l1ss || (ab->qcom_platform && op9_fix_l1ss))
 			ath11k_pci_fix_l1ss(ab);
 	}
 
@@ -1035,6 +1041,19 @@ static int ath11k_pci_probe(struct pci_dev *pdev,
 		ath11k_pci_read_hw_version(ab, &soc_hw_version_major,
 					   &soc_hw_version_minor);
 		switch (soc_hw_version_major) {
+		case 1:
+			/*
+			 * Early QCA6490 (HSP 1.x) silicon, e.g. OnePlus 9 Pro. Run it
+			 * with the QCA6390 parameters (register layout of the v1 die) and the
+			 * vendor's v1 firmware.
+			 */
+			if (soc_hw_version_minor != 0x10)
+				goto unsupported_wcn6855_soc;
+			ab->hw_rev = op9_profile ? ATH11K_HW_QCA6390_HW20 : ATH11K_HW_WCN6855_HW21;
+			ath11k_info(ab, "QCA6490 v1 SoC (1.%x), profile %d, fix_l1ss %d\n",
+				    soc_hw_version_minor, op9_profile, op9_fix_l1ss);
+			ab->qcom_platform = true;
+			break;
 		case 2:
 			switch (soc_hw_version_minor) {
 			case 0x00:
diff --git a/drivers/net/wireless/ath/ath11k/qmi.c b/drivers/net/wireless/ath/ath11k/qmi.c
index 7dc07339b95..1b95c53bdd6 100644
--- a/drivers/net/wireless/ath/ath11k/qmi.c
+++ b/drivers/net/wireless/ath/ath11k/qmi.c
@@ -30,6 +30,10 @@ module_param_named(cold_boot_cal, ath11k_cold_boot_cal, bool, 0644);
 MODULE_PARM_DESC(cold_boot_cal,
 		 "Decrease the channel switch time but increase the driver load time (Default: true)");
 
+/* BRING-UP knob for early QCA6490 (v1) silicon */
+static bool op9_no_regdb;
+module_param(op9_no_regdb, bool, 0444);
+
 static const struct qmi_elem_info qmi_wlanfw_host_cap_req_msg_v01_ei[] = {
 	{
 		.data_type	= QMI_OPT_FLAG,
@@ -1719,8 +1723,11 @@ int ath11k_qmi_host_cap_send(struct ath11k_base *ab)
 
 	req.num_clients_valid = 1;
 	req.num_clients = 1;
-	req.mem_cfg_mode = ab->qmi.target_mem_mode;
-	req.mem_cfg_mode_valid = 1;
+	/* QCA6490 v1 (vendor driver never sets it): keep the firmware's default memory layout */
+	if (!ab->qcom_platform) {
+		req.mem_cfg_mode = ab->qmi.target_mem_mode;
+		req.mem_cfg_mode_valid = 1;
+	}
 	req.bdf_support_valid = 1;
 	req.bdf_support = 1;
 
@@ -1739,7 +1746,7 @@ int ath11k_qmi_host_cap_send(struct ath11k_base *ab)
 	req.cal_done_valid = 1;
 	req.cal_done = ab->qmi.cal_done;
 
-	if (ab->hw_params.internal_sleep_clock) {
+	if (ab->hw_params.internal_sleep_clock && !ab->qcom_platform) {
 		req.nm_modem_valid = 1;
 
 		/* Notify firmware that this is non-qualcomm platform. */
@@ -1756,7 +1763,8 @@ int ath11k_qmi_host_cap_send(struct ath11k_base *ab)
 	if (ab->hw_params.global_reset)
 		req.nm_modem |= PLATFORM_CAP_PCIE_GLOBAL_RESET;
 
-	req.nm_modem |= PLATFORM_CAP_PCIE_PME_D3COLD;
+	if (!ab->qcom_platform)
+		req.nm_modem |= PLATFORM_CAP_PCIE_PME_D3COLD;
 
 	ath11k_dbg(ab, ATH11K_DBG_QMI, "host cap request\n");
 
@@ -2976,7 +2984,7 @@ static int ath11k_qmi_event_load_bdf(struct ath11k_qmi *qmi)
 		return ret;
 	}
 
-	if (ab->hw_params.supports_regdb)
+	if (ab->hw_params.supports_regdb && !(ab->qcom_platform && op9_no_regdb))
 		ath11k_qmi_load_bdf_qmi(ab, true);
 
 	ret = ath11k_qmi_load_bdf_qmi(ab, false);
