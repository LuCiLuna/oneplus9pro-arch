From 04d47f600ada780220667332490402aa367e3816 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Tue, 3 Nov 2026 23:20:49 -0600
Subject: [PATCH 142/142] power: supply: qcom_battmgr: charge to full and
 report it as Android does

The OnePlus policy stopped at the firmware's 8.70 V float voltage, which
the gauge, set up for the vendor's, reads as 88-92%. And as the gauge
decides its status by the sign of its current, a charged phone on its
charger kept showing as charging, or flipped to discharging at 100%.

Follow oplus_chg and the vendor device tree, whose values are per cell
for this 2S battery: float 4.43 V (4.435 V under 16 C), full at
4.38 V and under 125 mA on two polls in a row, recharge 100 mV under the
float voltage.

Report the policy's status for the gauge through a power supply
extension: charging, not charging when held back, and full from full
until the charger goes, recharges included. Like Android's UI state of
charge, show 100% from full until unplugged, then fall to the gauge's
value at 1% a minute.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_battmgr.c | 150 +++++++++++++++++++++++++---
 1 file changed, 136 insertions(+), 14 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 8024d7f27d2..8c809091a43 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -368,6 +368,7 @@ struct qcom_battmgr {
 
 	/* OnePlus charging policy, which Android keeps on the AP side */
 	struct power_supply *gauge;
+	bool gauge_ext;
 	struct delayed_work chg_work;
 	struct notifier_block chg_pm_nb;
 	bool chg_reset;
@@ -387,6 +388,16 @@ struct qcom_battmgr {
 		u32 fv;
 	} chg;
 
+	/*
+	 * What the battery reports, as Android's UI does. With a charger, the
+	 * status comes from the policy (0: the gauge's own), and from full until
+	 * unplugged the capacity stays at 100%, then falls to the gauge's 1% a minute.
+	 */
+	int ui_status;
+	bool ui_hold;
+	bool ui_falling;
+	time64_t ui_release;
+
 	/* last property value read; also the HACK raw property access for bring-up */
 	u32 dbg_prop;
 	u32 dbg_value;
@@ -1779,18 +1790,18 @@ static void qcom_battmgr_otg_off(void *data)
  * Android runs the charging policy on the AP (oplus_chg): the firmware stays at
  * 5 V and 500 mA, and does not know the temperature of the battery, which only
  * the AP can read from the gauge. Take the limits from the vendor device tree,
- * keeping the firmware's own, lower, float voltage on this worn battery.
+ * which gives them per cell for this 2S battery.
  */
 static const struct {
 	int temp;	/* up to this temperature, in 0.1 C */
 	u32 fcc;	/* uA */
 	u32 fv;		/* uV */
 } qcom_battmgr_chg_zones[] = {
-	{       0,       0, 8700000 },
-	{      50, 1150000, 8700000 },
-	{     120, 1650000, 8700000 },
-	{     160, 2850000, 8700000 },
-	{     470, 3000000, 8700000 },
+	{       0,       0, 8870000 },
+	{      50, 1150000, 8870000 },
+	{     120, 1650000, 8870000 },
+	{     160, 2850000, 8870000 },
+	{     470, 3000000, 8860000 },
 	{     500,  600000, 8240000 },
 	{ INT_MAX,       0, 8240000 },
 };
@@ -1802,20 +1813,105 @@ static const struct {
 #define CHG_ICL_DEFAULT		500000
 #define CHG_VBUS_MIN		4400000
 #define CHG_VBUS_HV		8000000
-#define CHG_ITERM		150000
-#define CHG_FULL_POLLS		4
-#define CHG_VFLOAT_MARGIN	50000
-#define CHG_RECHARGE_VOLT	8500000
+/* full and recharge as oplus_chg: iterm_ma, vfloat_sw_limit, full-count-sw-num, recharge-mv */
+#define CHG_ITERM		125000
+#define CHG_FULL_POLLS		2
+#define CHG_VFLOAT_MARGIN	100000
+#define CHG_RECHARGE_MARGIN	200000
+#define CHG_UI_FALL_SECS	60
 #define CHG_POLL_SETTLE		(5 * HZ)
 #define CHG_POLL		(30 * HZ)
 
 static const u32 qcom_battmgr_chg_icl_steps[] = { 500000, 900000, 1200000, 1500000, 2000000 };
 
+/* the zones that charge to a full battery, rather than to a lower limit */
+#define CHG_FV_FULL		8860000
+
+/* Returns the capacity to show for the gauge's @real; ends the fall from 100% once it gets there */
+static int qcom_battmgr_ui_capacity(struct qcom_battmgr *battmgr, int real)
+{
+	time64_t fallen;
+
+	if (READ_ONCE(battmgr->ui_hold))
+		return 100;
+	if (!READ_ONCE(battmgr->ui_falling))
+		return real;
+
+	fallen = (ktime_get_boottime_seconds() - READ_ONCE(battmgr->ui_release)) / CHG_UI_FALL_SECS;
+	if (fallen < 100 - real)
+		return 100 - fallen;
+
+	WRITE_ONCE(battmgr->ui_falling, false);
+	return real;
+}
+
+static int qcom_battmgr_gauge_ext_get(struct power_supply *psy, const struct power_supply_ext *ext,
+				      void *data, enum power_supply_property psp,
+				      union power_supply_propval *val)
+{
+	struct qcom_battmgr *battmgr = data;
+	int status, ret;
+
+	ret = power_supply_get_property_direct(psy, psp, val);
+	if (ret)
+		return ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		status = READ_ONCE(battmgr->ui_status);
+		if (status)
+			val->intval = status;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = qcom_battmgr_ui_capacity(battmgr, val->intval);
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+static const enum power_supply_property qcom_battmgr_gauge_ext_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CAPACITY,
+};
+
+/*
+ * The gauge decides its status by the sign of its current and sets its full
+ * flag at its own idea of the charge voltage, so a charged phone on its charger
+ * showed as charging, or as discharging under load. Speak for it as Android does.
+ */
+static const struct power_supply_ext qcom_battmgr_gauge_ext = {
+	.name = "oplus-charging",
+	.override = true,
+	.properties = qcom_battmgr_gauge_ext_props,
+	.num_properties = ARRAY_SIZE(qcom_battmgr_gauge_ext_props),
+	.get_property = qcom_battmgr_gauge_ext_get,
+};
+
+static void qcom_battmgr_chg_set_ui(struct qcom_battmgr *battmgr, int status, bool hold)
+{
+	if (status == battmgr->ui_status && hold == battmgr->ui_hold)
+		return;
+
+	/* unplugged at 100%: from here, fall to the gauge's value */
+	if (battmgr->ui_hold && !hold) {
+		WRITE_ONCE(battmgr->ui_release, ktime_get_boottime_seconds());
+		WRITE_ONCE(battmgr->ui_falling, true);
+	}
+	WRITE_ONCE(battmgr->ui_status, status);
+	WRITE_ONCE(battmgr->ui_hold, hold);
+	power_supply_changed(battmgr->gauge);
+}
+
 static void qcom_battmgr_put_gauge(void *data)
 {
 	struct qcom_battmgr *battmgr = data;
 
 	cancel_delayed_work_sync(&battmgr->chg_work);
+	if (battmgr->gauge_ext)
+		power_supply_unregister_extension(battmgr->gauge, &qcom_battmgr_gauge_ext);
 	power_supply_put(battmgr->gauge);
 }
 
@@ -1885,7 +1981,7 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 	union power_supply_propval temp, volt, curr, status;
 	u32 online, type, vbus, vmax, cmax, icl = 0, fcc, fv;
 	unsigned long next = CHG_POLL;
-	bool pd, hv = false, detach, climbing = false, enable, wireless = false;
+	bool pd, hv = false, detach, climbing = false, enable, wireless = false, hold, falling;
 	int zone, ret;
 
 	if (!battmgr->service_up)
@@ -1908,6 +2004,12 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 			return;
 		}
 		battmgr->gauge = gauge;
+
+		ret = power_supply_register_extension(gauge, &qcom_battmgr_gauge_ext,
+						      battmgr->dev, battmgr);
+		if (ret)
+			dev_warn(battmgr->dev, "can't report charging status: %d\n", ret);
+		battmgr->gauge_ext = !ret;
 	}
 
 	mutex_lock(&battmgr->lock);
@@ -1946,7 +2048,8 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 	if (!ret)
 		ret = power_supply_get_property(battmgr->gauge, POWER_SUPPLY_PROP_CURRENT_NOW, &curr);
 	if (!ret)
-		ret = power_supply_get_property(battmgr->gauge, POWER_SUPPLY_PROP_STATUS, &status);
+		ret = power_supply_get_property_direct(battmgr->gauge, POWER_SUPPLY_PROP_STATUS,
+						       &status);
 	if (ret)
 		goto out;
 
@@ -2018,14 +2121,14 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 	else if (!hv)
 		fcc = min_t(u32, fcc, CHG_FCC_5V);
 
-	/* the gauge is set up for a higher float voltage and won't report full */
+	/* as oplus_chg, decide full in software: the gauge's own flag comes late, if at all */
 	if (status.intval == POWER_SUPPLY_STATUS_FULL ||
 	    (volt.intval >= fv - CHG_VFLOAT_MARGIN && curr.intval >= 0 &&
 	     curr.intval < CHG_ITERM && ++battmgr->chg.full_polls >= CHG_FULL_POLLS))
 		battmgr->chg.full = true;
 	else if (curr.intval >= CHG_ITERM)
 		battmgr->chg.full_polls = 0;
-	if (volt.intval < CHG_RECHARGE_VOLT) {
+	if (volt.intval < fv - CHG_RECHARGE_MARGIN) {
 		battmgr->chg.full = false;
 		battmgr->chg.full_polls = 0;
 	}
@@ -2067,6 +2170,12 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 		battmgr->chg.enabled = enable;
 	}
 
+	/* as Android: charged, and showing 100%, from full until unplugged, recharges included */
+	hold = battmgr->ui_hold || (battmgr->chg.full && fv >= CHG_FV_FULL);
+	qcom_battmgr_chg_set_ui(battmgr, hold ? POWER_SUPPLY_STATUS_FULL :
+				enable ? POWER_SUPPLY_STATUS_CHARGING :
+				POWER_SUPPLY_STATUS_NOT_CHARGING, hold);
+
 out:
 	/* -ENXIO: seen for the first seconds of boot, the next poll gets through */
 	if (ret && ret != -ENXIO)
@@ -2086,10 +2195,23 @@ static void qcom_battmgr_chg_worker(struct work_struct *work)
 		pm_relax(battmgr->dev);
 	}
 	memset(&battmgr->chg, 0, sizeof(battmgr->chg));
+	qcom_battmgr_chg_set_ui(battmgr, 0, false);
+	falling = READ_ONCE(battmgr->ui_falling);
+	if (falling) {
+		/* nothing else changes the gauge's capacity often enough for UPower to notice */
+		power_supply_changed(battmgr->gauge);
+		if (!power_supply_get_property_direct(battmgr->gauge, POWER_SUPPLY_PROP_CAPACITY,
+						      &status))
+			qcom_battmgr_ui_capacity(battmgr, status.intval);
+		falling = READ_ONCE(battmgr->ui_falling);
+	}
 	mutex_unlock(&battmgr->lock);
 	/* could already be a new attach, whose notifications raced with this */
 	if (detach)
 		queue_delayed_work(system_freezable_wq, &battmgr->chg_work, CHG_POLL_SETTLE);
+	else if (falling)
+		queue_delayed_work(system_freezable_wq, &battmgr->chg_work,
+				   CHG_UI_FALL_SECS * HZ);
 }
 
 /* Nothing would watch the battery's temperature during sleep, so don't sleep while charging */
-- 
2.56.0

