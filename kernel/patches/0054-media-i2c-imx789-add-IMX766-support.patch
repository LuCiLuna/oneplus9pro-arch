From 67c6854f4dbbf58620270da7cae88943803919a2 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sat, 31 Oct 2026 19:12:22 +0000
Subject: [PATCH 054/114] media: i2c: imx789: add IMX766 support

The IMX766 (50 MP, the OnePlus 9 Pro ultrawide) is programmed the same
way as the IMX789 and also talks C-PHY over three trios. Move the
per-sensor parts (ID, init table, modes, rates, array size) into chip
data and add its 2x2 binned 4096x3072 30 fps mode. As with the IMX789,
the stock init's H+V flip is left out. Name the subdev after the chip.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/Kconfig  |   6 +-
 drivers/media/i2c/imx789.c | 349 +++++++++++++++++++++++++++++++++----
 2 files changed, 316 insertions(+), 39 deletions(-)

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index d851dfd3616..efe038849a7 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -300,12 +300,12 @@ config VIDEO_IMX471
 	  module will be called imx471.
 
 config VIDEO_IMX789
-	tristate "Sony IMX789 sensor support"
+	tristate "Sony IMX789 and IMX766 sensor support"
 	depends on GPIOLIB
 	select V4L2_CCI_I2C
 	help
-	  This is a Video4Linux2 sensor driver for the Sony
-	  IMX789 camera, a 48 MP sensor with a MIPI C-PHY interface.
+	  This is a Video4Linux2 sensor driver for the Sony IMX789
+	  (48 MP) and IMX766 (50 MP) cameras, which use MIPI C-PHY.
 
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx789.
