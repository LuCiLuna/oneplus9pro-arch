From a501041422bb24a862c4281458fe62536b38f5d9 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 03:33:23 +0000
Subject: [PATCH 076/114] WIP: drm/panel: amb670yf01: run at 120 Hz

Add the vendor fhd_sdc_120 timing and make it the default. It differs
from fhd_sdc_60 in four on-command bytes (b9 at 0x3a and 0x38, 60, bd at
0x10) and in the porches; with the vendor porches the derived DSI bit
clock is ~840 Mbps/lane, next to the vendor 825.6. refresh=60 restores
the old mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../gpu/drm/panel/panel-samsung-amb670yf01.c  | 35 ++++++++++++++++---
 1 file changed, 30 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-amb670yf01.c b/drivers/gpu/drm/panel/panel-samsung-amb670yf01.c
index 3f43eb2cfe8..f293c1ea673 100644
--- a/drivers/gpu/drm/panel/panel-samsung-amb670yf01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-amb670yf01.c
@@ -30,6 +30,10 @@ static int bpc = 8;
 module_param(bpc, int, 0444);
 MODULE_PARM_DESC(bpc, "DSC bits per component (8 or 10)");
 
+static int refresh = 120;
+module_param(refresh, int, 0444);
+MODULE_PARM_DESC(refresh, "Refresh rate in Hz (60 or 120)");
+
 struct amb670yf01 {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi;
@@ -77,6 +81,7 @@ static void amb670yf01_send_pps(struct amb670yf01 *ctx,
 static int amb670yf01_on(struct amb670yf01 *ctx)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	bool hz120 = refresh == 120;
 
 	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
@@ -88,7 +93,7 @@ static int amb670yf01_on(struct amb670yf01 *ctx)
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x22, 0xb9);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb9, 0xa1, 0xb1);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x3a, 0xb9);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb9, 0x05);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0xb9, hz120 ? 0x02 : 0x05);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x26, 0xb9);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb9, 0x00, 0x00);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0f);
@@ -97,7 +102,7 @@ static int amb670yf01_on(struct amb670yf01 *ctx)
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x24, 0xb9);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb9, 0x21);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x38, 0xb9);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb9, 0x05);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0xb9, hz120 ? 0x02 : 0x05);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x2a, 0xb9);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb9, 0x00, 0x00);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0f);
@@ -107,9 +112,9 @@ static int amb670yf01_on(struct amb670yf01 *ctx)
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x16, 0xf2);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x1b, 0x50);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xbd, 0x21, 0x02);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x01);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x60, hz120 ? 0x00 : 0x01);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x10, 0xbd);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xbd, 0x00);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0xbd, hz120 ? 0x10 : 0x00);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0f);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
@@ -249,10 +254,30 @@ static const struct drm_display_mode amb670yf01_mode = {
 	.type = DRM_MODE_TYPE_DRIVER,
 };
 
+/*
+ * At 120 Hz the vendor porches (fhd_sdc_120) already put the derived bit clock
+ * at ~840 Mbps/lane, next to the vendor rate, so no hfp padding is needed.
+ */
+static const struct drm_display_mode amb670yf01_mode_120 = {
+	.clock = (1080 + 64 + 8 + 50) * (2412 + 2 + 2 + 8) * 120 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 64,
+	.hsync_end = 1080 + 64 + 8,
+	.htotal = 1080 + 64 + 8 + 50,
+	.vdisplay = 2412,
+	.vsync_start = 2412 + 2,
+	.vsync_end = 2412 + 2 + 2,
+	.vtotal = 2412 + 2 + 2 + 8,
+	.width_mm = 71,
+	.height_mm = 159,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
 static int amb670yf01_get_modes(struct drm_panel *panel,
 				struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector, &amb670yf01_mode);
+	return drm_connector_helper_get_modes_fixed(connector,
+			refresh == 120 ? &amb670yf01_mode_120 : &amb670yf01_mode);
 }
 
 static const struct drm_panel_funcs amb670yf01_panel_funcs = {
