From 045a33974d97519387a43d5a20fc1ea9eedaad19 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 05:32:08 -0600
Subject: [PATCH 094/114] ASoC: qcom: q6afe: keep the handle of LPASS core
 hardware votes

The DSP answers AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST with a handle
for the client, needed to give the vote up again. q6afe_vote_lpass_core_hw()
never filled in its client_handle, while the callback took the response
for a result, reading past its only field for the status.

So every devote request went out with a handle of 0, and the DSP failed
it with error 1: "cmd = 0x100f6 returned error = 0x1", followed by "Unknown
cmd 0x100f6" since the callback didn't expect the opcode either. Votes
were never dropped although Linux showed the clocks as unused, leaving the
ADSP awake and keeping the SoC from ever reaching CX and DDR sleep.

Save the handle from the response, and accept the devote's result. This
assumes that votes aren't made concurrently, as they only come from clock
prepare, under the clock framework's prepare lock.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/qcom/qdsp6/q6afe.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
index f0ff1350e9d..5dfcdbd8a97 100644
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -393,6 +393,7 @@ struct q6afe {
 	struct q6core_svc_api_info ainfo;
 	struct mutex lock;
 	struct aprv2_ibasic_rsp_result_t result;
+	u32 lpass_hw_handle;
 	wait_queue_head_t wait;
 	struct list_head port_list;
 	spinlock_t port_list_lock;
@@ -1036,6 +1037,8 @@ static int q6afe_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 				wake_up(&afe->wait);
 			}
 			break;
+		case AFE_CMD_REMOTE_LPASS_CORE_HW_DEVOTE_REQUEST:
+			break;
 		default:
 			dev_err(afe->dev, "Unknown cmd 0x%x\n",	res->opcode);
 			break;
@@ -1043,8 +1046,10 @@ static int q6afe_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 	}
 		break;
 	case AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST:
+		/* the payload is only the handle, needed to give up the vote */
+		afe->lpass_hw_handle = *(const u32 *)data->payload;
 		afe->result.opcode = hdr->opcode;
-		afe->result.status = res->status;
+		afe->result.status = 0;
 		wake_up(&afe->wait);
 		break;
 	default:
@@ -1955,6 +1960,8 @@ int q6afe_vote_lpass_core_hw(struct device *dev, uint32_t hw_block_id,
 			       AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST);
 	if (ret)
 		dev_err(afe->dev, "AFE failed to vote (%d)\n", hw_block_id);
+	else
+		*client_handle = afe->lpass_hw_handle;
 
 	return ret;
 }
