# OnePlus 9 Pro build of Arch's iio-sensor-proxy package, with the patch from this folder.
# Based on https://gitlab.archlinux.org/archlinux/packaging/packages/iio-sensor-proxy

pkgname=iio-sensor-proxy-op9
_pkgname=iio-sensor-proxy
pkgver=3.9
pkgrel=1
pkgdesc='IIO accelerometer sensor to input device proxy (OnePlus 9 Pro patches)'
arch=(aarch64)
url='https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/'
license=('GPL-3.0-only')
depends=(glib2 glibc libgcc libgudev libssc polkit)
makedepends=(git meson)
provides=("iio-sensor-proxy=$pkgver")
conflicts=(iio-sensor-proxy)
source=("git+https://gitlab.freedesktop.org/hadess/iio-sensor-proxy#tag=$pkgver"
        iio-sensor-proxy-op9.patch)
b2sums=('SKIP' 'SKIP')

prepare() {
  cd $_pkgname
  patch -Np1 < ../iio-sensor-proxy-op9.patch
}

build() {
  arch-meson build $_pkgname \
    -Dsystemdsystemunitdir=/usr/lib/systemd/system \
    -Dudevrulesdir=/usr/lib/udev/rules.d \
    -Dsysconfdir=/usr/share
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
