# Arch's modemmanager 1.24.2 plus two upstream fixes that stop it crashing on this
# phone's multiplexed QMI data link: reconnecting mobile data crashed it (netlink
# use-after-free), and so did stopping it with data connected (bearer count assert).
# Our own patch makes GPS start: the LOC service wants a master client first.
# pkgrel 2.x sits just above Arch's 1.24.2-2, so the next Arch release replaces this
# package. The crash fixes are upstream, but the GPS patch isn't yet: rebuild this
# PKGBUILD on the new version when that happens.
# Based on https://gitlab.archlinux.org/archlinux/packaging/packages/modemmanager
# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Ionut Biru <ibiru@archlinux.org>

pkgbase=modemmanager
pkgname=(
  modemmanager
  libmm-glib
)
pkgver=1.24.2
pkgrel=2.2
pkgdesc="Mobile broadband modem management service"
url="https://www.freedesktop.org/wiki/Software/ModemManager/"
arch=(aarch64)
license=(
  GPL-2.0-or-later
  LGPL-2.1-or-later
)
depends=(
  bash
  glib2
  glibc
  hicolor-icon-theme
  libgcc
  libgudev
  libmbim
  libqmi
  libqrtr-glib
  mobile-broadband-provider-info
  polkit
  ppp
  systemd-libs
)
makedepends=(
  bash-completion
  git
  glib2-devel
  gobject-introspection
  meson
  systemd
  vala
)
checkdepends=(
  python-dbus
  python-gobject
)
source=(
  "git+https://gitlab.freedesktop.org/mobile-broadband/ModemManager.git#tag=${pkgver/[a-z]/-&}"
  0001-shared-qmi-register-as-LOC-master-client-before-star.patch
)
b2sums=('SKIP' 'SKIP')
validpgpkeys=(
  A814D09B9C5BC01945A64308AECE0239C6606AD5 # Aleksander Morgado <aleksandermj@chromium.org>
  3A948E16E8860C68CD68441D734614319E26A433 # Dan Williams <dan@ioncontrol.co>
)

prepare() {
  cd ModemManager

  # Fix for Fibocom modems
  # https://gitlab.archlinux.org/archlinux/packaging/packages/modemmanager/-/issues/1
  git cherry-pick -n 018e44084825ab294ad2b5d5b301d2b9e2577eb1

  # netlink: fix use-after-free calling completion_fn on transaction completion
  git cherry-pick -n 9317cbc4
  # base-manager: fix cleanup of multiplexed bearers
  git cherry-pick -n 0edcb916

  # GPS on SM8350: register as LOC master client before starting the engine
  patch -Np1 < ../0001-shared-qmi-register-as-LOC-master-client-before-star.patch
}

build() {
  local meson_options=(
    -D dbus_policy_dir=/usr/share/dbus-1/system.d
    -D dist_version="\"$pkgver-$pkgrel\""
    -D gtk_doc=false
    -D polkit=permissive
    -D vapi=true
  )

  arch-meson ModemManager build "${meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_modemmanager() {
  license=(GPL-2.0-or-later)
  depends+=(
    "libmm-glib=$pkgver-$pkgrel" libmm-glib.so
    libgudev-1.0.so
    libg{lib,object,io,module}-2.0.so
    libmbim-glib.so
    libqmi-glib.so
    libsystemd.so
  )
  optdepends=(
    'usb_modeswitch: install if your modem shows up as a storage drive'
  )

  meson install -C build --destdir "$pkgdir"

  cd "$pkgdir"
  _pick libmm usr/include
  _pick libmm usr/lib/girepository-1.0
  _pick libmm usr/lib/libmm-glib.so*
  _pick libmm usr/lib/pkgconfig
  _pick libmm usr/share/gir-1.0
  _pick libmm usr/share/vala
}

package_libmm-glib() {
  pkgdesc="ModemManager library"
  license=(LGPL-2.1-or-later)
  depends=(
    glib2 libg{lib,object,io}-2.0.so
    glibc
    libgcc
  )
  provides=(libmm-glib.so)

  mv libmm/* "$pkgdir"
}

