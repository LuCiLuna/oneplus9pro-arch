diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..d69327d 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -26,6 +26,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/types.h>
+#include <unistd.h>
 
 #include "hexagonfs.h"
 
@@ -139,7 +140,12 @@ err:
 	return ret;
 }
 
-int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+/*
+ * Walk a path and return the unassigned chain of descriptors for it. The
+ * caller assigns it a file number or destroys it.
+ */
+static int walk(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		const char *name, struct hexagonfs_fd **out)
 {
 	struct hexagonfs_fd *fd;
 	const char *curr = name;
@@ -155,6 +161,9 @@ int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const cha
 			curr++;
 	}
 
+	if (selected < 0 || selected >= HEXAGONFS_MAX_FD || fds[selected] == NULL)
+		return -EBADF;
+
 	fd = fds[selected];
 
 	while (*curr != '\0' && !ret) {
@@ -179,14 +188,156 @@ int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const cha
 	if (ret)
 		goto err;
 
+	*out = fd;
+
+	return 0;
+
+err:
+	destroy_file_descriptor(fd);
+
+	return ret;
+}
+
+/*
+ * Walk to the directory containing the last segment of a path, and return
+ * that segment in base.
+ */
+static int walk_parent(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		       const char *name, struct hexagonfs_fd **dir,
+		       const char **base)
+{
+	const char *slash;
+	char *parent;
+	int ret;
+
+	slash = strrchr(name, '/');
+	*base = slash == NULL ? name : slash + 1;
+
+	if (!strcmp(*base, "") || !strcmp(*base, ".") || !strcmp(*base, ".."))
+		return -EINVAL;
+
+	if (slash == NULL)
+		return walk(fds, rootfd, dirfd, ".", dir);
+
+	parent = strndup(name, slash - name + 1);
+	if (parent == NULL)
+		return -ENOMEM;
+
+	ret = walk(fds, rootfd, dirfd, parent, dir);
+
+	free(parent);
+
+	return ret;
+}
+
+int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+{
+	struct hexagonfs_fd *fd;
+	int ret;
+
+	ret = walk(fds, rootfd, dirfd, name, &fd);
+	if (ret)
+		return ret;
+
 	ret = allocate_file_number(fds, fd);
+	if (ret < 0)
+		destroy_file_descriptor(fd);
+
+	return ret;
+}
+
+int hexagonfs_creatat(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		      const char *name, int flags)
+{
+	struct hexagonfs_fd *dir, *fd;
+	const char *base;
+	int ret;
+
+	ret = walk_parent(fds, rootfd, dirfd, name, &dir, &base);
 	if (ret)
+		return ret;
+
+	if (dir->ops->create == NULL) {
+		ret = -EROFS;
 		goto err;
+	}
+
+	ret = dir->ops->create(dir, base, flags, &fd);
+	if (ret)
+		goto err;
+
+	ret = allocate_file_number(fds, fd);
+	if (ret < 0) {
+		destroy_file_descriptor(fd);
+		return ret;
+	}
 
 	return ret;
 
 err:
-	destroy_file_descriptor(fd);
+	destroy_file_descriptor(dir);
+
+	return ret;
+}
+
+static int physical_fileno(struct hexagonfs_fd *fd)
+{
+	if (fd->ops->fileno == NULL)
+		return -EROFS;
+
+	return fd->ops->fileno(fd);
+}
+
+int hexagonfs_unlinkat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+{
+	struct hexagonfs_fd *dir;
+	const char *base;
+	int phys, ret;
+
+	ret = walk_parent(fds, rootfd, dirfd, name, &dir, &base);
+	if (ret)
+		return ret;
+
+	phys = physical_fileno(dir);
+	if (phys < 0)
+		ret = phys;
+	else if (unlinkat(phys, base, 0))
+		ret = -errno;
+
+	destroy_file_descriptor(dir);
+
+	return ret;
+}
+
+int hexagonfs_renameat(struct hexagonfs_fd **fds, int rootfd,
+		       int olddirfd, const char *oldname,
+		       int newdirfd, const char *newname)
+{
+	struct hexagonfs_fd *olddir, *newdir;
+	const char *oldbase, *newbase;
+	int oldphys, newphys, ret;
+
+	ret = walk_parent(fds, rootfd, olddirfd, oldname, &olddir, &oldbase);
+	if (ret)
+		return ret;
+
+	ret = walk_parent(fds, rootfd, newdirfd, newname, &newdir, &newbase);
+	if (ret)
+		goto err_destroy_old;
+
+	oldphys = physical_fileno(olddir);
+	newphys = physical_fileno(newdir);
+
+	if (oldphys < 0)
+		ret = oldphys;
+	else if (newphys < 0)
+		ret = newphys;
+	else if (renameat(oldphys, oldbase, newphys, newbase))
+		ret = -errno;
+
+	destroy_file_descriptor(newdir);
+err_destroy_old:
+	destroy_file_descriptor(olddir);
 
 	return ret;
 }
@@ -277,3 +428,70 @@ int hexagonfs_fstat(struct hexagonfs_fd **fds, int fileno, struct stat *stats)
 
 	return fd->ops->stat(fd, stats);
 }
+
+static struct hexagonfs_fd *get_fd(struct hexagonfs_fd **fds, int fileno)
+{
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return NULL;
+
+	return fds[fileno];
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+	ssize_t ret;
+	int phys;
+
+	fd = get_fd(fds, fileno);
+	if (fd == NULL)
+		return -EBADF;
+
+	phys = physical_fileno(fd);
+	if (phys < 0)
+		return phys;
+
+	ret = write(phys, ptr, size);
+	if (ret < 0)
+		return -errno;
+
+	return ret;
+}
+
+int hexagonfs_fsync(struct hexagonfs_fd **fds, int fileno)
+{
+	struct hexagonfs_fd *fd;
+	int phys;
+
+	fd = get_fd(fds, fileno);
+	if (fd == NULL)
+		return -EBADF;
+
+	phys = physical_fileno(fd);
+	if (phys < 0)
+		return phys;
+
+	if (fsync(phys))
+		return -errno;
+
+	return 0;
+}
+
+int hexagonfs_ftruncate(struct hexagonfs_fd **fds, int fileno, off_t len)
+{
+	struct hexagonfs_fd *fd;
+	int phys;
+
+	fd = get_fd(fds, fileno);
+	if (fd == NULL)
+		return -EBADF;
+
+	phys = physical_fileno(fd);
+	if (phys < 0)
+		return phys;
+
+	if (ftruncate(phys, len))
+		return -errno;
+
+	return 0;
+}
