# MMS (picture messaging) for Chatty. Not in the Arch Linux ARM repos.
# On first run it writes ~/.mms/modemmanager/mms with the carrier's MMS settings,
# looked up from the SIM in mobile-broadband-provider-info.

pkgname=mmsd-tng
pkgver=2.6.4
pkgrel=1
pkgdesc='MMS daemon for ModemManager'
arch=(aarch64)
url='https://gitlab.com/kop316/mmsd'
license=('GPL-2.0-only')
depends=(glib2 glibc libmm-glib libsoup3 c-ares libphonenumber mobile-broadband-provider-info)
makedepends=(git meson)
source=("git+$url.git#tag=$pkgver")
b2sums=('SKIP')

build() {
  arch-meson mmsd build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
