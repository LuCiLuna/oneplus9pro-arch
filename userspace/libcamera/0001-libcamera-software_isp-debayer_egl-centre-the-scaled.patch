From a336350767ee7863b8bcf876faa4895aed317abc Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:30:41 +0000
Subject: [PATCH 1/3] libcamera: software_isp: debayer_egl: centre the scaled
 image, gather stats over it

The GPU debayer scales the whole input into the output, but it anchors
the scaled image at the bottom-left corner, so when the aspect ratios
differ all the cropping happens on one side. The statistics window was
meanwhile set to an output sized rectangle at the top-left corner of the
input, so AWB and AGC measured a region that differs from what is
shown: colours and brightness changed depending on what was in that
corner.

Centre the scaled image and gather statistics over the part of the
input that ends up in the output.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/libcamera/software_isp/debayer_egl.cpp | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index 02651fe..7614f02 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -340,10 +340,16 @@ int DebayerEGL::configure(const StreamConfiguration &inputCfg,
 	window_.height = outputCfg.size.height;
 
 	/*
-	 * Don't pass x,y from window_ since process() already adjusts for it.
-	 * But crop the window to 2/3 of its width and height for speedup.
+	 * The shaders scale the whole input into the output (see
+	 * setShaderVariableValues()), cropping the excess of the longer side
+	 * evenly. Gather the statistics over that visible part of the input
+	 * rather than over an output sized patch in its top-left corner.
 	 */
-	stats_->setWindow(Rectangle(window_.size()));
+	float scale = std::max(static_cast<float>(outputSize_.width) / nativeOutputSize_.width,
+			       static_cast<float>(outputSize_.height) / nativeOutputSize_.height);
+	Size visible(std::min<unsigned int>(inputCfg.size.width, outputSize_.width / scale),
+		     std::min<unsigned int>(inputCfg.size.height, outputSize_.height / scale));
+	stats_->setWindow(visible.centeredTo(Rectangle(inputCfg.size).center()));
 
 	inputBufferCount_ = inputCfg.bufferCount;
 	outputBufferCount_ = outputCfg.bufferCount;
@@ -411,12 +417,18 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	 */
 	GLfloat scale = std::max((GLfloat)outputSize_.width / nativeOutputSize_.width,
 				 (GLfloat)outputSize_.height / nativeOutputSize_.height);
-	GLfloat trans = -(1.0f - scale);
+	/*
+	 * The viewport is the input size, the output the bottom-left part of
+	 * it: centre the scaled image on the output so that any cropping is
+	 * even on both sides.
+	 */
+	GLfloat transX = (GLfloat)outputSize_.width / width_ - 1.0f;
+	GLfloat transY = (GLfloat)outputSize_.height / height_ - 1.0f;
 	GLfloat projMatrix[] = {
 		scale, 0, 0, 0,
 		0, scale, 0, 0,
 		0, 0, 1, 0,
-		trans, trans, 0, 1
+		transX, transY, 0, 1
 	};
 	/* Static const coordinates */
 	static const GLfloat vcoordinates[4][2] = {
