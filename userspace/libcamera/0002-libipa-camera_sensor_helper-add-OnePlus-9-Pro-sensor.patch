From 63a9cdec2a1619fe58ba253486a47750dfd6efee Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:54:04 +0000
Subject: [PATCH 2/3] libipa: camera_sensor_helper: add OnePlus 9 Pro sensors

Gain models and black levels for the GC02M1B, IMX471, IMX766, IMX789
and OV08A10. The Sony sensors use the usual 1024 / (1024 - code)
analogue gain; the OV08A10 code is gain * 256 and the GC02M1B driver
takes a linear gain in 1/1024.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ipa/libipa/camera_sensor_helper.cpp | 60 +++++++++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 9457d62..d827f42 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -496,6 +496,18 @@ private:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ar0521", CameraSensorHelperAr0521)
 
+class CameraSensorHelperGc02m1b : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperGc02m1b()
+	{
+		/* Black level target: 0x40 at 10 bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("gc02m1b", CameraSensorHelperGc02m1b)
+
 class CameraSensorHelperGc05a2 : public CameraSensorHelper
 {
 public:
@@ -632,6 +644,18 @@ class CameraSensorHelperImx462 : public CameraSensorHelperImx290
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx462", CameraSensorHelperImx462)
 
+class CameraSensorHelperImx471 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx471()
+	{
+		/* 0x40 at 10 bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx471", CameraSensorHelperImx471)
+
 class CameraSensorHelperImx477 : public CameraSensorHelper
 {
 public:
@@ -665,6 +689,30 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx708", CameraSensorHelperImx708)
 
+class CameraSensorHelperImx766 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx766()
+	{
+		/* 0x40 at 10 bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx766", CameraSensorHelperImx766)
+
+class CameraSensorHelperImx789 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx789()
+	{
+		/* 0x40 at 10 bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx789", CameraSensorHelperImx789)
+
 class CameraSensorHelperOv01a10 : public CameraSensorHelper
 {
 public:
@@ -677,6 +725,18 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov01a10", CameraSensorHelperOv01a10)
 
+class CameraSensorHelperOv08a10 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv08a10()
+	{
+		/* Black level target: 0x40 at 10 bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov08a10", CameraSensorHelperOv08a10)
+
 class CameraSensorHelperOv08x40 : public CameraSensorHelper
 {
