diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..94f964c
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,224 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection auto focus
+ *
+ * The statistics carry a sharpness measure (sum of absolute differences of
+ * neighbouring green samples) over the centre of the image. A coarse sweep
+ * of the whole lens range finds the peak, a fine sweep around it refines
+ * it. In continuous mode the lens then stays put until the sharpness or
+ * the brightness of the scene changes for a while, which starts a new
+ * sweep.
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "linux/v4l2-controls.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+/* Number of points of the coarse sweep and fine steps per coarse step */
+static constexpr int kCoarseSteps = 10;
+static constexpr int kFineDivisor = 3;
+/* Stop a sweep once past the peak, when the measure fell this far */
+static constexpr double kPastPeak = 0.7;
+/* Restart when off by this much from the reference for this many stats */
+static constexpr double kSharpnessChange = 0.25;
+static constexpr double kBrightnessChange = 0.25;
+static constexpr unsigned int kChangedFrames = 4;
+
+int Af::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, controls::AfModeContinuous);
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues, controls::AfTriggerStart);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto &af = context.configuration.af;
+	const auto it = configInfo.sensorControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+
+	af.enabled = it != configInfo.sensorControls.end();
+	if (!af.enabled)
+		return 0;
+
+	min_ = it->second.min().get<int32_t>();
+	max_ = it->second.max().get<int32_t>();
+	step_ = std::max((max_ - min_) / kCoarseSteps, 1);
+
+	mode_ = controls::AfModeContinuous;
+	failed_ = false;
+	startScan(context);
+
+	LOG(IPASoftAf, Debug) << "Lens range " << min_ << "-" << max_;
+
+	return 0;
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.configuration.af.enabled)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = *mode;
+		if (mode_ == controls::AfModeContinuous)
+			startScan(context);
+		else
+			phase_ = Phase::Idle;
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart)
+			startScan(context);
+		else if (*trigger == controls::AfTriggerCancel)
+			phase_ = Phase::Idle;
+	}
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	target_ = std::clamp(position, min_, max_);
+	context.activeState.af.position = target_;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	phase_ = Phase::Coarse;
+	failed_ = false;
+	bestMeasure_ = 0.0;
+	best_ = min_;
+	dropCount_ = 0;
+	end_ = max_;
+	moveTo(context, min_);
+	/* The first statistics after a move may still show the old position */
+	settle_ = 1;
+}
+
+void Af::scanStep(IPAContext &context, double measure)
+{
+	if (measure > bestMeasure_) {
+		bestMeasure_ = measure;
+		best_ = target_;
+		dropCount_ = 0;
+	} else if (measure < bestMeasure_ * kPastPeak) {
+		dropCount_++;
+	}
+
+	int32_t step = phase_ == Phase::Coarse ? step_
+					       : std::max(step_ / kFineDivisor, 1);
+	bool done = target_ >= end_ || dropCount_ >= 2;
+
+	if (!done) {
+		moveTo(context, target_ + step);
+		return;
+	}
+
+	if (phase_ == Phase::Coarse) {
+		/* Sweep again around the peak in finer steps */
+		phase_ = Phase::Fine;
+		end_ = std::min(best_ + step_, max_);
+		dropCount_ = 0;
+		bestMeasure_ = 0.0;
+		moveTo(context, best_ - step_ + step_ / kFineDivisor);
+		settle_ = 1;
+		return;
+	}
+
+	phase_ = Phase::Focused;
+	moveTo(context, best_);
+	failed_ = bestMeasure_ <= 0.0;
+	refMeasure_ = 0.0;
+	changedCount_ = 0;
+	settle_ = 1;
+
+	LOG(IPASoftAf, Debug) << "Focused at " << best_
+			      << " (" << bestMeasure_ << ")";
+}
+
+void Af::monitor(IPAContext &context, double measure, double brightness)
+{
+	if (refMeasure_ == 0.0) {
+		refMeasure_ = measure;
+		refBrightness_ = brightness;
+		return;
+	}
+
+	bool changed = std::abs(measure - refMeasure_) > refMeasure_ * kSharpnessChange ||
+		       std::abs(brightness - refBrightness_) > refBrightness_ * kBrightnessChange;
+
+	changedCount_ = changed ? changedCount_ + 1 : 0;
+	if (changedCount_ >= kChangedFrames)
+		startScan(context);
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!context.configuration.af.enabled)
+		return;
+
+	int32_t state = controls::AfStateIdle;
+	switch (phase_) {
+	case Phase::Coarse:
+	case Phase::Fine:
+		state = controls::AfStateScanning;
+		break;
+	case Phase::Focused:
+		state = failed_ ? controls::AfStateFailed : controls::AfStateFocused;
+		break;
+	case Phase::Idle:
+		break;
+	}
+	metadata.set(controls::AfState, state);
+
+	if (!stats->valid || phase_ == Phase::Idle)
+		return;
+
+	if (settle_) {
+		settle_--;
+		return;
+	}
+
+	if (!stats->sharpnessSum)
+		return;
+
+	double measure = static_cast<double>(stats->sharpness) / stats->sharpnessSum;
+	double brightness = static_cast<double>(stats->sharpnessSum);
+
+	if (phase_ == Phase::Focused) {
+		if (mode_ == controls::AfModeContinuous)
+			monitor(context, measure, brightness);
+		return;
+	}
+
+	scanStep(context, measure);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
