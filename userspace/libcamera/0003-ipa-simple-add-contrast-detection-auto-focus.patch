-void SimpleCameraData::setSensorControls(const ControlList &sensorControls)
+/*
+ * The soft IPA drives the focus lens through the sensor control list: hand
+ * it the lens position control along with the sensor ones.
+ */
+const ControlInfoMap &SimpleCameraData::ipaSensorControls()
+{
+	const ControlInfoMap &sensorControls = sensor_->controls();
+	CameraLens *lens = sensor_->focusLens();
+	if (!lens)
+		return sensorControls;
+
+	const auto it = lens->controls().find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == lens->controls().end())
+		return sensorControls;
+
+	ipaControlIds_ = sensorControls.idmap();
+	ipaControlIds_[V4L2_CID_FOCUS_ABSOLUTE] = it->first;
+
+	ControlInfoMap::Map controls(sensorControls.begin(), sensorControls.end());
+	controls.emplace(it->first, it->second);
+	ipaSensorControls_ = ControlInfoMap(std::move(controls), ipaControlIds_);
+
+	return ipaSensorControls_;
+}
+
+void SimpleCameraData::setSensorControls(const ControlList &controls)
 {
+	ControlList sensorControls(sensor_->controls());
+
+	for (const auto &[id, value] : controls) {
+		if (id != V4L2_CID_FOCUS_ABSOLUTE) {
+			sensorControls.set(id, value);
+			continue;
+		}
+
+		int32_t position = value.get<int32_t>();
+		CameraLens *lens = sensor_->focusLens();
+		if (lens && lensPosition_ != position) {
+			lens->setFocusPosition(position);
+			lensPosition_ = position;
+		}
+	}
+
 	delayedCtrls_->push(sensorControls);
 	/*
 	 * Directly apply controls now if there is no frameStart signal.
@@ -1604,7 +1652,8 @@ int SimplePipelineHandler::configure(Camera *camera, CameraConfiguration *c)
 		return data->converter_->configure(inputCfg, outputCfgs);
 	} else {
 		ipa::soft::IPAConfigInfo configInfo;
-		configInfo.sensorControls = data->sensor_->controls();
+		configInfo.sensorControls = data->ipaSensorControls();
+		data->lensPosition_.reset();
 		return data->swIsp_->configure(inputCfg, outputCfgs, configInfo);
 	}
 }
@@ -1727,6 +1776,13 @@ void SimplePipelineHandler::stopDevice(Camera *camera)
 
 	video->bufferReady.disconnect(data, &SimpleCameraData::imageBufferReady);
 
+	/* Park the lens, a voice coil holding a position draws current */
+	CameraLens *lens = data->sensor_->focusLens();
+	if (lens && data->lensPosition_) {
+		lens->setFocusPosition(0);
+		data->lensPosition_.reset();
+	}
+
 	data->frameInfo_.clear();
