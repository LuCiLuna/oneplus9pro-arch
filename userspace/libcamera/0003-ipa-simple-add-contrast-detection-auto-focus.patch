+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection auto focus
+ */
+
+#pragma once
+
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase {
+		Idle,
+		Coarse,
+		Fine,
+		Focused,
+	};
+
+	void startScan(IPAContext &context);
+	void moveTo(IPAContext &context, int32_t position);
+	void scanStep(IPAContext &context, double measure);
+	void monitor(IPAContext &context, double measure, double brightness);
+
+	int32_t min_ = 0;
+	int32_t max_ = 0;
+	int32_t step_ = 0;
+
+	Phase phase_ = Phase::Idle;
+	int32_t mode_ = 0;
+	unsigned int settle_ = 0;
+	bool failed_ = false;
+
+	int32_t target_ = 0;
+	int32_t end_ = 0;
+	int32_t best_ = 0;
+	double bestMeasure_ = 0.0;
+	unsigned int dropCount_ = 0;
+
+	double refMeasure_ = 0.0;
+	double refBrightness_ = 0.0;
+	unsigned int changedCount_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
