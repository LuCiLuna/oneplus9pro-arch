// The phone's user switches between Phosh and desktop mode without a password. Only starting
// these two units is allowed; each one stops the other.
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
	    (action.lookup("unit") == "op9-desktop.service" || action.lookup("unit") == "phosh.service") &&
	    action.lookup("verb") == "start" &&
	    ((subject.local && subject.active) || subject.isInGroup("wheel")))
		return polkit.Result.YES;
});
